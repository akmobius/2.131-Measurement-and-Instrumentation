Cell[CellGroupData[{

Cell["Demo", "Subsubsection",
 CellChangeTimes->{{3.984921110202457*^9, 
  3.984921110890852*^9}},ExpressionUUID->"c34c5df7-6006-4472-9eba-\
f10e7f719677"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Convolution", " ", "Interactive", " ", "Demonstration"}], "*)"}], 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"selectable", " ", "input"}]}], ",", 
    RowBox[{"h", "=", 
     RowBox[{
      RowBox[{"impulse", " ", "response", " ", "of", " ", "2", "nd"}], "-", 
      RowBox[{"order", " ", "system"}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"y", "[", "n", "]"}], "=", 
    RowBox[{"Sum_", 
     RowBox[{"{", "k", "}"}], " ", 
     RowBox[{"h", "[", "k", "]"}], "*", 
     RowBox[{"x", "[", 
      RowBox[{"n", "-", "k"}], "]"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fs", "=", "50000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dt", "=", 
     RowBox[{"1", "/", "fs"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nSamples", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nTransient", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Second", "-", 
     RowBox[{"order", " ", "system", " ", "parameters"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Kdc", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fn", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wn", "=", 
     RowBox[{"2", " ", "Pi", " ", "fn"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zeta", "=", "0.3"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sosCont", "=", 
     RowBox[{"TransferFunctionModel", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"Kdc", " ", 
          RowBox[{
           RowBox[{"wn", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"s", "^", "2"}], "+", 
             RowBox[{"2", " ", "zeta", " ", "wn", " ", "s"}], "+", 
             RowBox[{"wn", "^", "2"}]}], ")"}]}]}], "}"}], "}"}], ",", "s"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sosDisc", "=", 
     RowBox[{"ToDiscreteTimeModel", "[", 
      RowBox[{"sosCont", ",", "dt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Impulse", " ", "response"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hFull", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"OutputResponse", "[", 
       RowBox[{"sosDisc", ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "999"}], "]"}]}], "]"}]}], "]"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"hLen", "=", 
     RowBox[{"nSamples", "-", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"Reverse", "[", "hFull", "]"}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "#", "]"}], ">", 
             RowBox[{"0.001", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", "hFull", "]"}], "]"}]}]}], "&"}], ")"}]}], 
         ",", "1", ",", "1"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hLen", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"hLen", ",", "50"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hLen", "=", 
     RowBox[{"Min", "[", 
      RowBox[{"hLen", ",", "300"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"hFull", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "hLen"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "=", "0."}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"strictly", " ", "proper", " ", 
      RowBox[{"system", ":", 
       RowBox[{"h", 
        RowBox[{"(", "0", ")"}]}]}]}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hNorm", "=", 
     RowBox[{"h", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "h", "]"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Convolution", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"convolve", "[", "xSig_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "xPad", "}"}], ",", 
       RowBox[{
        RowBox[{"xPad", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"hLen", "-", "1"}]}], "]"}], ",", "xSig"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"h", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "*", 
             RowBox[{"xPad", "[", 
              RowBox[{"[", 
               RowBox[{"n", "-", "k", "+", "hLen"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"hLen", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", 
            RowBox[{"nSamples", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"===", 
      RowBox[{"Input", " ", "1"}]}], ":", 
     RowBox[{
      RowBox[{"White", " ", "noise"}], "==="}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNoiseAll", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", 
       RowBox[{"nSamples", "+", "nTransient"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xNoise", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"xNoiseAll", ",", 
       RowBox[{"-", "nSamples"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xNoise", "=", 
     RowBox[{"xNoise", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "xNoise", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yNoise", "=", 
     RowBox[{"convolve", "[", "xNoise", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yNoise", "=", 
     RowBox[{"yNoise", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "yNoise", "]"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"===", 
      RowBox[{"Input", " ", "2"}]}], ":", 
     RowBox[{
      RowBox[{"Unit", " ", "step", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"1", " ", "for", " ", "t"}], ">=", "0"}], ",", 
         RowBox[{
          RowBox[{"0", " ", "for", " ", "t"}], "<", "0"}]}], ")"}]}], 
      "==="}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xStep", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1.", ",", "nSamples"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yStep", "=", 
     RowBox[{"convolve", "[", "xStep", "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"true", " ", "values"}], "\[LongDash]", 
     RowBox[{
      RowBox[{"settles", " ", "to", " ", "Kdc"}], "=", "2"}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"===", 
      RowBox[{"Input", " ", "3"}]}], ":", 
     RowBox[{
      RowBox[{"Unit", " ", "impulse", " ", 
       RowBox[{"(", 
        RowBox[{"area", "=", "1"}], ")"}]}], "==="}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xImpulse", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "nSamples"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"xImpulse", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "=", 
     RowBox[{"1", "/", "dt"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yImpulse", "=", 
     RowBox[{"convolve", "[", "xImpulse", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Common", " ", "axis", " ", "range"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"axMin", "=", 
     RowBox[{"-", "200"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"axMax", "=", "1000"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Layout", " ", "constants"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prodZero", "=", 
     RowBox[{"-", "3.0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sepY", "=", 
     RowBox[{"-", "1.7"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"prodMargin", "=", "1.35"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"plotBottom", "=", 
     RowBox[{"prodZero", "-", "prodMargin"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Max", " ", "product", " ", "per", " ", "mode"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeMaxProd", "[", "xSigDisp_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "xPad", "}"}], ",", 
       RowBox[{
        RowBox[{"xPad", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"hLen", "-", "1"}]}], "]"}], ",", "xSigDisp"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Max", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"hNorm", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "+", "1"}], "]"}], "]"}], "*", 
                RowBox[{"xPad", "[", 
                 RowBox[{"[", 
                  RowBox[{"n", "-", "k", "+", "hLen"}], "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "0", ",", 
                 RowBox[{"hLen", "-", "1"}]}], "}"}]}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", 
             RowBox[{"nSamples", "-", "1"}], ",", "10"}], "}"}]}], 
          "]"}]}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
