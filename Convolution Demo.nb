        StyleBox["\"Input x[t]: \"", Bold, 12, StripOnInput -> False], 
        PopupMenuBox[
         Dynamic[$CellContext`inputMode$$], {
         "noise" -> "\"White noise\"", "step" -> "\"Unit step\"", "impulse" -> 
          "\"Unit impulse (\[Delta])\""}]},
       "RowDefault"]},
     {
      TemplateBox[{5},
       "Spacer1"]},
     {
      DynamicBox[ToBoxes[
        Module[{$CellContext`n$ = $CellContext`currentN$$, \
$CellContext`xSigDisp$, $CellContext`yDisp$, $CellContext`maxProd$, \
$CellContext`pScale$, $CellContext`pTickStep$, $CellContext`xLabel$, \
$CellContext`xSigRange$, $CellContext`ySigRange$}, {$CellContext`xSigDisp$, \
$CellContext`yDisp$, $CellContext`maxProd$, $CellContext`xLabel$, \
$CellContext`xSigRange$, $CellContext`ySigRange$} = 
          Switch[$CellContext`inputMode$$, 
            "noise", {$CellContext`xNoise, $CellContext`yNoise, \
$CellContext`maxProdNoise, "x[t]: Gaussian white noise", {-1.3, 1.3}, {
              Min[$CellContext`yNoise], 
              Max[$CellContext`yNoise]}}, 
            "step", {$CellContext`xStep, $CellContext`yStep, \
$CellContext`maxProdStep, 
             "x[t]: Unit step (0 for t<0, 1 for t\[GreaterEqual]0)", {-0.3, 
             1.5}, {Min[$CellContext`yStep] - 0.1, Max[$CellContext`yStep] + 
              0.1}}, "impulse", {$CellContext`xImpulse/Max[
              Abs[$CellContext`xImpulse]], $CellContext`yImpulse/Max[
              Abs[$CellContext`yImpulse]], $CellContext`maxProdImpulse, 
             "x[t]: Unit impulse (\[Delta] = 1/\[CapitalDelta]t at t=0)", \
{-1.3, 1.3}, {
              Min[$CellContext`yImpulse/Max[
                Abs[$CellContext`yImpulse]]], 
              Max[$CellContext`yImpulse/Max[
                Abs[$CellContext`yImpulse]]]}}]; $CellContext`pScale$ = 
          1.3/Max[$CellContext`maxProd$, 0.001]; $CellContext`pTickStep$ = 
          Round[$CellContext`maxProd$/3, 0.1]; 
         If[$CellContext`pTickStep$ == 0, $CellContext`pTickStep$ = 
           Max[0.01, $CellContext`maxProd$/3]]; 
         Module[{$CellContext`products$, $CellContext`yVal$, \
$CellContext`xPadDisp$, $CellContext`xLine$, $CellContext`xLineExtra$, \
$CellContext`hRevLine$, $CellContext`hRevFaded$, $CellContext`prodBars$, \
$CellContext`sumLine$, $CellContext`sumLabel$, $CellContext`separator$, \
$CellContext`prodZeroLine$, $CellContext`prodLabelLeft$, \
$CellContext`overlapStart$, $CellContext`overlapEnd$, $CellContext`shadingH$, \
$CellContext`cMin$, $CellContext`cMax$, $CellContext`margin$, \
$CellContext`sigTop$, $CellContext`sigBot$, $CellContext`sigTicks$, \
$CellContext`yTicks$, $CellContext`yLineGhost$, $CellContext`yLineRevealed$, \
$CellContext`yLineExtra$}, $CellContext`xPadDisp$ = Join[
              ConstantArray[
              0., $CellContext`hLen - 
               1], $CellContext`xSigDisp$]; $CellContext`products$ = 
            Table[{$CellContext`n$ - $CellContext`k, 
               Part[$CellContext`hNorm, $CellContext`k + 1] 
               Part[$CellContext`xPadDisp$, $CellContext`n$ - $CellContext`k + \
$CellContext`hLen]}, {$CellContext`k, 0, $CellContext`hLen - 
               1}]; $CellContext`yVal$ = 
            Part[$CellContext`yDisp$, $CellContext`n$ + 
              1]; $CellContext`overlapStart$ = 
            Max[0, $CellContext`n$ - ($CellContext`hLen - 
              1)]; $CellContext`overlapEnd$ = $CellContext`n$; \
$CellContext`sigBot$ = Part[$CellContext`xSigRange$, 1]; $CellContext`sigTop$ = 
            Part[$CellContext`xSigRange$, 2]; $CellContext`sigTicks$ = 
            Table[{$CellContext`v, 
               NumberForm[
                N[$CellContext`v], {3, 1}]}, {$CellContext`v, 
               Ceiling[$CellContext`sigBot$, 0.5], 
               Floor[$CellContext`sigTop$, 0.5], 
               0.5}]; $CellContext`shadingH$ = {
              Opacity[0.06], Orange, 
              
              Rectangle[{$CellContext`n$ - ($CellContext`hLen - 
                1), $CellContext`sigBot$}, {$CellContext`n$, \
$CellContext`sigTop$}]}; $CellContext`xLine$ = {Thick, Blue, 
              Line[
               Table[{$CellContext`t, 
                 
                 Part[$CellContext`xSigDisp$, $CellContext`t + 
                  1]}, {$CellContext`t, 0, $CellContext`nSamples - 
                 1}]]}; $CellContext`xLineExtra$ = 
            Switch[$CellContext`inputMode$$, "step", {Thick, Blue, 
               Line[{{$CellContext`axMin, 0}, {-1, 0}, {-1, 0}, {0, 1}}]}, 
              "impulse", {Thick, Blue, 
               Line[{{$CellContext`axMin, 0}, {0, 0}}]}, 
              "noise", {}]; $CellContext`hRevLine$ = {Thick, 
              Darker[Orange], 
              Line[
               Select[
                Table[{$CellContext`n$ - $CellContext`k, 
                  
                  Part[$CellContext`hNorm, $CellContext`k + 
                   1]}, {$CellContext`k, 0, $CellContext`hLen - 1}], 
                Inequality[0, LessEqual, 
                 Part[#, 1], 
                 Less, $CellContext`nSamples]& ]]}; $CellContext`hRevFaded$ = {
              Opacity[0.3], 
              Darker[Orange], 
              AbsoluteThickness[2.5], 
              Line[
               Select[
                Table[{$CellContext`n$ - $CellContext`k, 
                  
                  Part[$CellContext`hNorm, $CellContext`k + 
                   1]}, {$CellContext`k, 0, $CellContext`hLen - 1}], 
                Part[#, 1] < 0& ]]}; $CellContext`separator$ = {
              GrayLevel[0.7], 
              AbsoluteThickness[1], 
              
              Line[{{$CellContext`axMin, $CellContext`sepY}, \
{$CellContext`axMax, $CellContext`sepY}}]}; $CellContext`prodZeroLine$ = {
              GrayLevel[0.75], 
              AbsoluteThickness[0.5], 
              
              Line[{{$CellContext`axMin, $CellContext`prodZero}, \
{$CellContext`axMax, $CellContext`prodZero}}]}; $CellContext`prodLabelLeft$ = 
            Text[
              Style[
              "h[k]\[CenterDot]x[n-k]", 10, Gray], {$CellContext`axMin + 
               5, $CellContext`prodZero + $CellContext`prodMargin - 0.1}, {-1,
               0}]; $CellContext`prodBars$ = Table[{
               If[Part[$CellContext`products$, $CellContext`i, 2] >= 0, 
                Directive[
                 Opacity[0.6], 
                 Darker[Green]], 
                Directive[
                 Opacity[0.55], Red]], 
               AbsoluteThickness[2], 
               Line[{{
                  
                  Part[$CellContext`products$, $CellContext`i, 
                   1], $CellContext`prodZero}, {
                  
                  Part[$CellContext`products$, $CellContext`i, 
                   1], $CellContext`prodZero + 
                  Part[$CellContext`products$, $CellContext`i, 
                    2] $CellContext`pScale$}}]}, {$CellContext`i, 
               Length[$CellContext`products$]}]; $CellContext`sumLine$ = {
             Black, 
              AbsoluteThickness[2], 
              
              Line[{{$CellContext`overlapStart$, $CellContext`prodZero + \
$CellContext`yVal$ $CellContext`pScale$}, {$CellContext`overlapEnd$, \
$CellContext`prodZero + $CellContext`yVal$ $CellContext`pScale$}}]}; \
$CellContext`sumLabel$ = Text[
              Style[
               Row[{"y[", $CellContext`n$, "] = ", 
                 NumberForm[$CellContext`yVal$, {4, 3}]}], Bold, 11, 
               Black], {$CellContext`axMax - 
               5, $CellContext`prodZero + $CellContext`yVal$ \
$CellContext`pScale$}, {1, 0}]; $CellContext`cMin$ = 
            Part[$CellContext`ySigRange$, 1]; $CellContext`cMax$ = 
            Part[$CellContext`ySigRange$, 2]; $CellContext`margin$ = 
            Max[0.005, ($CellContext`cMax$ - $CellContext`cMin$) 
              0.03]; $CellContext`cMin$ = $CellContext`cMin$ - \
$CellContext`margin$; $CellContext`cMax$ = $CellContext`cMax$ + \
$CellContext`margin$; $CellContext`yTicks$ = 
            If[$CellContext`inputMode$$ == "step", 
              Table[{$CellContext`v, 
                NumberForm[
                 N[$CellContext`v], {3, 1}]}, {$CellContext`v, 0, 
                Ceiling[$CellContext`cMax$, 0.5], 0.5}], 
              Automatic]; $CellContext`yLineExtra$ = If[
              
              Or[$CellContext`inputMode$$ == "step", $CellContext`inputMode$$ == 
               "impulse"], {
               GrayLevel[0.7], 
               AbsoluteThickness[1.5], 
               
               Line[{{$CellContext`axMin, 0}, {0, 
                 0}}]}, {}]; $CellContext`yLineGhost$ = {
              GrayLevel[0.7], 
              AbsoluteThickness[1.5], 
              Line[
               Table[{$CellContext`t, 
                 
                 Part[$CellContext`yDisp$, $CellContext`t + 
                  1]}, {$CellContext`t, 0, $CellContext`nSamples - 
                 1}]]}; $CellContext`yLineRevealed$ = {Black, 
              AbsoluteThickness[2.5], 
              Line[
               Table[{$CellContext`t, 
                 
                 Part[$CellContext`yDisp$, $CellContext`t + 
                  1]}, {$CellContext`t, 0, $CellContext`n$}]]}; Column[{
              Style[
              "Computing y[" <> ToString[$CellContext`n$] <> 
               "] = \[Sum] h[k] \[CenterDot] x[" <> ToString[$CellContext`n$] <> 
               "-k]   for k = 0.." <> ToString[$CellContext`hLen - 1] <> 
               "    y[" <> ToString[$CellContext`n$] <> "] = " <> ToString[
                 NumberForm[$CellContext`yVal$, {4, 3}]], 12, Gray], 
              Spacer[5], 
              Graphics[{$CellContext`shadingH$, {
                 GrayLevel[0.85], 
                 AbsoluteThickness[0.5], 
                 
                 Line[{{$CellContext`axMin, 0}, {$CellContext`axMax, 
                    0}}]}, $CellContext`xLineExtra$, $CellContext`xLine$, \
$CellContext`hRevLine$, $CellContext`hRevFaded$, {
                 Darker[Green], Dashed, 
                 AbsoluteThickness[1], 
                 
                 Line[{{$CellContext`n$, $CellContext`sigBot$}, \
{$CellContext`n$, $CellContext`sigTop$}}]}, 
                Text[
                 Style["n=" <> ToString[$CellContext`n$], 9, 
                  Darker[Green]], {$CellContext`n$, $CellContext`sigTop$ + 
                  0.05}, {
                 0, -1}], $CellContext`separator$, \
$CellContext`prodZeroLine$, $CellContext`prodLabelLeft$, \
$CellContext`prodBars$, $CellContext`sumLine$, $CellContext`sumLabel$}, 
               PlotRange -> {{$CellContext`axMin, $CellContext`axMax}, \
{$CellContext`plotBottom - 0.3, $CellContext`sigTop$ + 0.15}}, Frame -> True, 
               FrameLabel -> {"Sample index", None}, PlotLabel -> Style[
                 
                 Row[{"Convolution: y[n] = \[Sum] h[k] \[CenterDot] x[n-k]    \
(n = ", $CellContext`n$, ")"}], Bold, 13], ImageSize -> {900, Automatic}, 
               ImagePadding -> $CellContext`commonPadding, AspectRatio -> 
               0.45, FrameTicks -> {
                 Range[$CellContext`axMin, $CellContext`axMax, 100], 
                 Join[$CellContext`sigTicks$, 
                  
                  Table[{$CellContext`prodZero + $CellContext`v \
$CellContext`pScale$, 
                    NumberForm[
                    N[$CellContext`v], {3, 2}]}, {$CellContext`v, -
                    Round[$CellContext`maxProd$, $CellContext`pTickStep$], 
                    
                    Round[$CellContext`maxProd$, $CellContext`pTickStep$], \
$CellContext`pTickStep$}]]}, BaseStyle -> {FontSize -> 11}], 
              Row[{
                Graphics[{Thick, Blue, 
                  Line[{{0, 0}, {1, 0}}]}, ImageSize -> {20, 10}], 
                " x[t] (input)   ", 
                Graphics[{Thick, 
                  Darker[Orange], 
                  Line[{{0, 0}, {1, 0}}]}, ImageSize -> {20, 10}], 
                " h[-k] (reversed, shifted)   ", 
                Graphics[{
                  Darker[Green], 
                  Rectangle[{0, 0}, {1, 1}]}, ImageSize -> {10, 10}], 
                " prod>0  ", 
                Graphics[{Red, 
                  Rectangle[{0, 0}, {1, 1}]}, ImageSize -> {10, 10}], 
                " prod<0  ", 
                Graphics[{Black, Thick, 
                  Line[{{0, 0}, {1, 0}}]}, ImageSize -> {20, 10}], 
                " sum = y[n]"}, 
               Spacer[3]], 
              Spacer[8], 
              Graphics[{{LightGray, 
                 
                 Line[{{$CellContext`axMin, 0}, {$CellContext`axMax, 
                    0}}]}, $CellContext`yLineExtra$, \
$CellContext`yLineGhost$, $CellContext`yLineRevealed$, {Black, 
                 PointSize[0.004], 
                 If[$CellContext`n$ < 200, 
                  Point[
                   Table[{$CellContext`t, 
                    
                    Part[$CellContext`yDisp$, $CellContext`t + 
                    1]}, {$CellContext`t, 0, $CellContext`n$}]], {}]}, {Red, 
                 PointSize[Large], 
                 Point[{$CellContext`n$, 
                   Part[$CellContext`yDisp$, $CellContext`n$ + 1]}]}, {
                Red, Dashed, 
                 AbsoluteThickness[1.5], 
                 Line[{{$CellContext`n$, 
                    
                    Part[$CellContext`yDisp$, $CellContext`n$ + 
                    1]}, {$CellContext`n$, $CellContext`cMin$}}]}, 
                If[$CellContext`inputMode$$ == "step", {Dashed, 
                  GrayLevel[0.5], 
                  AbsoluteThickness[1], 
                  
                  Line[{{$CellContext`axMin, $CellContext`Kdc}, \
{$CellContext`axMax, $CellContext`Kdc}}], 
                  Text[
                   Style[
                    Row[{
                    Subscript["K", "dc"], " = ", $CellContext`Kdc}], 10, 
                    Gray], {$CellContext`axMax - 5, $CellContext`Kdc}, {
                   1, -1.5}]}, {}]}, 
               PlotRange -> {{$CellContext`axMin, $CellContext`axMax}, \
{$CellContext`cMin$, $CellContext`cMax$}}, Frame -> True, 
               FrameLabel -> {"Sample index n", "y[n]"}, PlotLabel -> 
               Style["Output Signal y[n] (revealed progressively)", Bold, 13],
                ImageSize -> {900, Automatic}, 
               ImagePadding -> $CellContext`commonPadding, AspectRatio -> 
               0.22, FrameTicks -> {
                 
                 Range[$CellContext`axMin, $CellContext`axMax, 
                  100], $CellContext`yTicks$}, BaseStyle -> {FontSize -> 11}], 
              Spacer[10], 
              Style[
               Column[{
                 
                 Row[{"Sample rate: ", $CellContext`fs/1000, 
                   " kHz    \[CapitalDelta]t = ", 
                   NumberForm[
                    N[$CellContext`dt 1000], {4, 3}], 
                   " ms    Signal length: ", $CellContext`nSamples, 
