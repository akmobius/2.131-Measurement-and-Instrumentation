                   " kHz, \[Zeta] = ", $CellContext`zeta, ")"}], 
                 "y[n] = \[Sum] h[k] \[CenterDot] x[n-k],  k = 0, 1, ..., " <> 
                 ToString[$CellContext`hLen - 1]}, Spacings -> 0.3], 11, 
