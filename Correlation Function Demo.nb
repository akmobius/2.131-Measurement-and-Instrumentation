Cell["\<\
Auto-Correlation Function, Cross-Correlation Function, Gaussian White Noise, \
Second-order Low Pass Filter, Correlation Function Lag, \
\>", "Text",
 CellChangeTimes->{{3.910700855173557*^9, 3.910700939779601*^9}, {
  3.910701018740958*^9, 3.910701048876916*^9}, {3.910701211541093*^9, 
  3.910701215340085*^9}, {3.910714435279737*^9, 3.910714678834653*^9}, {
  3.9191565504861317`*^9, 3.919156550644785*^9}, {3.969542982766057*^9, 
  3.969542987415156*^9}, {3.969543025684534*^9, 3.969543125825247*^9}, {
  3.9695431682741337`*^9, 3.969543219963472*^9}, {3.970164947467864*^9, 
  3.9701649509924603`*^9}, {3.97041237042343*^9, 3.970412378294159*^9}, {
  3.97076816005556*^9, 3.970768162213531*^9}, {3.9845016238976173`*^9, 
  3.984501685961577*^9}, {3.984501725848826*^9, 3.984501762304517*^9}, {
  3.984501830104508*^9, 3.98450185789701*^9}, {3.984501895873353*^9, 
  3.984501907419379*^9}, {3.984504301107141*^9, 3.984504387601593*^9}, {
  3.984504417951433*^9, 3.98450444386791*^9}, {3.98483642289817*^9, 
  3.984836473718014*^9}},ExpressionUUID->"2dad5f2e-a966-453f-9544-\
