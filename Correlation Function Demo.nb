              Black], {$CellContext`axMax - 
              5, $CellContext`prodZero + $CellContext`corrVal$ \
$CellContext`pScale$}, {1, 
             0}], {}]; $CellContext`bracketY$ = $CellContext`plotBottom + 
           0.05; $CellContext`overlapBracket$ = If[$CellContext`tau$ != 0, {
             Darker[Green], 
             AbsoluteThickness[2], 
             
             Line[{{$CellContext`oStartPos$, $CellContext`bracketY$}, \
