Cell[CellGroupData[{

Cell["Objectives", "Subsubsection",
 CellChangeTimes->{{3.777730627291581*^9, 3.777730650059589*^9}, {
  3.780420495007248*^9, 
  3.780420498367403*^9}},ExpressionUUID->"f5654ee7-6bb4-4e0e-b9eb-\
1acfef97c3b3"],

Cell["\<\
In the following we show how the cross-correlation function between a signal \
x and a signal y is determined. The auto-correlation function is simply the \
cross-correlation function between a signal and itself (i.e. x = y). 
Note: that the cross-correlation function values  for positive and negative \
lag values (i.le,. shifts between x and y) are different. In contrast, the \
auto-correlation values for positive and negative lags are the same (i.e. the \
auto-correlation function is symmetric about lag 0 whereas the \
cross-correlation is not. \
\>", "Text",
 CellChangeTimes->{{3.795792637159613*^9, 3.795793460878191*^9}, {
   3.795793497478001*^9, 3.795793876154686*^9}, {3.795793916938582*^9, 
   3.795793966336678*^9}, {3.795794001200252*^9, 3.7957940824750032`*^9}, {
   3.795796053815051*^9, 3.795796074506651*^9}, {3.795796111797822*^9, 
   3.795796111891233*^9}, {3.795965073191126*^9, 3.7959650853695903`*^9}, 
   3.79596516467314*^9, {3.797239742146985*^9, 3.797239742861068*^9}, 
   3.8419274179990473`*^9, {3.841927496011288*^9, 3.8419276107841454`*^9}, {
   3.841927728568209*^9, 3.841927772826125*^9}, {3.9107102565276756`*^9, 
   3.910710288071786*^9}, {3.910710343672055*^9, 3.9107106719512405`*^9}, 
   3.910711633560255*^9, {3.9191565777743816`*^9, 3.919156578934387*^9}, 
   3.9191566127490406`*^9, {3.950178988320469*^9, 3.9501790310876913`*^9}, {
   3.950266766901586*^9, 3.950266770116702*^9}, {3.969716548035804*^9, 
   3.969716759049933*^9}, {3.9697167911328*^9, 3.969716955583425*^9}, {
   3.9697169857342033`*^9, 3.96971737072225*^9}, {3.969717424511647*^9, 
   3.969717586696678*^9}, {3.969717623137238*^9, 3.969717679925585*^9}, {
   3.9697261984921017`*^9, 3.969726572810769*^9}, {3.969726700633334*^9, 
   3.969726703437751*^9}, {3.969726736645939*^9, 3.969726807630919*^9}, {
   3.9699871760955687`*^9, 3.969987423894044*^9}, {3.9699874799375057`*^9, 
   3.9699876838647614`*^9}, {3.969987726368348*^9, 3.9699877460420218`*^9}, {
   3.970164985974989*^9, 3.970164988314562*^9}, {3.970412403093502*^9, 
   3.970412633071766*^9}, {3.984501924666155*^9, 3.984501947314375*^9}, {
   3.98483648575274*^9, 
   3.9848367878849688`*^9}},ExpressionUUID->"137c9b53-486b-4b32-98f4-\
9686c64addaf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Signal Generation", "Subsubsection",
 CellChangeTimes->{{3.984836799234193*^9, 
  3.984836802208681*^9}},ExpressionUUID->"cd2e4c7f-054e-47cc-8b90-\
a3dfac9f8885"],

Cell["\<\
In the following we generate signal x as a Gaussian white noise signal \
sampled at 10 kHz for 1,000 samples (i.e. signal duration = 0.1 s). 
We pass x into a second-order low-pass system with a static gain of 2, \
natural frequency of 1 kHz and damping parameter of 0.3. We compute the \
cross- correlation function between x and y as well as the auto-correlation \
functions of x and y. We also show the result of multiplying x and or y by -1.\
\>", "Text",
 CellChangeTimes->{{3.984836807790463*^9, 3.984836986290359*^9}, {
  3.9848393142274942`*^9, 
  3.98483937535972*^9}},ExpressionUUID->"5176c657-91db-4a5c-9dee-\
3f282bdbc223"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.984839477917611*^9, 
  3.984839479078392*^9}},ExpressionUUID->"4700d0ce-a4cc-452a-a647-\
b0e753eda4f5"],

Cell["\<\
Notice that the multiplying x or y by -1 has no effect on the \
auto-correlation functions. However, notice that if either x or y is \
multiplied by -1 the cross-correlation function is flipped upside down. Note \
also that the auto-correlation functions are symmetric about 0 lag, where as \
the cross-correlation function is asymmetric about 0 lag. 
To reset the demo go to the Evaluation tab and select Evaluate Notebook.\
\>", "Text",
 CellChangeTimes->{{3.984839485556938*^9, 3.984839673990828*^9}, {
  3.9850867362530413`*^9, 
  3.9850867779601307`*^9}},ExpressionUUID->"1dc0d4c3-1615-43d7-911e-\
c14e78d658ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Demo", "Subsubsection",
 CellChangeTimes->{{3.985003403894989*^9, 
  3.9850034046153107`*^9}},ExpressionUUID->"1a1a8937-a2e6-409c-9ffb-\
4f2a3ee9468e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Cross", "-", 
    RowBox[{"Correlation", " ", "Interactive", " ", "Demonstration"}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Multiple", " ", "input", " ", "signal", " ", "options"}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fs", "=", "50000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dt", "=", 
     RowBox[{"1", "/", "fs"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nSamples", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mMax", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"axMin", "=", 
     RowBox[{"-", "mMax"}]}], ";", 
    RowBox[{"axMax", "=", 
     RowBox[{"nSamples", "+", "mMax", "-", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nTransient", "=", "500"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Second", "-", 
     RowBox[{"order", " ", "system", " ", "parameters"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kdc", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fn", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wn", "=", 
     RowBox[{"2", " ", "Pi", " ", "fn"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zeta", "=", "0.3"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sosCont", "=", 
     RowBox[{"TransferFunctionModel", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"Kdc", " ", 
          RowBox[{
           RowBox[{"wn", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"s", "^", "2"}], "+", 
             RowBox[{"2", " ", "zeta", " ", "wn", " ", "s"}], "+", 
             RowBox[{"wn", "^", "2"}]}], ")"}]}]}], "}"}], "}"}], ",", "s"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sosDisc", "=", 
     RowBox[{"ToDiscreteTimeModel", "[", 
      RowBox[{"sosCont", ",", "dt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"First", "-", 
     RowBox[{"order", " ", "LPF", " ", "for", " ", "band"}], "-", 
     RowBox[{"limited", " ", "noise"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wcLPF", "=", 
     RowBox[{"2", " ", "Pi", " ", "1000"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lpfCont", "=", 
     RowBox[{"TransferFunctionModel", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"wcLPF", "/", 
          RowBox[{"(", 
           RowBox[{"s", "+", "wcLPF"}], ")"}]}], "}"}], "}"}], ",", "s"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lpfDisc", "=", 
     RowBox[{"ToDiscreteTimeModel", "[", 
      RowBox[{"lpfCont", ",", "dt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "all", " ", "input", " ", "signals"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"whiteAll", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", 
       RowBox[{"nSamples", "+", "nTransient"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1", ":", 
     RowBox[{"White", " ", "noise"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xWhite", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"whiteAll", ",", 
       RowBox[{"-", "nSamples"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xWhite", "=", 
     RowBox[{"xWhite", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "xWhite", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2", ":", 
     RowBox[{"Band", "-", 
      RowBox[{"limited", " ", "noise"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blAll", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"OutputResponse", "[", 
       RowBox[{"lpfDisc", ",", "whiteAll"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xBandLim", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"blAll", ",", 
       RowBox[{"-", "nSamples"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xBandLim", "=", 
     RowBox[{"xBandLim", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "xBandLim", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3", ":", 
     RowBox[{"Sinusoid", " ", "in", " ", "noise"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sinPure", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "Pi", " ", "1000", " ", 
         RowBox[{"k", "/", "fs"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"nSamples", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"noiseForSin", "=", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", "]"}], ",", 
         RowBox[{"nSamples", "+", "nTransient"}]}], "]"}], ",", 
       RowBox[{"-", "nSamples"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xSinNoise", "=", 
     RowBox[{
      RowBox[{"0.3", "sinPure"}], "+", "noiseForSin"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xSinNoise", "=", 
     RowBox[{"xSinNoise", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "xSinNoise", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4", ":", 
     RowBox[{"Brownian", " ", "motion"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brownAll", "=", 
     RowBox[{"Accumulate", "[", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", "]"}], ",", 
        RowBox[{"nSamples", "+", "nTransient"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xBrown", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"brownAll", ",", 
       RowBox[{"-", "nSamples"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xBrown", "=", 
     RowBox[{"xBrown", "-", 
      RowBox[{"Mean", "[", "xBrown", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"remove", " ", "DC"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"xBrown", "=", 
     RowBox[{"xBrown", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "xBrown", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "y", " ", "for", " ", "each", " ", "input"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"filterX", "[", "xIn_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xAll", ",", "yAll", ",", "yOut"}], "}"}], ",", 
       RowBox[{
        RowBox[{"xAll", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", "nTransient"}], "]"}], ",", "xIn"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"yAll", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"OutputResponse", "[", 
           RowBox[{"sosDisc", ",", "xAll"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"yOut", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"yAll", ",", 
           RowBox[{"-", "nSamples"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"yOut", "/", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "yOut", "]"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yWhite", "=", 
     RowBox[{"filterX", "[", "xWhite", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yBandLim", "=", 
     RowBox[{"filterX", "[", "xBandLim", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ySinNoise", "=", 
     RowBox[{"filterX", "[", "xSinNoise", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yBrown", "=", 
     RowBox[{"filterX", "[", "xBrown", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Precompute", " ", "correlations", " ", "for", " ", "all", " ", "input", " ",
      "types"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeCorr", "[", 
      RowBox[{"sig1_", ",", "sig2_"}], "]"}], ":=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", "=", "0."}], ",", "tlo", ",", "thi"}], "}"}], ",", 
          RowBox[{
           RowBox[{"tlo", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"0", ",", 
              RowBox[{"-", "tau"}]}], "]"}]}], ";", 
           RowBox[{"thi", "=", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"nSamples", "-", "1"}], ",", 
              RowBox[{"nSamples", "-", "1", "-", "tau"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"s", "+=", 
              RowBox[{
               RowBox[{"sig1", "[", 
