Cell[BoxData[
 DynamicModuleBox[{$CellContext`currentLag$$ = 100, $CellContext`corrMode$$ = 
  "Rxy", $CellContext`flipX$$ = False, $CellContext`flipY$$ = 
  False, $CellContext`inputMode$$ = "white"}, 
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"Lag \[Tau] : \"", Bold, 14, StripOnInput -> False], 
        SliderBox[
         Dynamic[$CellContext`currentLag$$], {-100, 100, 1}, ImageSize -> 
         300], 
        TemplateBox[{12}, "Spacer1"], 
        DynamicBox[
         ToBoxes[
          Style[$CellContext`currentLag$$, Bold, 18, Red], StandardForm], 
         ImageSizeCache -> {
          32.4, {0.21599999999999997`, 11.645999999999999`}}], 
        TemplateBox[{20}, "Spacer1"], 
        StyleBox["\"Corr: \"", Bold, 12, StripOnInput -> False], 
        PopupMenuBox[
         Dynamic[$CellContext`corrMode$$], {"Rxy" -> TemplateBox[{
             SubscriptBox["\"R\"", "\"xy\""], "\" (cross)\""}, "RowDefault"], 
          "Rxx" -> TemplateBox[{
             SubscriptBox["\"R\"", "\"xx\""], "\" (auto x)\""}, "RowDefault"],
           "Ryy" -> TemplateBox[{
             SubscriptBox["\"R\"", "\"yy\""], "\" (auto y)\""}, 
            "RowDefault"]}], 
        TemplateBox[{15}, "Spacer1"], 
        ButtonBox[
         DynamicBox[
          ToBoxes[
           If[$CellContext`flipX$$, "Restore x", "Negate x"], StandardForm], 
          ImageSizeCache -> {54.18359375, {2.412109375, 9.15966796875}}], 
         Appearance -> Automatic, 
         ButtonFunction :> ($CellContext`flipX$$ = Not[$CellContext`flipX$$]),
          Evaluator -> Automatic, ImageSize -> {80, 24}, Method -> 
         "Preemptive"], 
        TemplateBox[{5}, "Spacer1"], 
        ButtonBox[
         DynamicBox[
          ToBoxes[
           If[$CellContext`flipY$$, "Restore y", "Negate y"], StandardForm], 
          ImageSizeCache -> {54.4248046875, {2.412109375, 9.15966796875}}], 
         Appearance -> Automatic, 
         ButtonFunction :> ($CellContext`flipY$$ = Not[$CellContext`flipY$$]),
          Evaluator -> Automatic, ImageSize -> {80, 24}, Method -> 
         "Preemptive"]},
       "RowDefault"]},
     {
      TemplateBox[{
        StyleBox["\"Input x[t]: \"", Bold, 12, StripOnInput -> False], 
        PopupMenuBox[
         Dynamic[$CellContext`inputMode$$], {
         "white" -> "\"White noise\"", "bandlim" -> 
          "\"Band-limited noise (1 kHz LPF)\"", "sinnoise" -> 
          "\"Sinusoid (1 kHz) + noise\"", "brown" -> "\"Brownian motion\""}]},
       
       "RowDefault"]},
     {
      TemplateBox[{5},
       "Spacer1"]},
     {
      DynamicBox[ToBoxes[
        Module[{$CellContext`tau$ = $CellContext`currentLag$$, \
$CellContext`sd$ = $CellContext`signalData[$CellContext`inputMode$$], \
$CellContext`sig1$, $CellContext`sig2$, $CellContext`activeCorr$, \
$CellContext`flipSign$, $CellContext`sig1Name$, $CellContext`sig2Name$, \
$CellContext`sig1Color$, $CellContext`sig2Color$, $CellContext`oStartPos$, \
$CellContext`oEndPos$, $CellContext`ov$, $CellContext`products$, \
$CellContext`corrVal$, $CellContext`prodBars$, $CellContext`sig1Line$, \
$CellContext`sig2Overlap$, $CellContext`sig2Beyond$, $CellContext`meanLine$, \
$CellContext`meanLabel$, $CellContext`overlapBracket$, \
$CellContext`shadingX$, $CellContext`shadingYbeyond$, \
$CellContext`shadingXonly$, $CellContext`bracketY$, $CellContext`separator$, \
$CellContext`prodZeroLine$, $CellContext`prodLabelLeft$, $CellContext`yos$, \
$CellContext`yoe$, $CellContext`xSig$, $CellContext`ySig$, \
$CellContext`corrXXd$, $CellContext`corrYYd$, $CellContext`corrXYd$, \
$CellContext`pScale$, $CellContext`maxProd$, $CellContext`pTickStep$, \
$CellContext`revStart$, $CellContext`revEnd$, $CellContext`cMin$, \
$CellContext`cMax$, $CellContext`margin$, $CellContext`corrLabel$, \
$CellContext`corrMinV$, $CellContext`corrMaxV$}, $CellContext`xSig$ = \
$CellContext`sd$["x"]; $CellContext`ySig$ = $CellContext`sd$[
           "y"]; $CellContext`corrXXd$ = $CellContext`sd$[
           "xx"]; $CellContext`corrYYd$ = $CellContext`sd$[
           "yy"]; $CellContext`corrXYd$ = $CellContext`sd$[
           "xy"]; $CellContext`maxProd$ = \
$CellContext`maxAbsProds[$CellContext`inputMode$$]; $CellContext`sig1$ = 
          If[$CellContext`flipX$$, -$CellContext`xSig$, $CellContext`xSig$]; \
$CellContext`sig2$ = Switch[$CellContext`corrMode$$, "Rxy", 
            If[$CellContext`flipY$$, -$CellContext`ySig$, $CellContext`ySig$],
             "Rxx", 
            If[$CellContext`flipX$$, -$CellContext`xSig$, $CellContext`xSig$],
             "Ryy", 
            
            If[$CellContext`flipY$$, -$CellContext`ySig$, \
$CellContext`ySig$]]; $CellContext`flipSign$ = 
          Switch[$CellContext`corrMode$$, "Rxy", 
            If[
             Xor[$CellContext`flipX$$, $CellContext`flipY$$], -1, 1], "Rxx", 
            1, "Ryy", 1]; $CellContext`activeCorr$ = <|
            
            Table[$CellContext`t2 -> $CellContext`flipSign$ 
              Switch[$CellContext`corrMode$$, "Rxy", 
                $CellContext`corrXYd$[$CellContext`t2], "Rxx", 
                $CellContext`corrXXd$[$CellContext`t2], "Ryy", 
                $CellContext`corrYYd$[$CellContext`t2]], {$CellContext`t2, \
-$CellContext`mMax, $CellContext`mMax}]|>; {$CellContext`sig1Name$, \
$CellContext`sig2Name$} = Switch[$CellContext`corrMode$$, "Rxy", {
             If[$CellContext`flipX$$, "-x[t]", "x[t]"], 
             If[$CellContext`flipY$$, "-y[t+\[Tau]]", "y[t+\[Tau]]"]}, "Rxx", {
             If[$CellContext`flipX$$, "-x[t]", "x[t]"], 
             If[$CellContext`flipX$$, "-x[t+\[Tau]]", "x[t+\[Tau]]"]}, "Ryy", {
             If[$CellContext`flipY$$, "-y[t]", "y[t]"], 
             
             If[$CellContext`flipY$$, "-y[t+\[Tau]]", 
              "y[t+\[Tau]]"]}]; $CellContext`sig1Color$ = 
          Switch[$CellContext`corrMode$$, "Rxy", Blue, "Rxx", Blue, "Ryy", 
            Red]; $CellContext`sig2Color$ = 
          Switch[$CellContext`corrMode$$, "Rxy", Red, "Rxx", 
            Darker[Blue, 0.3], "Ryy", 
            Darker[Red, 0.3]]; 
         If[$CellContext`corrMode$$ == "Ryy", $CellContext`sig1$ = 
           If[$CellContext`flipY$$, -$CellContext`ySig$, $CellContext`ySig$]]; \
$CellContext`oStartPos$ = Max[0, -$CellContext`tau$]; $CellContext`oEndPos$ = 
          Min[$CellContext`nSamples - 1, $CellContext`nSamples - 
            1 - $CellContext`tau$]; $CellContext`ov$ = 
          Max[0, $CellContext`oEndPos$ - $CellContext`oStartPos$ + 
            1]; $CellContext`products$ = 
          Table[{$CellContext`t, Part[$CellContext`sig1$, $CellContext`t + 1] 
             Part[$CellContext`sig2$, $CellContext`t + $CellContext`tau$ + 
               1]}, {$CellContext`t, $CellContext`oStartPos$, \
$CellContext`oEndPos$}]; $CellContext`corrVal$ = \
$CellContext`activeCorr$[$CellContext`tau$]; $CellContext`pScale$ = 
          1.3/Max[$CellContext`maxProd$, 0.001]; $CellContext`pTickStep$ = 
          Round[$CellContext`maxProd$/3, 0.1]; 
         If[$CellContext`pTickStep$ == 0, $CellContext`pTickStep$ = 
           Max[0.01, $CellContext`maxProd$/3]]; $CellContext`shadingX$ = {
            Opacity[0.04], $CellContext`sig1Color$, 
            
            Rectangle[{
             0, $CellContext`sigMin}, {$CellContext`nSamples - 
              1, $CellContext`sigMax}]}; $CellContext`shadingYbeyond$ = 
          Which[$CellContext`tau$ > 0, {
             Opacity[0.15], Yellow, 
             
             Rectangle[{-$CellContext`tau$, $CellContext`sigMin}, {
              0, $CellContext`sigMax}]}, $CellContext`tau$ < 0, {
             Opacity[0.15], Yellow, 
             
             Rectangle[{$CellContext`nSamples - 
               1, $CellContext`sigMin}, {$CellContext`nSamples - 
               1 - $CellContext`tau$, $CellContext`sigMax}]}, 
            True, {}]; $CellContext`shadingXonly$ = Which[
            
            And[$CellContext`tau$ > 
             0, $CellContext`tau$ < $CellContext`nSamples], {
             Opacity[0.08], Gray, 
             
             Rectangle[{$CellContext`nSamples - 1 - $CellContext`tau$ + 
               1, $CellContext`sigMin}, {$CellContext`nSamples - 
               1, $CellContext`sigMax}]}, 
            
            And[$CellContext`tau$ < 
             0, $CellContext`tau$ > -$CellContext`nSamples], {
             Opacity[0.08], Gray, 
             
             Rectangle[{
              0, $CellContext`sigMin}, {-$CellContext`tau$ - 
               1, $CellContext`sigMax}]}, 
            True, {}]; $CellContext`sig1Line$ = {
           Thick, $CellContext`sig1Color$, 
            Line[
             Table[{$CellContext`t, 
               Part[$CellContext`sig1$, $CellContext`t + 1]}, {$CellContext`t,
                0, $CellContext`nSamples - 1}]]}; $CellContext`yos$ = 
          Max[0, -$CellContext`tau$]; $CellContext`yoe$ = 
          Min[$CellContext`nSamples - 1, $CellContext`nSamples - 
            1 - $CellContext`tau$]; $CellContext`sig2Overlap$ = {
           Thick, $CellContext`sig2Color$, 
            Line[
             Table[{$CellContext`j - $CellContext`tau$, 
               
               Part[$CellContext`sig2$, $CellContext`j + 
                1]}, {$CellContext`j, $CellContext`tau$ + \
$CellContext`oStartPos$, $CellContext`tau$ + $CellContext`oEndPos$}]]}; \
$CellContext`sig2Beyond$ = Which[$CellContext`tau$ > 0, {
             Opacity[0.25], $CellContext`sig2Color$, 
             AbsoluteThickness[2.5], 
             Line[
              Table[{$CellContext`j - $CellContext`tau$, 
                
                Part[$CellContext`sig2$, $CellContext`j + 
                 1]}, {$CellContext`j, 0, $CellContext`tau$ - 
                1}]]}, $CellContext`tau$ < 0, {
             Opacity[0.25], $CellContext`sig2Color$, 
             AbsoluteThickness[2.5], 
             Line[
              Table[{$CellContext`j - $CellContext`tau$, 
                
                Part[$CellContext`sig2$, $CellContext`j + 
                 1]}, {$CellContext`j, $CellContext`nSamples + \
$CellContext`tau$, $CellContext`nSamples - 1}]]}, 
            True, {}]; $CellContext`separator$ = {
            GrayLevel[0.7], 
            AbsoluteThickness[1], 
            
            Line[{{$CellContext`axMin, $CellContext`sepY}, \
{$CellContext`axMax, $CellContext`sepY}}]}; $CellContext`prodZeroLine$ = {
            GrayLevel[0.75], 
            AbsoluteThickness[0.5], 
            
            Line[{{$CellContext`axMin, $CellContext`prodZero}, \
{$CellContext`axMax, $CellContext`prodZero}}]}; $CellContext`prodLabelLeft$ = 
          Text[
            
            Style[$CellContext`sig1Name$ <> 
             "\[CenterDot]" <> $CellContext`sig2Name$, 10, 
             Gray], {$CellContext`axMin + 
             5, $CellContext`prodZero + $CellContext`prodMargin - 0.1}, {-1, 
            0}]; $CellContext`prodBars$ = Table[{
             If[Part[$CellContext`products$, $CellContext`i, 2] >= 0, 
              Directive[
               Opacity[0.6], 
               Darker[Green]], 
              Directive[
               Opacity[0.55], Red]], 
             AbsoluteThickness[2], 
             Line[{{
                
                Part[$CellContext`products$, $CellContext`i, 
                 1], $CellContext`prodZero}, {
                
                Part[$CellContext`products$, $CellContext`i, 
                 1], $CellContext`prodZero + 
                Part[$CellContext`products$, $CellContext`i, 
                   2] $CellContext`pScale$}}]}, {$CellContext`i, 
             Length[$CellContext`products$]}]; $CellContext`meanLine$ = 
          If[$CellContext`oStartPos$ <= $CellContext`oEndPos$, {Black, 
             AbsoluteThickness[2], 
             
             Line[{{$CellContext`oStartPos$, $CellContext`prodZero + \
$CellContext`corrVal$ $CellContext`pScale$}, {$CellContext`oEndPos$, \
$CellContext`prodZero + $CellContext`corrVal$ $CellContext`pScale$}}]}, {}]; \
