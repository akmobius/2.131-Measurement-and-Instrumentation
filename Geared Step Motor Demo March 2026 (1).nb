       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"angle", "=", "0.0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"tmp1", "=", "0.0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"tmp2", "=", "0.0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"imu", "@", 
     RowBox[{"GetOrientation", "[", 
      RowBox[{"angle", ",", "tmp1", ",", "tmp2"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"angle", "/", "16."}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Pause", "[", "1", "]"}]}], ",", "\[IndentingNewLine]", "15"}], 
