Cell[CellGroupData[{

Cell["Battery", "Subsubsection",
 CellChangeTimes->{{3.914516843906906*^9, 3.9145168465772686`*^9}, {
  3.932835542414081*^9, 
  3.932835543229846*^9}},ExpressionUUID->"2f9345f8-1ad6-4ad9-80b1-\
770c9265f172"],

Cell[TextData[{
 "We use a deWalt 20 V lithium ion battery. We need a source of power for the \
step motor separate from the USB-c connected to the Master Brick.  Part of \
the USB-c standard allows sources of electrical power such as batteries to \
deliver a specific voltage when requested. The device that does this is \
called a ",
 StyleBox["USB-c decoy",
  FontWeight->"Bold"],
 ". The one used here has 3 small switches (called DIP switches) which can be \
set to produce one of: 5, 9, 12, 15, and 20 V.  As mentioned we want 12 V."
}], "Text",
 CellChangeTimes->{{3.918155335993093*^9, 3.9181554756979713`*^9}, {
   3.918155529728061*^9, 3.918155539257505*^9}, {3.9181556281288567`*^9, 
   3.9181556665444584`*^9}, {3.918155970552608*^9, 3.918156285439312*^9}, 
   3.918156626572765*^9, {3.918156662790182*^9, 3.918156792664595*^9}, {
   3.923588302916098*^9, 3.923588307753705*^9}, {3.92737767788346*^9, 
   3.927377725647646*^9}, {3.927377844523137*^9, 3.92737798247401*^9}, {
   3.932835513318235*^9, 3.932835536774291*^9}, {3.935430500997967*^9, 
   3.93543054518897*^9}, {3.935488445698295*^9, 3.935488475258135*^9}, 
   3.935671801792123*^9, 
   3.950018786074039*^9},ExpressionUUID->"499a785a-1619-454b-b027-\
9579d30037b1"],

Cell["\<\
Connect the power (adjacent red and black wires) to the Silent Stepper power \
input (black 2 wire connector).\
\>", "Text",
 CellChangeTimes->{{3.918155335993093*^9, 3.9181554756979713`*^9}, {
  3.918155529728061*^9, 3.918155539257505*^9}, {3.9181556281288567`*^9, 
  3.9181556665444584`*^9}, {3.918155970552608*^9, 
  3.918156285439312*^9}},ExpressionUUID->"7571cd45-b2fb-4b2a-b6a8-\
3b5b985c95b9"],

Cell["\<\
We use either a deWalt Power Stack 20 V, 1.7 AH battery or a deWalt Power \
Stack 20 V, 5 AH battery. They both incorporate lithium ion prismatic (pouch) \
battery cells.
Lets calculate the energy stored by these batteries when fully charged (3 \
white LEDs showing when charge level button pushed). \
\>", "Text",
 CellChangeTimes->{{3.931427920844942*^9, 3.931428021270067*^9}, {
  3.931428174469879*^9, 3.93142821027781*^9}, {3.9314288050196943`*^9, 
  3.93142901902042*^9}, {3.931429370699095*^9, 3.931429437426422*^9}, {
  3.931429576497191*^9, 3.931429600524528*^9}, {3.931429753841345*^9, 
  3.931429828346389*^9}, {3.932235583630045*^9, 3.9322355987880993`*^9}, {
  3.9328355771178017`*^9, 3.932835589132773*^9}, {3.935430603653207*^9, 
  3.935430629588822*^9}, {3.950018802543597*^9, 
  3.9500189315662813`*^9}},ExpressionUUID->"6a8ba3e7-6490-4505-b3a7-\
52f29043037c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.7 AH Battery", "Subsubsection",
 CellChangeTimes->{
  3.9500189456878643`*^9},ExpressionUUID->"ed979ccd-a736-4204-9321-\
b941a3e68d28"],

Cell["\<\
The designation of 1.7 amp hours (1.7 AH) is somewhat nominal. But if it was \
1.7 AH = 1.7 A \[Times] 3600 s, then as power = Volts \[Times] Amps and \
energy = Watts \[Times] Seconds :\
\>", "Text",
 CellChangeTimes->{{3.931427920844942*^9, 3.931428021270067*^9}, {
  3.931428174469879*^9, 3.93142821027781*^9}, {3.9314288050196943`*^9, 
  3.93142901902042*^9}, {3.931429370699095*^9, 3.931429437426422*^9}, {
  3.931429576497191*^9, 3.931429600524528*^9}, {3.931429753841345*^9, 
  3.931429828346389*^9}, {3.932235583630045*^9, 3.9322355987880993`*^9}, {
  3.9328355771178017`*^9, 3.932835589132773*^9}, {3.935430603653207*^9, 
  3.935430629588822*^9}, {3.950018802543597*^9, 3.950018923761894*^9}, {
  3.950018973821104*^9, 
  3.950018977180895*^9}},ExpressionUUID->"85c97d34-d669-4173-ba26-\
1d7d3ed79140"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"batteryVoltageV", "=", 
   RowBox[{"20", 
    TemplateBox[{
      InterpretationBox["\[InvisibleSpace]", 1], "\"V\"", "volts", 
      "\"Volts\""},
     "Quantity"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"batteryAs", "=", " ", 
   RowBox[{"1.7", 
    TemplateBox[{
      InterpretationBox["\[InvisibleSpace]", 1], "\"A\"", "amperes", 
      "\"Amperes\""},
     "Quantity"], " ", "3600", 
    TemplateBox[{
      InterpretationBox["\[InvisibleSpace]", 1], "\"s\"", "seconds", 
      "\"Seconds\""},
     "Quantity"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"batteryEnergyJ", "=", 
  RowBox[{"UnitConvert", "[", 
   RowBox[{
    RowBox[{"batteryVoltageV", " ", "batteryAs"}], ",", "\"\<J\>\""}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9314280357860622`*^9, 3.9314281661626787`*^9}, {
   3.931428263223751*^9, 3.93142826685855*^9}, {3.931428314671043*^9, 
   3.931428329382003*^9}, {3.93223562782262*^9, 3.932235628982512*^9}, 
   3.9328355968713293`*^9, {3.935430639486834*^9, 3.935430640557068*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"02ae63f3-4e61-4d0e-a2f6-bdbc08491f3a"],

Cell[BoxData[
 TemplateBox[{"122400.`", "\"J\"", "joules", "\"Joules\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.9314290298475018`*^9, 3.9320331968351717`*^9, 
  3.932235634217943*^9, 3.9328356011476183`*^9, 3.9354306448757753`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"81050c7e-771a-4a2c-bf4c-dd20cc09b75a"]
}, Open  ]],

Cell["\<\
This suggests that the battery will would store up to around 120 kJ of energy. 
However, the actual value is a little less. According to the value showed on \
the underside of the battery it can store 30.6 WH (Watt Hours) = 30.6 W \
\[Times] 3600 s:\
\>", "Text",
 CellChangeTimes->{{3.931427920844942*^9, 3.931428021270067*^9}, {
  3.931428174469879*^9, 3.93142821027781*^9}, {3.9314288050196943`*^9, 
  3.931428939739657*^9}, {3.9314290382927027`*^9, 3.931429174971016*^9}, {
  3.931429470185453*^9, 3.931429479290844*^9}, {3.932033230756501*^9, 
  3.932033243891424*^9}, {3.932235645743731*^9, 3.932235652503118*^9}, {
  3.932235712829911*^9, 3.9322357235758038`*^9}, {3.9328356069979467`*^9, 
  3.932835607709476*^9}, {3.932835746453287*^9, 3.932835751173044*^9}, {
  3.935430650988839*^9, 3.9354306515884733`*^9}, {3.935430683298627*^9, 
  3.935430691644236*^9}},ExpressionUUID->"8347b462-d227-41e1-9a71-\
a8c230e5dc39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"batteryEnergyJ", "=", 
  RowBox[{"30.6", 
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], "\"W\"", "watts", "\"Watts\""},
    "Quantity"], " ", "\[Times]", " ", "3600", 
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], "\"s\"", "seconds", 
     "\"Seconds\""},
    "Quantity"]}]}]], "Input",
 CellChangeTimes->{{3.931429197206279*^9, 3.9314292382195473`*^9}, {
  3.932235727577002*^9, 3.932235729004921*^9}, {3.932835755461893*^9, 
  3.932835755717236*^9}, {3.935430694813794*^9, 3.935430696364422*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"704cfc21-a561-4dd9-b105-d9db872ee273"],

Cell[BoxData[
 TemplateBox[{"110160.`", 
   RowBox[{"\"s\"", "\[ThinSpace]", "\"W\""}], "second watts", 
   RowBox[{"\"Seconds\"", " ", "\"Watts\""}]},
  "Quantity"]], "Output",
 CellChangeTimes->{3.931429248156004*^9, 3.9322357315889482`*^9, 
  3.9328357573259363`*^9, 3.934197998383835*^9, 3.9354306991910353`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"0c59af49-09c8-48ff-b77d-5e5d7042527c"]
}, Open  ]],

Cell["1 Watt \[Times] 1 Second = 1 Joule, so we have:", "Text",
