  3.935430629588822*^9}, {3.950018802543597*^9, 3.950018923761894*^9}, {
  3.950018973821104*^9, 3.950018977180895*^9}, {3.950019013533505*^9, 
  3.950019030680748*^9}},ExpressionUUID->"680ed795-8cb8-4a94-bbab-\
d0a8ee3c61ed"],

