Cell[CellGroupData[{

Cell["\<\
Pass the input, x(t), through the static nonlinear element, n(\[CenterDot]), \
to generate the internal signal, u(t)\
\>", "Subsubsection",
 CellChangeTimes->{{3.7837131830105715`*^9, 3.783713189794434*^9}, {
  3.783770186592855*^9, 3.783770193266863*^9}, {3.784153405272572*^9, 
  3.784153455176224*^9}, {3.7841535239622297`*^9, 
  3.7841535285587916`*^9}},ExpressionUUID->"eda11cba-a541-4331-a4c3-\
632a669685f8"],

Cell["\<\
We now pass x(t) through our static nonlinearity, n(\[CenterDot]), to produce \
the internal signal, u(t):\
\>", "Text",
 CellChangeTimes->{{3.7839490950072885`*^9, 3.783949147161079*^9}, {
  3.78415346264569*^9, 3.7841534831366243`*^9}, {3.7841535337759275`*^9, 
  3.784153534092384*^9}},ExpressionUUID->"5e92e403-ba72-495e-a797-\
800263ddedc6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"u", "=", 
   RowBox[{"n", "[", "x", "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ti", ",", "u"}], "}"}], "\[Transpose]"}], ",", 
