Cell[CellGroupData[{

Cell["Parametric models", "Subsubsection",
 CellChangeTimes->{{3.783988828077304*^9, 
  3.783988836030966*^9}},ExpressionUUID->"7e4092b2-f820-4f02-ad70-\
a8002d978296"],

Cell["\<\
Now that we have a good nonparametric model for the impulse response function \
it is appropriate to go one more step and generate a parametric (equation \
based) model for it. \
\>", "Text",
 CellChangeTimes->{{3.783988719029609*^9, 3.783988812451602*^9}, {
  3.784735986248456*^9, 
  3.784736011431136*^9}},ExpressionUUID->"623ebdf4-a3c2-40ad-8d3d-\
5d843a329d0a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parametric impulse response function model", "Subsubsection",
 CellChangeTimes->{{3.783988697718488*^9, 
  3.783988710911713*^9}},ExpressionUUID->"988ee9dd-4c81-4c43-adda-\
7639350094db"],

Cell["\<\
By observation of the shape of hi2(\[Tau]) it looks as though it might be \
well approximated (fitted) by a second-order low-pass underdamped impulse \
response function.\
\>", "Text",
 CellChangeTimes->{{3.7839950129271984`*^9, 3.783995078776976*^9}, 
   3.784032405647569*^9},ExpressionUUID->"68865b72-50b4-4d55-b6f6-\
f4eb9c0d219c"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"\[Tau]_", ",", "\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], 
    "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Zeta]"}], " ", "\[Tau]", " ", "\[Omega]"}]], " ", 
     "\[Alpha]", " ", "\[Omega]", " ", 
     RowBox[{"Sinh", "[", 
      RowBox[{
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["\[Zeta]", "2"]}]], " ", "\[Tau]", " ", "\[Omega]"}], 
      "]"}]}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[Zeta]", "2"]}]]]}]}]], "Input",
 CellChangeTimes->{{3.780521060934205*^9, 3.780521076727903*^9}, {
   3.7805770350457377`*^9, 3.780577046390332*^9}, {3.780658840161008*^9, 
   3.78065884434752*^9}, {3.780659132946929*^9, 3.780659149130973*^9}, 
   3.781434523395187*^9, {3.783945053504515*^9, 3.7839450712935605`*^9}, {
   3.783946372123941*^9, 3.7839463950660706`*^9}, 3.783946625811929*^9, {
   3.783947610380336*^9, 3.783947667639703*^9}, 3.7839493518407583`*^9, {
   3.7839952761438246`*^9, 3.783995333586475*^9}, {3.784032412086402*^9, 
   3.7840324278356915`*^9}, 3.7840331303232803`*^9},
 CellLabel->
  "In[185]:=",ExpressionUUID->"1febd52a-4ee3-429c-b4ed-5fb13b05e15d"],

Cell["\<\
We start by defining an objective function to be minimized. Lets find the 3 \
parameters of the parametric second order low-pass underdamped impulse \
response function which minimize the sum of squared differences between it \
and the best nonparametric impulse response function model we determined, \
namely, h2(\[Tau]). \
\>", "Text",
 CellChangeTimes->{{3.783994767297222*^9, 3.783995004376489*^9}, 
   3.7839951059851317`*^9},ExpressionUUID->"c8d4788c-4de1-4246-a6c1-\
f4e370b26e0a"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{
   RowBox[{"rmsError", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "hi2", "]"}]}], "}"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"hi2", "-", 
            RowBox[{"h", "[", 
             RowBox[{
             "\[Tau]i", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], 
             "]"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{"hi2", "-", 
            RowBox[{"h", "[", 
             RowBox[{
             "\[Tau]i", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], 
             "]"}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"n", "-", "2"}], ")"}]}], "]"}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.783996541013671*^9, 3.783996543575557*^9}, {
   3.784032436326697*^9, 3.784032465222828*^9}, 3.7840325181863413`*^9, {
   3.7840331718543177`*^9, 3.784033173322715*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"58fa4c78-a00e-4cf7-9d20-4d738d4cda56"],

Cell["\<\
From inspection of h2(\[Tau]) above lets estimate that the natural frequency \
will be near 7 Hz. Which in rad/s is  :\
\>", "Text",
 CellChangeTimes->{
  3.773065373714017*^9, {3.773065755066406*^9, 3.773065854754451*^9}, 
   3.777497493328702*^9, {3.7805046917313194`*^9, 3.780504693106388*^9}, {
   3.780504787671176*^9, 3.780504884305323*^9}, {3.780520411298387*^9, 
   3.780520472369947*^9}, {3.780520529916589*^9, 3.780520549099173*^9}, {
   3.781301673115805*^9, 3.7813016890495653`*^9}, {3.7839956754224033`*^9, 
   3.783995710002454*^9}, {3.7839958136906013`*^9, 3.7839958306940956`*^9}, {
   3.783996126646549*^9, 
   3.783996126646549*^9}},ExpressionUUID->"4e0e1f35-2f78-40de-b5a7-\
4a603fe7a666"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", 
   RowBox[{"\[Omega]\[Omega]", "=", 
    RowBox[{"2", "\[Pi]", " ", "7.0"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.780520507030995*^9, {3.7805733047871118`*^9, 3.780573314972561*^9}, 
   3.780658948261367*^9, 3.7806591980256915`*^9, {3.780751511730538*^9, 
   3.7807515144486456`*^9}, {3.783995835226578*^9, 3.783995835273799*^9}, {
   3.784032493852903*^9, 3.784032521782209*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"1af41bfb-66b8-4f51-8978-ea6aacfab6b6"],

Cell["\<\
The system is clearly only slightly underdamped (i.e., a little less than \
1.0) so lets set it to be:\
\>", "Text",
 CellChangeTimes->{
  3.773065373714017*^9, {3.773065755066406*^9, 3.773065854754451*^9}, 
   3.777497493328702*^9, {3.7805046917313194`*^9, 3.780504693106388*^9}, {
   3.780504787671176*^9, 3.780504997853163*^9}, {3.783995842087373*^9, 
   3.783995862653294*^9}},ExpressionUUID->"46f50a4b-1a16-465d-b4e7-\
4c0ea81cf5ff"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", 
   RowBox[{"\[Zeta]\[Zeta]", "=", "0.8"}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.780573392440804*^9, {3.780573436447643*^9, 3.7805734365882425`*^9}, {
   3.780573545251342*^9, 3.7805735453607726`*^9}, {3.780599916955145*^9, 
   3.78059994701508*^9}, 3.780658958274252*^9, 3.78065919974369*^9, {
   3.780751524415054*^9, 3.780751524493166*^9}, {3.780754369053013*^9, 
   3.7807543691779785`*^9}, {3.783995867124504*^9, 3.783995867155792*^9}, {
   3.783996340791309*^9, 3.78399634083856*^9}, {3.784032496039485*^9, 
   3.784032525484298*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"dfc0d59b-eea8-4abc-a4f0-02fd19b9fec3"],

Cell["\<\
The static gain (i.e., overall gain) is the area under the impulse response \
function which we forced to be 1, so lets set it to be:\
\>", "Text",
 CellChangeTimes->{
  3.773065373714017*^9, {3.773065755066406*^9, 3.773065854754451*^9}, 
   3.777497493328702*^9, {3.7805046917313194`*^9, 3.780504693106388*^9}, {
   3.780504787671176*^9, 3.780504945754252*^9}, {3.780505012021743*^9, 
   3.780505115158208*^9}, 3.780505168874733*^9, {3.780576673142586*^9, 
   3.780576737368522*^9}, {3.7805767754242215`*^9, 3.780576783125164*^9}, {
   3.7805921303877497`*^9, 3.780592218069405*^9}, {3.7806589550410576`*^9, 
   3.780658967631821*^9}, {3.7813017040613303`*^9, 3.781301752465344*^9}, {
   3.783995899265318*^9, 3.783995960735864*^9}, {3.7840325778772573`*^9, 
   3.7840325883959174`*^9}, {3.784056187829173*^9, 
   3.784056189893068*^9}},ExpressionUUID->"85109408-83d2-467d-8d23-\
2810b4dbc841"],

