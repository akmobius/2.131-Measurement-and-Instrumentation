Cell["Now we have a really low spread in the points.", "Text",
 CellChangeTimes->{{3.784767841509156*^9, 
  3.7847678522625537`*^9}},ExpressionUUID->"809c765e-4d48-4774-bcc9-\
a588464a4f77"],

Cell["\<\
So lets re-estimate the four parameters of a saturation nonlinearity model \
using Levenberg - Marquardt nonlinear minimization technique to fit to the x \
(t) vs u4 (t) cross - plot  above to give a new estimate n3(\[CenterDot]) :\
\>", "Text",
 CellChangeTimes->{{3.784735672072648*^9, 3.7847357651577396`*^9}, {
  3.784736156251154*^9, 
  3.784736159665765*^9}},ExpressionUUID->"ac962077-05d4-4eb5-b4b0-\
373054860bfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", "  ", 
   RowBox[{"n3", "=", 
    RowBox[{
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "u4"}], "}"}], "\[Transpose]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", "xx", ",", 
         SuperscriptBox["xx", "2"], ",", 
         SuperscriptBox["xx", "3"], ",", 
         SuperscriptBox["xx", "4"], ",", 
         SuperscriptBox["xx", "5"], ",", 
         SuperscriptBox["xx", "6"], ",", 
         SuperscriptBox["xx", "7"], ",", 
         SuperscriptBox["xx", "8"], ",", 
         SuperscriptBox["xx", "9"]}], "}"}], ",", "xx"}], "]"}], 
     "[", "\"\<Function\>\"", "]"}]}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.7847349402301826`*^9, 3.7847349982665434`*^9}, {
  3.7847353593624353`*^9, 3.784735404305698*^9}, {3.784735777739459*^9, 
  3.7847357988434887`*^9}, {3.784736162484705*^9, 3.7847361700393434`*^9}, {
  3.7847654441057115`*^9, 3.784765450106659*^9}, {3.784765683130479*^9, 
  3.784765701537314*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"e947cda7-523a-466a-9523-42eece3ab716"],

Cell["\<\
Lets plot this estimate, n3(\[CenterDot]), of the nonlinearity together with \
the cross-plot of x(t) vs u3(t):\
\>", "Text",
 CellChangeTimes->{{3.783718675464451*^9, 3.783718706893976*^9}, {
  3.783768741616623*^9, 3.783768749179517*^9}, {3.7838923005098767`*^9, 
  3.78389231160559*^9}, {3.7842281796191034`*^9, 3.784228186297419*^9}, {
  3.784735813988139*^9, 3.784735817674195*^9}, {3.784736180129432*^9, 
  3.784736184846957*^9}},ExpressionUUID->"865d5347-89b8-485c-9cc5-\
d8f17342eae1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "u4"}], "}"}], "\[Transpose]"}], ",", 
       RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
