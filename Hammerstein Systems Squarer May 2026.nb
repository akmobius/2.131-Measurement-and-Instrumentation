Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"vaf1", "=", 
   RowBox[{"100.0", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Variance", "[", "r1", "]"}], "/", 
       RowBox[{"Variance", "[", "y", "]"}]}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.783767620333607*^9, 3.783767655638698*^9}, {
  3.7838789778015428`*^9, 3.783878980855879*^9}, {3.783986892000749*^9, 
