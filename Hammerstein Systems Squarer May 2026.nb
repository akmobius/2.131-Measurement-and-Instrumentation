Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Tau]i", ",", "hi3"}], "}"}], "\[Transpose]"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "\[Rule]", "\"\<Initial Guess Second-order (blue) and Nonparametric \
(black) Models\>\""}], ",", " ", 
       RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{
        "\[Tau]", ",", "\[Alpha]\[Alpha]", ",", "\[Omega]\[Omega]", ",", 
         "\[Zeta]\[Zeta]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", "0", ",", "\[Tau]Max"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Blue"}], ",", 
