  "Out[197]=",ExpressionUUID->"d8883bdd-ce28-465b-934a-7e272ec82470"]
}, Open  ]],

Cell["The estimated values are", "Text",
 CellChangeTimes->{{3.784035302724186*^9, 
  3.78403531677403*^9}},ExpressionUUID->"5fcb72c7-cd03-4114-aeb3-\
1e03bcacbcde"],

