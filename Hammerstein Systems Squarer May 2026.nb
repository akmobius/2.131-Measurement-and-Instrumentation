Cell["\<\
If we multiply h(\[Tau]) by \[Alpha] and divide n(\[CenterDot]) by \[Alpha] \
there will be no change in the output, y(t). In other words there is a \
scaling constant, \[Alpha] , that can freely move from h(\[Tau]) to n(\
\[CenterDot]). \
\>", "Text",
 CellChangeTimes->{{3.78371710219084*^9, 3.7837172733655787`*^9}, {
   3.783950889107704*^9, 3.783950893562702*^9}, {3.7840311448116307`*^9, 
   3.7840311581834393`*^9}, {3.7840312164117684`*^9, 3.784031230019982*^9}, {
   3.784032775086342*^9, 3.784032779259611*^9}, 
   3.784232942071876*^9},ExpressionUUID->"5e19e9ad-e88f-4cc4-982b-\
e9a1a7a93765"],

