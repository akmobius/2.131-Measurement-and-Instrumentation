Cell["\<\
Generate the input, x(t), the unobservable internal signal, u(t) and the \
output, y(t)\
\>", "Subsubsection",
 CellChangeTimes->{{3.783948632630514*^9, 3.783948675672087*^9}, {
  3.78413271989676*^9, 
  3.784132721055042*^9}},ExpressionUUID->"7eceaf14-632d-42d4-9028-\
580e1a3cde04"],

Cell[CellGroupData[{

Cell["Generate Gaussian white noise signal, x(t)", "Subsubsection",
 CellChangeTimes->{{3.767307066881356*^9, 3.767307076226617*^9}, {
   3.767523857728206*^9, 3.767523870598995*^9}, {3.781296982744475*^9, 
   3.781296992086085*^9}, 3.78181793342946*^9, {3.782401063005685*^9, 
   3.7824010838133435`*^9}, {3.783700716682234*^9, 3.78370071871562*^9}, {
   3.78386319522688*^9, 
   3.783863222670567*^9}},ExpressionUUID->"2eefa47d-62f9-47b3-8299-\
90dea7fa51f0"],

Cell["\<\
We start by generating 20 seconds of a Gaussian white noise input, x(t), \
sampled at around 500 Hz, with a mean of 0 and a standard deviation of 1. \
Note that we could have used pretty much any stochastic input here except a \
stochastic binary input (which is not sufficient to identify a nonlinear \
system). Note that as before we generate a sampled version of the time domain \
and specify a maximum time, tMax. Note also that we use the same sampling \
interval in time, \[CapitalDelta]t, as we used for lag, \[CapitalDelta]\[Tau].\
\>", "Text",
 CellChangeTimes->{{3.782401454913993*^9, 3.782401497700927*^9}, {
  3.782559701255872*^9, 3.782559734482084*^9}, {3.783712810491313*^9, 
  3.7837128200164847`*^9}, {3.783948698348713*^9, 
  3.78394890547868*^9}},ExpressionUUID->"5844b972-56d2-423c-87d8-\
dbf7b62ee583"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"tMax", "=", "20.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]t", "=", "\[CapitalDelta]\[Tau]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ti", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0.0", ",", "tMax", ",", " ", "\[CapitalDelta]t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"RandomVariate", "[", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "1.5"}], "]"}], "]"}], ",", 
      RowBox[{"Length", "[", "ti", "]"}]}], "]"}]}], ";"}], " "}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ti", ",", "x"}], "}"}], "\[Transpose]"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.3"}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<Gaussian white noise input, x(t)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "800"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.781270976040075*^9, 3.781270995910817*^9}, {
   3.781276569627106*^9, 3.781276573797639*^9}, {3.781276684929793*^9, 
   3.781276687179324*^9}, {3.781277129232574*^9, 3.781277149882243*^9}, {
   3.781281275463036*^9, 3.781281278138872*^9}, {3.781282318540537*^9, 
