Cell[BoxData["99.96478928057746`"], "Output",
 CellChangeTimes->{3.923594009152432*^9, 3.9742004211148653`*^9, 
  3.9742008983284407`*^9, 3.974289567557102*^9},
 CellLabel->
  "Out[161]=",ExpressionUUID->"71332acb-1f03-4e8f-abf6-2b8752a6bd9b"]
}, Open  ]],

Cell["\<\
This is dramatically higher than our earlier VAF, so we are making very good \
progress:\
\>", "Text",
 CellChangeTimes->{{3.7842288790654836`*^9, 3.7842289237221966`*^9}, {
  3.7842299254283476`*^9, 3.784229937385414*^9}, {3.78423191161301*^9, 
  3.784231912378497*^9}, {3.78423357029012*^9, 3.784233573119506*^9}, {
  3.784236471724427*^9, 3.784236473383037*^9}, {3.784765582701677*^9, 
  3.784765585748229*^9}},ExpressionUUID->"e00e01d4-53c4-4689-9140-\
c87028f3e8b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", "vaf1"}]], "Input",
 CellChangeTimes->{{3.784228917798349*^9, 3.7842289179076777`*^9}},
 CellLabel->
  "In[162]:=",ExpressionUUID->"de50a63b-6e1e-4d9a-a167-29463f2d665e"],

Cell[BoxData["7.4818737070070025`"], "Output",
 CellChangeTimes->{3.923594009154695*^9, 3.974200422795032*^9, 
  3.974200900348299*^9, 3.97428956756177*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"257a7359-c773-412d-b088-95f506715f1e"]
}, Open  ]],

Cell["\<\
However if we can assume that the noise levels are really low we might be \
able to do even better than this. We will therefor attempt to refine our \
estimates of h(\[Tau]) and n(\[CenterDot]) to see if we can achieve an even \
higher VAF.\
\>", "Text",
 CellChangeTimes->{{3.7840316403386602`*^9, 3.78403174500974*^9}, {
  3.784032829657956*^9, 3.784032869101379*^9}, {3.784228944167754*^9, 
  3.784228988997196*^9}, {3.7842335848136454`*^9, 
  3.7842335912319474`*^9}},ExpressionUUID->"eb08e551-2c12-474d-bd3f-\
8bc5fda43fe9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Redo the deconvolution of hi2() from y(t) to yield a new estimate of u(t)\
\>", "Subsubsection",
 CellChangeTimes->{{3.7842300362632647`*^9, 
  3.7842300828171124`*^9}},ExpressionUUID->"bd42074d-9939-4a9b-b936-\
d582a07bf9df"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"u3a", "=", 
    RowBox[{
     FractionBox["1", "\[CapitalDelta]\[Tau]"], 
     RowBox[{"ListDeconvolve", "[", 
      RowBox[{
       RowBox[{"hi2", "/", 
        RowBox[{"(", 
         RowBox[{"\[CapitalDelta]\[Tau]", " ", 
          RowBox[{"Total", "[", "hi2", "]"}]}], ")"}]}], ",", "y", ",", 
       RowBox[{"Method", "\[Rule]", "\"\<Wiener\>\""}]}], "]"}]}]}], ";"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.784205742259982*^9, 3.784205766068276*^9}, {
   3.78420722941411*^9, 3.78420725240519*^9}, 3.784207393920952*^9, 
   3.784207430743177*^9, {3.784207480810286*^9, 3.784207481200949*^9}, {
   3.7842077952077193`*^9, 3.784207806785615*^9}, {3.784208225354721*^9, 
   3.784208248935275*^9}, 3.7842296241976986`*^9, {3.784230102616585*^9, 
   3.784230102710276*^9}, {3.784230147754819*^9, 3.7842301616672792`*^9}, {
   3.784233246358462*^9, 3.784233255658561*^9}, {3.784235349330671*^9, 
   3.784235352142903*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"b4c1751e-8601-4fd4-a5a8-1cef70de7f7a"],

Cell["\<\
The Method used in ListDeconvolve[ ] is based on a method developed by \
Norbert Wiener. But this method has nothing to do with the use of Wieners \
name in association with LN systems.\
\>", "Text",
 CellChangeTimes->{{3.7847678942998505`*^9, 
  3.784767980033511*^9}},ExpressionUUID->"44b31869-6320-46a0-a827-\
40e6ca26f869"],

Cell["\<\
Remember that ListDeconvolve[ ] produces u3a(t) shifted by half the length of \
hi2 plus 1. So we need to trim this first part off and add to the end:\
\>", "Text",
 CellChangeTimes->{{3.784207500610914*^9, 3.7842075804007215`*^9}, {
   3.784207613189204*^9, 3.784207745521637*^9}, 3.784207828826337*^9, {
   3.7842280862415886`*^9, 3.784228102004985*^9}, {3.784767277086383*^9, 
   3.784767298624173*^9}, {3.784767403251406*^9, 3.784767407974448*^9}, {
   3.784767438878908*^9, 
   3.784767458339425*^9}},ExpressionUUID->"304840ed-38fe-4c14-aa0f-\
75d2605a6e15"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"u3", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"u3a", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"1", "+", 
         RowBox[{"(", 
          RowBox[{"m", "/", "2"}], ")"}]}], ";;", "nn"}], "]"}], "]"}], ",", 
     RowBox[{"u3a", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"m", "/", "2"}]}], "]"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7842078970530796`*^9, 3.7842079308528414`*^9}, 
   3.7842081390727577`*^9, {3.784229627621965*^9, 3.784229658316473*^9}, {
   3.784767311937018*^9, 3.7847673474649086`*^9}, {3.7847674667313657`*^9, 
   3.7847674813751597`*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"93256b40-6d6f-4d49-8d31-9cc9a2206304"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-predict n(\[CenterDot])", "Subsubsection",
 CellChangeTimes->{{3.7837183640009174`*^9, 3.783718373394162*^9}, {
  3.784230188490001*^9, 
  3.7842301923374367`*^9}},ExpressionUUID->"11ddf00d-2ed8-4664-9334-\
d5e3194f2827"],

Cell["\<\
Now that we have a new estimate, u3(t), we can predict the form of the static \
nonlinearity by simply cross-plotting x vs u3 :\
\>", "Text",
 CellChangeTimes->{{3.783718378302371*^9, 3.783718469262151*^9}, {
  3.784204219663159*^9, 3.784204225429484*^9}, {3.784230200633982*^9, 
  3.784230226674788*^9}},ExpressionUUID->"b14565d0-0716-4d0b-900f-\
96dec6ec0cf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "u3"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x amplitude\>\"", ",", "\"\<u3 amplitude\>\""}], "}"}]}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<x(t) vs u3(t)\>\""}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}]], "Input",
