Cell["\<\
The prediction is so good it is difficult to see the difference between y(t) \
and y3(t). So lets calculate the residuals, r3(t):\
\>", "Text",
 CellChangeTimes->{{3.7837679072050567`*^9, 3.783767961565934*^9}, {
  3.7842288100384455`*^9, 3.7842288104778285`*^9}, {3.7842372451155353`*^9, 
  3.784237259293188*^9}},ExpressionUUID->"4da58b3b-7a5a-4c21-9c44-\
bc90374c5cdc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"r3", "=", 
   RowBox[{"y", "-", "y3"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "r3"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.3"}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Hammerstein System Output y(t) (blue) and Prediction \
Residuals, r3(t) (red)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "800"}]}]}], "]"}]}], "Input",
