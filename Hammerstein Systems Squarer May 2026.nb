Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"n", "[", "xx_", "]"}], ":=", 
   RowBox[{
    RowBox[{"0.2", " ", 
     RowBox[{"xx", "^", "2"}]}], "+", 
    RowBox[{"0.1", "xx"}]}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"n", "[", "xx", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"xx", ",", 
