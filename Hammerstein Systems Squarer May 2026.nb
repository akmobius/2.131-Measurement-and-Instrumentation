Cell["Now we have much less spread in the points.", "Text",
 CellChangeTimes->{{3.784767796341899*^9, 
  3.784767810091152*^9}},ExpressionUUID->"9e4b6aba-d87f-4adb-9319-\
b4764f053aaf"],

Cell["\<\
So lets re-estimate the four parameters of a saturation nonlinearity model \
using Levenberg - Marquardt nonlinear minimization technique to fit to the x \
(t) vs u3 (t) cross - plot  above to give a new estimate n2(\[CenterDot]) :\
\>", "Text",
 CellChangeTimes->{{3.784735672072648*^9, 
  3.7847357651577396`*^9}},ExpressionUUID->"4c2a9f14-2e5f-4855-b87f-\
46944f2eeb41"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", "  ", 
   RowBox[{"n2", "=", 
    RowBox[{
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "u3"}], "}"}], "\[Transpose]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", "xx", ",", 
         SuperscriptBox["xx", "2"], ",", 
         SuperscriptBox["xx", "3"], ",", 
         SuperscriptBox["xx", "4"], ",", 
         SuperscriptBox["xx", "5"], ",", 
         SuperscriptBox["xx", "6"], ",", 
         SuperscriptBox["xx", "7"], ",", 
         SuperscriptBox["xx", "8"], ",", 
         SuperscriptBox["xx", "9"]}], "}"}], ",", "xx"}], "]"}], 
     "[", "\"\<Function\>\"", "]"}]}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.7847349402301826`*^9, 3.7847349982665434`*^9}, {
  3.7847353593624353`*^9, 3.784735404305698*^9}, {3.784735777739459*^9, 
  3.7847357988434887`*^9}, {3.784765418659993*^9, 3.784765430369251*^9}},
 CellLabel->
  "In[166]:=",ExpressionUUID->"bba68787-184a-4ced-89b8-09e0f3c6934e"],

Cell["\<\
Lets plot this estimate, n2(\[CenterDot]), of the nonlinearity together with \
the cross-plot of x(t) vs u3(t):\
\>", "Text",
 CellChangeTimes->{{3.783718675464451*^9, 3.783718706893976*^9}, {
  3.783768741616623*^9, 3.783768749179517*^9}, {3.7838923005098767`*^9, 
  3.78389231160559*^9}, {3.7842281796191034`*^9, 3.784228186297419*^9}, {
  3.784735813988139*^9, 
  3.784735817674195*^9}},ExpressionUUID->"fbaca089-b031-45e3-96c1-\
741ef0c466af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "u3"}], "}"}], "\[Transpose]"}], ",", 
       RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<x amplitude\>\"", ",", "\"\<u3 amplitude\>\""}], 
         "}"}]}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
       RowBox[{
       "PlotLabel", 
        "\[Rule]", "\"\<x(t) vs u3(t) (black dots) and n (blue) and n2 \
(red)\>\""}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "[", "xx", "]"}], ",", 
         RowBox[{"n2", "[", "xx", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xx", ",", 
         RowBox[{"-", "7"}], ",", "7"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
