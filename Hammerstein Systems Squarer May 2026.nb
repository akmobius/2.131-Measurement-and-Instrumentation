Cell["\<\
This VAF is low. The remaining variance not accounted for by our linear \
dynamic model is a mixture of noise and or nonlinearities.  At this point we \
could assume that the system is linear and proceed to find a suitable \
parametric model. Alternatively we could decide that it is worth exploring \
the possibility that the system is nonlinear. We might assume that the system \
is a Wiener system and proceed to carry out Wiener system ID or we could \
assume that it might be a Hammerstein system and proceed as follows:\
\>", "Text",
 CellChangeTimes->{{3.783986907723431*^9, 3.783986953878984*^9}, {
  3.783988622765644*^9, 3.783988683940835*^9}, {3.7842094678538737`*^9, 
  3.78420959250684*^9}, {3.784236003882377*^9, 3.784236207290316*^9}, {
  3.7847646421406603`*^9, 3.7847646478606834`*^9}, {3.7847651745156903`*^9, 
  3.7847651758520937`*^9}},ExpressionUUID->"c1999a9e-30ec-4fc0-baa3-\
f59e5fb58454"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict u(t)", "Subsubsection",
 CellChangeTimes->{{3.783717796126632*^9, 
  3.783717804457378*^9}},ExpressionUUID->"e9886cb4-58b3-4dc9-a940-\
73cffd8af5fe"],

Cell["\<\
Now that we have hi1(\[Tau]), if we could find its dynamic inverse, hi1Inv(\
\[Tau]), then we could convolve hi1Inv(\[Tau]) with the output, y(t), to \
produce a prediction, u1(t), of the internal signal, u(t). Stated another \
way, we would like to deconvolve the impulse response function from the \
output, y(t), to yield an estimate of u(t).\
\>", "Text",
 CellChangeTimes->{{3.783717815751061*^9, 3.7837178182156763`*^9}, {
   3.783718267880698*^9, 3.783718324735853*^9}, {3.78415378978618*^9, 
   3.784153908770218*^9}, {3.7842030319045057`*^9, 3.7842030484124475`*^9}, {
   3.784209705205838*^9, 3.784209751223133*^9}, 3.784227928743208*^9, {
   3.784231080043337*^9, 
   3.784231083172753*^9}},ExpressionUUID->"7c6492c4-1d17-4d34-b377-\
ce0a6c8cba64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Deconvolution of hi1(\[Tau]) from the output, y(t), to predict the internal \
signal, u(t)\
\>", "Subsubsection",
 CellChangeTimes->{{3.784153924978225*^9, 3.784153940028617*^9}, 
   3.784203066035442*^9, {3.784227950983427*^9, 
   3.7842279985554433`*^9}},ExpressionUUID->"d917ae15-bc65-4800-807a-\
61690941e189"],

Cell["\<\
Mathematica contains some powerful deconvolution methods. They are usually \
used to reduce blur in images but they work for signals also:\
\>", "Text",
 CellChangeTimes->{{3.784153959270327*^9, 3.784154096433719*^9}, {
  3.7842096053061857`*^9, 3.7842096897352657`*^9}, {3.784228009159686*^9, 
  3.7842280588184376`*^9}},ExpressionUUID->"0e89d56d-c033-473b-af54-\
87cde9137698"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"u1a", "=", 
    RowBox[{
     FractionBox["1", "\[CapitalDelta]\[Tau]"], 
     RowBox[{"ListDeconvolve", "[", 
      RowBox[{"hi1", ",", "y", ",", 
       RowBox[{"Method", "\[Rule]", "\"\<Wiener\>\""}]}], "]"}]}]}], ";"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.784205742259982*^9, 3.784205766068276*^9}, {
   3.78420722941411*^9, 3.78420725240519*^9}, 3.784207393920952*^9, 
   3.784207430743177*^9, {3.784207480810286*^9, 3.784207481200949*^9}, {
   3.7842077952077193`*^9, 3.784207806785615*^9}, {3.784208225354721*^9, 
   3.784208248935275*^9}, 3.7842296241976986`*^9, 3.78423333288563*^9},
 CellLabel->
  "In[143]:=",ExpressionUUID->"1e7d2b5a-2979-4ac9-bde6-24cb673d02f3"],

Cell["\<\
ListDeconvolve[ ] produces u1a(t) shifted by half the length of hi1 plus 1. \
So we need to trim this first part off and add to the end:\
\>", "Text",
 CellChangeTimes->{{3.784207500610914*^9, 3.7842075804007215`*^9}, {
   3.784207613189204*^9, 3.784207745521637*^9}, 3.784207828826337*^9, {
   3.7842280862415886`*^9, 3.784228102004985*^9}, {3.784767277086383*^9, 
   3.784767298624173*^9}, {3.784767403251406*^9, 
   3.784767407974448*^9}},ExpressionUUID->"201f71c7-c381-47db-ae07-\
bc700d2d2f35"],

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"nn", "=", 
   RowBox[{"Length", "[", "x", "]"}]}], ";", " ", 
  RowBox[{"m", "=", 
   RowBox[{"Length", "[", "hi1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"u1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"u1a", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"1", "+", 
         RowBox[{"(", 
          RowBox[{"m", "/", "2"}], ")"}]}], ";;", "nn"}], "]"}], "]"}], ",", 
     RowBox[{"u1a", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"m", "/", "2"}]}], "]"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.7842078970530796`*^9, 3.7842079308528414`*^9}, 
   3.7842081390727577`*^9, {3.784229627621965*^9, 3.784229658316473*^9}, {
   3.784767311937018*^9, 3.7847673474649086`*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"e0d211f0-0900-431b-9312-0070fac9dee7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict n(\[CenterDot])", "Subsubsection",
 CellChangeTimes->{{3.7837183640009174`*^9, 
  3.783718373394162*^9}},ExpressionUUID->"d5947135-3c28-4889-9997-\
8ac296f2fb66"],

Cell["\<\
Now that we have an estimate for u1(t) we can predict the form of the static \
nonlinearity by simply cross-plotting x vs u1 :\
\>", "Text",
 CellChangeTimes->{{3.783718378302371*^9, 3.783718469262151*^9}, {
  3.784204219663159*^9, 
  3.784204225429484*^9}},ExpressionUUID->"58179ed6-1584-464f-9062-\
375d381dbb3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "u1"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x amplitude\>\"", ",", "\"\<u1 amplitude\>\""}], "}"}]}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<x(t) vs u1(t)\>\""}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7837185008003106`*^9, 3.783718502911722*^9}, {
