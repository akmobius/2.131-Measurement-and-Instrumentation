Cell["\<\
If we inverse Laplace transform this transfer function then we get:\
\>", "Text",
 CellChangeTimes->{{3.773056482754692*^9, 
  3.773056522787628*^9}},ExpressionUUID->"38b7602b-b968-4bea-8682-\
03aaaf6ed581"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"InverseLaplaceTransform", "[", 
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"s", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], "]"}], 
     ",", "s", ",", "\[Tau]"}], "]"}], "//", "FullSimplify"}]}]], "Input",
 CellChangeTimes->{
  3.780521088600496*^9, {3.780577027879145*^9, 3.780577028035688*^9}, 
