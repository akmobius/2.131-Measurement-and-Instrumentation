Cell["And we can now generate a new output prediction:", "Text",
 CellChangeTimes->{{3.78422845305522*^9, 3.784228464487221*^9}, {
  3.784228777513774*^9, 
  3.7842287893845243`*^9}},ExpressionUUID->"301bf774-1cd2-4bc0-8c2e-\
71adb585d7d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"y2", "=", 
   RowBox[{"\[CapitalDelta]t", " ", 
    RowBox[{"ListConvolve", "[", 
     RowBox[{"hi2", ",", "u2", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "y2"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.3"}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Hammerstein System Output y(t) (blue) and Predicted \
Output, y2(t) (red)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "800"}]}]}], "]"}]}], "Input",
