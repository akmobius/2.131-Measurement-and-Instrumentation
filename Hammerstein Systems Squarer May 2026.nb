Cell["\<\
Nice! Clearly we have an excellent fit and there is no point going to a \
higher order model.\
\>", "Text",
 CellChangeTimes->{{3.784034173724774*^9, 3.7840342048523626`*^9}, {
  3.784036227925951*^9, 
  3.784036229902836*^9}},ExpressionUUID->"89b63c7e-28d7-43dc-a2d1-\
9c29271ddb5b"],

Cell["\<\
The original \[OpenCurlyDoubleQuote]true\[CloseCurlyDoubleQuote] values for \
the static gain, natural frequency and damping were:\
\>", "Text",
 CellChangeTimes->{{3.7840350574204946`*^9, 3.784035192865492*^9}, {
  3.7840354077618246`*^9, 3.784035413287878*^9}, {3.784036466914616*^9, 
  3.784036468759869*^9}},ExpressionUUID->"df1992eb-f4be-42ad-ad16-\
bf5ded912492"],

