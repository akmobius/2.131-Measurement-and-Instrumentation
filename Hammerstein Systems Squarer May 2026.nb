   3.784065241327626*^9}, 3.784065297188071*^9, {3.7841530310218596`*^9, 
   3.784153055373646*^9}},ExpressionUUID->"0c49c418-7ec0-41fe-a1b9-\
9f127253c33c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Note", "Subsubsection",
 CellChangeTimes->{{3.784065320482307*^9, 
