Cell[CellGroupData[{

Cell["Create Hammerstein system", "Subsubsection",
 CellChangeTimes->{{3.783946084781971*^9, 3.783946092017396*^9}, {
  3.784153070845745*^9, 
  3.784153074440948*^9}},ExpressionUUID->"5471af1f-abd1-434b-872a-\
7bc2fbad1ccc"],

Cell["\<\
As an example lets start by making the nonlinear static element, n(\
\[CenterDot]), a saturation nonlinearity and generate a second-order, \
low-pass, under-damped impulse response function, h(\[Tau]), (to model the \
linear dynamic element).\
\>", "Text",
 CellChangeTimes->{{3.783946101397366*^9, 3.783946249493556*^9}, {
  3.7841530930090294`*^9, 3.784153119871783*^9}, {3.784153215453268*^9, 
  3.7841532468970003`*^9}, {3.7843724439533467`*^9, 
  3.7843724635684576`*^9}},ExpressionUUID->"0e81bc8e-d7a9-4105-b351-\
56396356a399"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Saturation static nonlinearity", "Subsubsection",
 CellChangeTimes->{{3.782401158764203*^9, 3.7824012289043856`*^9}, {
  3.783713071382585*^9, 3.78371308810529*^9}, {3.784235733019314*^9, 
  3.7842357347084455`*^9}, {3.784372471302997*^9, 
  3.784372475895733*^9}},ExpressionUUID->"44f3b46b-0191-4fae-9001-\
089d62b2863d"],

Cell["\<\
In this example we will make the static nonlinearity a quadratic:\
\>", "Text",
 CellChangeTimes->{{3.7824152448218746`*^9, 3.782415338668754*^9}, {
  3.783948578671671*^9, 3.783948598975423*^9}, {3.7840524467834854`*^9, 
