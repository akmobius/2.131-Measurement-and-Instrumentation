  "In[142]:=",ExpressionUUID->"1abdef29-612c-43fb-b709-25acd1d15f52"],

Cell[BoxData["7.4818737070070025`"], "Output",
 CellChangeTimes->{3.923594008813259*^9, 3.974200307999454*^9, 
  3.9742008715554457`*^9, 3.974289567047699*^9},
 CellLabel->
  "Out[142]=",ExpressionUUID->"218d5696-ec2e-4a59-ba90-6b8e9f8114e9"]
