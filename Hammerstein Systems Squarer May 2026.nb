6246a089b5e3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-predict internal signal, u2(t)", "Subsubsection",
 CellChangeTimes->{{3.784208662608498*^9, 
  3.784208694179376*^9}},ExpressionUUID->"fbabc8b7-896e-45b3-8016-\
a885beb19173"],

Cell["\<\
Now that we have the estimate, n1(\[CenterDot]), we can transform the input, \
x(t), through it to re-predict the internal signal, u2(t):\
\>", "Text",
 CellChangeTimes->{{3.783767802005376*^9, 3.783767885369144*^9}, {
  3.7842085617747235`*^9, 3.784208589800835*^9}, {3.784208700540358*^9, 
  3.7842087348284736`*^9}},ExpressionUUID->"dc247421-a4fe-407c-b16d-\
314aaff7ddd7"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"u2", "=", 
   RowBox[{"n1", "[", "x", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.783887699051352*^9, 3.783887704474195*^9}, {
   3.783887739054116*^9, 3.783887745808686*^9}, {3.7838905655500593`*^9, 
   3.783890573574683*^9}, {3.783892258186321*^9, 3.7838922583421936`*^9}, {
   3.7838923249870996`*^9, 3.7838923372173977`*^9}, {3.7839510943437185`*^9, 
   3.783951100470212*^9}, {3.784031605179668*^9, 3.78403160655725*^9}, {
   3.7840525943965287`*^9, 3.784052605447194*^9}, {3.784052713661232*^9, 
   3.7840527315092754`*^9}, {3.784208598659933*^9, 3.784208634939222*^9}, {
   3.784209033739248*^9, 3.784209035196647*^9}, 3.7842334369616656`*^9, 
   3.7842335129770393`*^9},
 CellLabel->
  "In[149]:=",ExpressionUUID->"7c0b7ce5-af87-4b3a-8882-3a1fee29dc56"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-estimate the impulse response function", "Subsubsection",
 CellChangeTimes->{{3.7842087468982315`*^9, 
  3.784208760280585*^9}},ExpressionUUID->"9907dfad-5f3a-4ef5-b6ce-\
e79720c96144"],

Cell["\<\
Now that we have a new prediction of the internal signal, u2(t), we can \
re-estimate the impulse response function but now between u2(t) and y(t):\
\>", "Text",
 CellChangeTimes->{{3.7842087665781813`*^9, 
  3.784208817809159*^9}},ExpressionUUID->"8e9487cb-c040-42df-b883-\
76057296ff11"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"uacf", "=", 
   RowBox[{"cor", "[", 
    RowBox[{"u2", ",", "u2", ",", 
     RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uyccf", "=", 
    RowBox[{"cor", "[", 
     RowBox[{"u2", ",", "y", ",", 
      RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"toe", "=", 
     RowBox[{"ToeplitzMatrix", "[", "uacf", "]"}]}], ";", "\n", 
    RowBox[{"invtoe", "=", 
     RowBox[{"Inverse", "[", "toe", "]"}]}], ";", "\n", 
    RowBox[{"hi2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"invtoe", ".", "uyccf"}], ")"}], "/", "\[CapitalDelta]t"}]}], 
    ";"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"U", ",", "S", ",", "V"}], "}"}], "=", 
   RowBox[{"SingularValueDecomposition", "[", 
    RowBox[{"ToeplitzMatrix", "[", "uacf", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"threshold", "=", 
    RowBox[{"0.1", " ", 
     RowBox[{"Max", "[", "S", "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Keep", " ", "only", " ", "significant", " ", "singular", " ", "values"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Sinv", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Max", "[", 
        RowBox[{"#", ",", "threshold"}], "]"}]}], "&"}], "/@", 
     RowBox[{"Diagonal", "[", "S", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hi2", "=", 
    RowBox[{
     FractionBox["1", "\[CapitalDelta]t"], " ", 
     RowBox[{"V", ".", "Sinv", ".", 
      RowBox[{"Transpose", "[", "U", "]"}], ".", "uyccf"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", 
        RowBox[{"hi2", "/", 
         RowBox[{"(", 
          RowBox[{"\[CapitalDelta]\[Tau]", " ", 
           RowBox[{"Total", "[", "hi2", "]"}]}], ")"}]}]}], "}"}], 
      "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<h(\[Tau]) (red) and h2(\[Tau]) (black)\>\""}],
    ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}], "Input",
