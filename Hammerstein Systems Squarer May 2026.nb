Cell["\<\
These are almost exactly the same. So we have identified the parametric \
dynamic linear component of the Hammerstein system.\
\>", "Text",
 CellChangeTimes->{{3.784036488625589*^9, 3.784036523690749*^9}, 
   3.784237804768567*^9},ExpressionUUID->"d6648d0a-101d-4d20-a738-\
5af11c07c3d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parametric static nonlinear element model", "Subsubsection",
 CellChangeTimes->{{3.784034218777731*^9, 
  3.784034229482682*^9}},ExpressionUUID->"1c354061-0aa1-4aba-97e9-\
e6c5b3f4fc4e"],

Cell["\<\
It remains for us to find a parametric model for the static nonlinearity. The \
last estimate of the static nonlinearity was n3. Mathematica provides a \
function called FindFormula[ ] which attempts to discover static models which \
fit a data set. It takes a while because it is trying a huge number of \
candidate models:\
\>", "Text",
 CellChangeTimes->{{3.7840342344678783`*^9, 3.7840343368570766`*^9}, {
  3.7840362349818587`*^9, 3.784036235919504*^9}, {3.784055018079713*^9, 
  3.7840550658984904`*^9}, {3.7840551049070034`*^9, 3.784055107250223*^9}, {
  3.7840552429109883`*^9, 3.784055244145073*^9}, {3.7840557090546618`*^9, 
  3.784055743758587*^9}, {3.784766004765466*^9, 
  3.784766004850024*^9}},ExpressionUUID->"37bcc9e3-192b-4ae6-9b65-\
6611438231e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"fit", "=", 
   RowBox[{"FindFormula", "[", 
    RowBox[{
