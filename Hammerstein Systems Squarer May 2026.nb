Cell[TextData[{
 "This is a remarkable result!! It shows that despite the presence of a major \
static nonlinearity such as a cuber, the stochastic system identification \
techniques were able to nevertheless get an estimate of the Hammerstein \
system\[CloseCurlyQuote]s dynamic linear element. This amazing result (for \
the case of cross-correlation) seems to have been first discovered by Julian \
Bussgang (",
 ButtonBox["https://en.wikipedia.org/wiki/Julian_J._Bussgang",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Julian_J._Bussgang"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Julian_J._Bussgang"],
 ") in 1951 during his Master\[CloseCurlyQuote]s thesis research when he was \
a student at the Research Lab for Electronics (RLE) at MIT (",
 ButtonBox["https://en.wikipedia.org/wiki/Bussgang_theorem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Bussgang_theorem"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Bussgang_theorem"],
 ")."
}], "Text",
 CellChangeTimes->{{3.78371738062884*^9, 3.783717517016073*^9}, {
  3.783717828149418*^9, 3.783717854303652*^9}, {3.783717885186178*^9, 
  3.783717914030853*^9}, {3.783717953336012*^9, 3.783717964170323*^9}, {
  3.7837179962798457`*^9, 3.783718092315293*^9}, {3.7837181431238804`*^9, 
  3.7837181547528276`*^9}, {3.783718188306381*^9, 3.7837182057636027`*^9}, {
  3.783718257333372*^9, 3.783718257786672*^9}, {3.784153716923574*^9, 
  3.784153721549486*^9}},ExpressionUUID->"b570ae78-e83b-4afd-8cee-\
b2b82e9a67ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict output, y1(t)", "Subsubsection",
 CellChangeTimes->{{3.784209109590209*^9, 
  3.7842091161771746`*^9}},ExpressionUUID->"d5ce96bd-3c8b-45b4-9b3e-\
469f0be1c99f"],

Cell["\<\
We can check to see how much of the output variance we can predict simply \
using our estimate of the impulse response function:\
\>", "Text",
 CellChangeTimes->{{3.784209129367504*^9, 
  3.784209166931208*^9}},ExpressionUUID->"a0a6c490-fe7f-4219-b45e-\
d118a89a9448"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"y1", "=", 
   RowBox[{"\[CapitalDelta]t", " ", 
    RowBox[{"ListConvolve", "[", 
     RowBox[{"hi1", ",", "x", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.7839857784000435`*^9, 3.783985788579406*^9}, 
   3.784032228224021*^9, {3.7842093223213587`*^9, 3.784209327822379*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"5ad1ab9a-66ae-4328-8363-8fb4be9fc8c7"],

Cell["Compute the residuals", "Text",
 CellChangeTimes->{{3.784209388873237*^9, 
  3.784209392297161*^9}},ExpressionUUID->"7e552fec-2423-489b-bfe4-\
c7af8bde866b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"r1", "=", 
   RowBox[{"y", "-", "y1"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "r1"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
