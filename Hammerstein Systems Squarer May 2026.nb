Cell[TextData[{
 "This model is almost exactly the same static nonlinearity as used in our \
simulation u = 0.1 x + 0.2 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "e7c7eebe-4a51-4d0e-8301-7ce0211f7fcb"],
 " ."
}], "Text",
 CellChangeTimes->{{3.784736415674815*^9, 3.784736437812084*^9}, 
   3.784736535139711*^9, {3.784766299445659*^9, 3.784766311964105*^9}, {
   3.784766387454429*^9, 3.784766445880929*^9}, {3.797247055046026*^9, 
   3.797247055174449*^9}},ExpressionUUID->"c63c3dde-9787-488b-b552-\
1c87ef8428c0"],

Cell["\<\
In conclusion we have managed to identify both the static nonlinear part and \
the linear dynamic part of the the Hammerstein system. 
The Hammerstein system has been identified!!

\
\>", "Text",
 CellChangeTimes->{{3.7840354531093245`*^9, 3.7840355424065657`*^9}, {
  3.7840363404367247`*^9, 3.784036383543155*^9}, {3.7840365500870476`*^9, 
