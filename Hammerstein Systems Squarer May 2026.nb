  3.7847678214613876`*^9}},ExpressionUUID->"38542b22-3624-499f-9019-\
aa7f5959938e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-predict internal signal, u4(t)", "Subsubsection",
 CellChangeTimes->{{3.784208662608498*^9, 3.784208694179376*^9}, {
  3.78423053058263*^9, 
  3.784230530692018*^9}},ExpressionUUID->"deea6eea-db91-444b-a52f-\
6b26fa3ddc11"],

Cell["\<\
Now that we have the estimate, n2(\[CenterDot]), we can transform the input, \
x(t), through it to re-predict the internal signal, u4(t):\
\>", "Text",
 CellChangeTimes->{{3.783767802005376*^9, 3.783767885369144*^9}, {
  3.7842085617747235`*^9, 3.784208589800835*^9}, {3.784208700540358*^9, 
  3.7842087348284736`*^9}, {3.784230680958496*^9, 3.784230681112763*^9}, {
  3.78423203994387*^9, 
  3.784232040053195*^9}},ExpressionUUID->"d7eaf194-ac32-4a3b-b8f0-\
366b084103dc"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"u4", "=", 
   RowBox[{"n2", "[", "x", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.783887699051352*^9, 3.783887704474195*^9}, {
  3.783887739054116*^9, 3.783887745808686*^9}, {3.7838905655500593`*^9, 
  3.783890573574683*^9}, {3.783892258186321*^9, 3.7838922583421936`*^9}, {
  3.7838923249870996`*^9, 3.7838923372173977`*^9}, {3.7839510943437185`*^9, 
  3.783951100470212*^9}, {3.784031605179668*^9, 3.78403160655725*^9}, {
  3.7840525943965287`*^9, 3.784052605447194*^9}, {3.784052713661232*^9, 
  3.7840527315092754`*^9}, {3.784208598659933*^9, 3.784208634939222*^9}, {
  3.784209033739248*^9, 3.784209035196647*^9}, {3.7842305363648605`*^9, 
  3.7842305403816013`*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"c2a49f79-7b44-4756-993c-dd35f1bb06b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-estimate the impulse response function", "Subsubsection",
 CellChangeTimes->{{3.7842087468982315`*^9, 
  3.784208760280585*^9}},ExpressionUUID->"779beaf1-2cf5-4430-a3a7-\
9d0675eba00e"],

Cell["\<\
Now that we have a new prediction of the internal signal, u4(t), we can \
re-estimate the impulse response function but now between u4(t) and y(t):\
\>", "Text",
 CellChangeTimes->{{3.7842087665781813`*^9, 3.784208817809159*^9}, {
  3.784230640803034*^9, 
  3.784230644366678*^9}},ExpressionUUID->"be25e27a-f226-4b6a-90d5-\
960331e78916"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"uacf", "=", 
   RowBox[{"cor", "[", 
    RowBox[{"u4", ",", "u4", ",", 
     RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uyccf", "=", 
    RowBox[{"cor", "[", 
     RowBox[{"u4", ",", "y", ",", 
      RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"toe", "=", 
     RowBox[{"ToeplitzMatrix", "[", "uacf", "]"}]}], ";", "\n", 
    RowBox[{"invtoe", "=", 
     RowBox[{"Inverse", "[", "toe", "]"}]}], ";", "\n", 
    RowBox[{"hi3", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"invtoe", ".", "uyccf"}], ")"}], "/", "\[CapitalDelta]t"}]}], 
    ";"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"U", ",", "S", ",", "V"}], "}"}], "=", 
   RowBox[{"SingularValueDecomposition", "[", 
    RowBox[{"ToeplitzMatrix", "[", "uacf", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"threshold", "=", 
    RowBox[{"0.1", " ", 
     RowBox[{"Max", "[", "S", "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Keep", " ", "only", " ", "significant", " ", "singular", " ", "values"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Sinv", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Max", "[", 
        RowBox[{"#", ",", "threshold"}], "]"}]}], "&"}], "/@", 
     RowBox[{"Diagonal", "[", "S", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hi3", "=", 
    RowBox[{
     FractionBox["1", "\[CapitalDelta]t"], " ", 
     RowBox[{"V", ".", "Sinv", ".", 
      RowBox[{"Transpose", "[", "U", "]"}], ".", "uyccf"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi3"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<h(\[Tau]) (red) and h2(\[Tau]) (black)\>\""}],
    ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.783714401465455*^9, 3.783714418475966*^9}, {
  3.783714460951434*^9, 3.78371446133645*^9}, {3.783714770898028*^9, 
  3.783714771006693*^9}, {3.783715145543625*^9, 3.783715153668929*^9}, {
  3.783767191643694*^9, 3.783767225811871*^9}, {3.783878756768091*^9, 
  3.783878781446751*^9}, {3.783882071443536*^9, 3.783882090594508*^9}, {
