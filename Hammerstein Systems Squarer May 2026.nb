         RowBox[{"\"\<x amplitude\>\"", ",", "\"\<u4 amplitude\>\""}], 
         "}"}]}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
       RowBox[{
       "PlotLabel", 
        "\[Rule]", "\"\<x(t) vs u4(t) (black dots) and n (blue) and n3 \
(red)\>\""}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "[", "xx", "]"}], ",", 
         RowBox[{"n3", "[", "xx", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xx", ",", 
         RowBox[{"-", "7"}], ",", "7"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
