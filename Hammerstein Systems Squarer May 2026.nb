 StyleBox[
  RowBox[{
   RowBox[{"Lets", " ", "make", " ", "the", " ", "static", " ", "gain"}], ",",
    " ", 
   RowBox[{"\[Alpha]", " ", "=", " ", "1"}], ",", " ", 
   RowBox[{"the", "  ", "natural", " ", "frequency"}], ",", " ", 
   RowBox[{"\[Omega]", " ", "=", " ", 
    RowBox[{"60", "  ", 
