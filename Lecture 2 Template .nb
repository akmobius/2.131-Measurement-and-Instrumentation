  3.947790778668082*^9}},ExpressionUUID->"291a69ea-3722-493e-b2a6-\
fa445bac124b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0.0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "/", "3"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "note", " ", "that", " ", "the", " ", "number", " ", "of", " ", "x", " ", 
    "values", " ", "is", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "-", "1"}], ")"}], "/", "3"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
