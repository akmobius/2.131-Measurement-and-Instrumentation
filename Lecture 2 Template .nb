Cell[CellGroupData[{

Cell["Generate Time Axis", "Subsubsection",
 CellChangeTimes->{{3.947844976002963*^9, 
  3.947844980895721*^9}},ExpressionUUID->"2f360a84-2f6a-48e7-b437-\
c4210f3c2bcb"],

Cell["\<\
We sampled every 10 ms (100 Hz sampling rate). So lets define the sampling \
increment as:\
\>", "Text",
 CellChangeTimes->{{3.947844941859621*^9, 3.947845037807208*^9}, {
  3.9478451356222067`*^9, 
  3.9478451689571238`*^9}},ExpressionUUID->"f424987c-77f4-44de-a213-\
b717260554ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]t", "=", "0.01"}], ";"}]], "Input",
 CellChangeTimes->{{3.947845187173456*^9, 3.9478451958231792`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"7b3139bc-c0ae-4551-a414-f00e0c4902de"],

Cell["So we can generate a signal, t, representing the time:", "Text",
 CellChangeTimes->{{3.947844941859621*^9, 3.947845037807208*^9}, 
   3.9478451356222067`*^9},ExpressionUUID->"8c79728d-160c-4469-a7b5-\
564ef920a3c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"\[CapitalDelta]t", ",", 
     RowBox[{"\[CapitalDelta]t", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "/", "3"}]}], ",", 
     "\[CapitalDelta]t"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.947845043097204*^9, 3.947845113858899*^9}, {
   3.947845206556162*^9, 3.947845222024351*^9}, {3.947845285808522*^9, 
   3.947845293890532*^9}, 3.947845444047997*^9},
 CellLabel->"In[56]:=",ExpressionUUID->"52a77b3d-2f6a-4c4b-91e1-15bbdc43f118"],

Cell["Check that t and z  have the same lengths:", "Text",
 CellChangeTimes->{{3.947845466466432*^9, 
  3.947845486141135*^9}},ExpressionUUID->"39d3ffe4-8062-46bd-9cf6-\
3c29463db9aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "t", "]"}]], "Input",
 CellChangeTimes->{{3.947845420423647*^9, 3.947845424028664*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"f0ed989d-3d66-4a5c-a16c-6ebc511ec87b"],

