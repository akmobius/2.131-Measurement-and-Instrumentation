 CellChangeTimes->{{3.9478453082813187`*^9, 
  3.9478453379651747`*^9}},ExpressionUUID->"c59acb97-fae6-4f4c-b94b-\
da94eea7d4fb"],

Cell["Note that we have to transpose {t,z}:", "Text",
 CellChangeTimes->{{3.947845601044903*^9, 3.947845619409666*^9}, {
  3.979299504991609*^9, 
  3.9792995105332193`*^9}},ExpressionUUID->"3bb6bf4a-d135-4ec2-97c5-\
9fdfab8ec571"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"t", ",", "z"}], "}"}], "]"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   
   RowBox[{"PlotStyle", "->", 
