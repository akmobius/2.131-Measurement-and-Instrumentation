Cell[TextData[{
 "Note that if you hold the accelerometer horizontal, the mean value of the z \
axis acceleration will be the measured acceleration of gravity (i.e., around \
9.8 m/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "267d0691-d280-4d3b-b638-e1c376d39c2f"],
