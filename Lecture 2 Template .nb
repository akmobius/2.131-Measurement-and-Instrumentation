Cell[CellGroupData[{

Cell[TextData[{
 "Extract the x, y and z accelerations (and convert to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "/", 
    SuperscriptBox["s", "2"]}], TraditionalForm]],ExpressionUUID->
  "0b9c6522-b6c1-40f1-ab3c-f6ba0b6be3b2"],
 ")"
}], "Subsubsection",
