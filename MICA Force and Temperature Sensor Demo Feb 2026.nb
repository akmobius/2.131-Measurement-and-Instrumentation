 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Min", "[", "timeInc", "]"}], ",", 
    RowBox[{"Max", "[", "timeInc", "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9489663198560743`*^9, 3.948966322583181*^9}, {
   3.948966362195052*^9, 3.948966409359888*^9}, 3.948978938330811*^9},
