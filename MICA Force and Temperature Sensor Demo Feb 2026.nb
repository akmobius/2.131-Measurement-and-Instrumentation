Cell["The standard deviation of the jitter is:", "Text",
 CellChangeTimes->{{3.948966614564995*^9, 
  3.948966626589945*^9}},ExpressionUUID->"aa351e5c-d975-42ae-9283-\
40bad1783e4f"],

