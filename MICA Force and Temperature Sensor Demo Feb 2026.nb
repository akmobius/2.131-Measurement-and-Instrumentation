Cell[CellGroupData[{

Cell["Determination of Temperature Resolution", "Subsubsection",
 CellChangeTimes->{{3.980348000785084*^9, 3.9803480167932777`*^9}, {
  3.980357060208048*^9, 
  3.980357062029375*^9}},ExpressionUUID->"daa54e77-3559-4604-b7ad-\
343fdfef703d"],

Cell["\<\
We can ask if it is possible to determine the resolution of the temperature \
measurements from the data. Lets give this a try on the detrended temperature \
data (we could have used the original temperature measurements also, it \
should make no difference). We start by plotting the detrended temperature \
measurements as points and zoom in around 0.0:\
\>", "Text",
 CellChangeTimes->{{3.980348022857361*^9, 3.980348077465535*^9}, {
  3.98034816837838*^9, 3.980348216082437*^9}, {3.98034867190051*^9, 
  3.9803486733795967`*^9}, {3.980348821444276*^9, 3.980348877875886*^9}, {
  3.980357280050132*^9, 
  3.980357309839217*^9}},ExpressionUUID->"fe8c5798-1baf-4692-b622-\
2164e25541f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"time1", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"n", "-", "1"}]}], "]"}], "]"}], ",", 
       "temperature1\[CapitalDelta]"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.05"}], ",", "0.05"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"PlotStyle", "->", "Red"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Time (s)\>\"", ",", 
       " ", "\"\<Detrended Temperature (\[Degree]C)\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<Detrended Temperature vs Time\>\""}],
     ",", 
    RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]], "Input",
