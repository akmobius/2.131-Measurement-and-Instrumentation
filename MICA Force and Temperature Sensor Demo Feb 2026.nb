  Ticks->{Automatic, Automatic}]], "Output",
 CellChangeTimes->{
  3.980348151549971*^9, 3.980348251195898*^9, {3.9803486927040577`*^9, 
   3.980348703472308*^9}, 3.980348746322515*^9, 3.980348809724153*^9, 
   3.980354377998494*^9, 3.980355354734293*^9, 3.980357321065938*^9, {
   3.9803573634403687`*^9, 3.980357384106118*^9}, 3.980357480776676*^9, 
   3.9815561284104595`*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"fd2066e9-6f17-fd45-87bf-effd35cf8bcc"]
}, Open  ]],

Cell["\<\
It is clear that the minimum separation between these rows is 0.01 \[Degree]C\
\
\>", "Text",
 CellChangeTimes->{{3.980355551491413*^9, 3.980355566467164*^9}, {
   3.9803557062434893`*^9, 3.980355708379087*^9}, {3.980357396312086*^9, 
   3.980357438929922*^9}, 
   3.9803574884542*^9},ExpressionUUID->"339dd1e6-15b7-4cac-a196-f147b7935d2f"],

Cell["\<\
These rows of data points correspond to the smallest values resolvable by the \
thermocouple sensor ADC. 
We want an algorithm to find the minimum temperature difference (or increment).

We can use the DeleteDuplicates[] function to find all the distinctly \
different temperature (we will just plot a 10 of them):\
\>", "Text",
 CellChangeTimes->{{3.948993044774356*^9, 3.948993152697555*^9}, {
  3.948994354953776*^9, 3.948994470564077*^9}, {3.948994528734796*^9, 
  3.94899458890164*^9}, {3.9489968030106277`*^9, 3.94899681031533*^9}, {
  3.9494171593106117`*^9, 3.949417169809305*^9}, {3.980338502557172*^9, 
  3.98033858200224*^9}, {3.980338630018688*^9, 3.980338636135201*^9}, {
  3.980338719378297*^9, 3.980338726531027*^9}, {3.980339582477255*^9, 
  3.9803396238088217`*^9}, {3.980339912686961*^9, 3.98033997108504*^9}, {
  3.980348366521703*^9, 3.980348395802401*^9}, {3.9803484694185963`*^9, 
  3.980348477422607*^9}, {3.980348515034801*^9, 3.980348531611492*^9}, {
  3.98034889342832*^9, 3.980348894016472*^9}, {3.980357517158832*^9, 
  3.980357547354885*^9}},ExpressionUUID->"89e58fa9-eec4-457b-b77b-\
c69fb4926593"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"temp1", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"temperature1\[CapitalDelta]", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#1", "-", "#2"}], "]"}], "<=", "0.00001"}], "&"}]}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.980339173661209*^9, 3.980339187388709*^9}, {
   3.980339283117569*^9, 3.980339285668461*^9}, 3.9803397175197687`*^9, {
   3.9803484024985523`*^9, 3.980348436099564*^9}, {3.98034853488579*^9, 
   3.980348554620275*^9}, {3.980348615105774*^9, 3.980348638076438*^9}, 
   3.9803489462619343`*^9, 3.980349775517536*^9, {3.9803513247880793`*^9, 
   3.980351326093902*^9}, 3.980354397593916*^9, 3.9803553755158863`*^9, {
   3.980355971023637*^9, 3.980355972348749*^9}, {3.9803575540921307`*^9, 
   3.980357578243278*^9}, 3.980357613260165*^9},
 CellLabel->"In[101]:=",
 CellID->1576782429,ExpressionUUID->"9e4451e1-f84e-4ba9-8a60-879f7b76a79e"],

Cell["\<\
Note that we specified that any temperature that were within 0.00001 \
\[Degree]C (i.e. 100 \[Mu]\[Degree]C) are treated as being equal.\
\>", "Text",
 CellChangeTimes->{{3.980339640956917*^9, 3.980339714731452*^9}, {
  3.9803485690993547`*^9, 3.980348607183464*^9}, {3.9803489355804853`*^9, 
  3.980348973923132*^9}, {3.980349205194228*^9, 3.980349205272397*^9}, {
  3.9803553891753807`*^9, 3.980355397089734*^9}, {3.980357584755934*^9, 
  3.980357599738879*^9}, {3.98035763757185*^9, 
  3.980357661780951*^9}},ExpressionUUID->"ba115106-15e5-475d-983a-\
6862d1de773b"],

Cell["We can now sort these:", "Text",
 CellChangeTimes->{{3.980339742990293*^9, 
  3.980339748085003*^9}},ExpressionUUID->"f04a8437-46e8-4fb1-be97-\
cde204fe5cfd"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"temp1Sorted", "=", 
   RowBox[{"Sort", "[", "temp1", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.980339173661209*^9, 3.980339187388709*^9}, {
   3.9803392410899563`*^9, 3.980339245501493*^9}, {3.980339294926256*^9, 
   3.9803393190921593`*^9}, {3.980348988604357*^9, 3.980348998138669*^9}, {
   3.9803497789568777`*^9, 3.980349780270273*^9}, {3.980351329283766*^9, 
   3.980351330469343*^9}, 3.980354400226267*^9, 3.9803560004208937`*^9, {
   3.9803576799040327`*^9, 3.980357686156405*^9}},
 CellLabel->"In[102]:=",
 CellID->1034080223,ExpressionUUID->"a7cc5aa4-3ab0-4d4f-9a18-123a9a7e871c"],

Cell["and determine the differences between these sorted forces:", "Text",
 CellChangeTimes->{{3.9803397617026033`*^9, 3.98033978646708*^9}, {
  3.980349027828418*^9, 
  3.980349028707106*^9}},ExpressionUUID->"e7cae682-8335-4c0f-a271-\
5b71a1903df6"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Differences", "[", "temp1Sorted", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.980339484008354*^9, 3.980339502019651*^9}, {
   3.980349033293486*^9, 3.980349034976366*^9}, 3.98034978313349*^9, 
   3.980351333339479*^9, 3.980354403114691*^9, 3.980356190695611*^9, 
   3.9803576914720182`*^9},
 CellLabel->
  "In[103]:=",ExpressionUUID->"8d80757d-c6b7-4c5f-815b-488240e8e1d6"],

Cell["\<\
The minimum temperature increment in \[Degree]C will then be given by:\
\>", "Text",
 CellChangeTimes->{{3.9803397954301443`*^9, 3.980339818563919*^9}, {
  3.980355777339142*^9, 3.980355796658477*^9}, {3.980357738385558*^9, 
  3.980357742384369*^9}},ExpressionUUID->"8e455542-f719-4196-a89f-\
6503c3a7a1d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"\[CapitalDelta]temp1", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"Differences", "[", "temp1Sorted", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98033953292771*^9, 3.980339550391551*^9}, {
   3.9803490471974907`*^9, 3.980349065236726*^9}, {3.980349785607449*^9, 
   3.980349787101989*^9}, {3.980351334779339*^9, 3.980351335925708*^9}, 
   3.980354418241456*^9, {3.980355814169957*^9, 3.980355815980793*^9}, {
   3.980357695617157*^9, 3.980357727866564*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"c09c1340-d7b1-4012-b8d4-4ca34c2b00b6"],

Cell[BoxData["0.00999999999999801`"], "Output",
 CellChangeTimes->{3.9803395535980263`*^9, 3.980349067359614*^9, 
  3.980354419211776*^9, 3.980355408434154*^9, 3.980355764983604*^9, 
  3.980355819139291*^9, 3.980356081317699*^9, 3.980356203095096*^9, 
  3.9803577116791058`*^9, 3.980357745953929*^9, 3.9815561413541164`*^9},
 CellLabel->
  "Out[104]=",ExpressionUUID->"2615441a-08b2-bf44-a966-2e5e2390ee1f"]
}, Open  ]],

Cell["\<\
So we have just experimentally determined the minimum temperature increment \
(otherwise known as the temperature resolution) as 0.01 \[SmallCircle]C. This \
corresponds to the published spec of the thermocouple chip used in the \
TinkerForge temperature bricklet.\
\>", "Text",
 CellChangeTimes->{{3.948994603208048*^9, 3.948994665481845*^9}, {
  3.980339846486608*^9, 
  3.980339893702647*^9}},ExpressionUUID->"497ac254-4756-4370-8bc8-\
c9c2b995fc5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Temperature Probability Density", "Subsubsection",
 CellChangeTimes->{{3.948978547959515*^9, 3.948978561536441*^9}, {
  3.949052869303347*^9, 3.9490528794452467`*^9}, {3.980340084561425*^9, 
  3.9803400881435947`*^9}, {3.9803407172685747`*^9, 
  3.980340718100559*^9}},ExpressionUUID->"633427eb-e793-4dba-86c8-\
e097868031fd"],

Cell["Lets look at the detrended temperature probability density:", "Text",
 CellChangeTimes->{{3.980340736659789*^9, 
  3.980340754476304*^9}},ExpressionUUID->"6041d380-9208-41f5-9652-\
ff49fa2d4543"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SmoothHistogram", "[", 
     RowBox[{
     "temperature1\[CapitalDelta]", ",", "Automatic", ",", "\"\<PDF\>\"", ",", 
      RowBox[{"Filling", "\[Rule]", "Axis"}], ",", 
      RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Detrended Temperature (\[Degree]C)\>\"", 
         ",", "\"\<Probability\>\""}], "}"}]}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "\[Rule]", "\"\<Detrended Temperature Probability Density\>\""}], ",", 
      
      RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "temperature1SD"}], "]"}], ",", "x"}], "]"}], ",", 
      
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"-", "4"}], " ", "temperature1SD"}], ",", 
        RowBox[{"4", " ", "temperature1SD"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}]], "Input",
