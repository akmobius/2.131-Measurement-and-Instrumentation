Cell["\<\
If you see large spikes in this plot then it was probably because the force \
sensor picked up some movement in the room (e.g., table vibration cause by a \
bump). It is best to rerun the experiment if this is evident.
We can see that there is a small drift in the force signal (your data may or \
may not show this).\
\>", "Text",
 CellChangeTimes->{{3.948991886905773*^9, 3.948991964037772*^9}, {
  3.980358733085703*^9, 
  3.9803588503187113`*^9}},ExpressionUUID->"68083442-bf2c-4fde-afb1-\
e947f0d2bb53"],

Cell["We take successive differences between adjacent data points:", "Text",
 CellChangeTimes->{{3.94905384641578*^9, 3.949053954075554*^9}, {
  3.94905423207335*^9, 3.9490542441968393`*^9}, {3.9803509638656054`*^9, 
  3.9803509650599737`*^9}},ExpressionUUID->"9c442ca9-df42-4a92-8cd0-\
ad0cb0b12275"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"force2\[CapitalDelta]", "=", 
   RowBox[{"Differences", "[", "force2", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.949054247552455*^9, 3.949054281856255*^9}, {
   3.949054534145713*^9, 3.94905454754548*^9}, 3.949416944645348*^9, {
   3.980351450612494*^9, 3.980351452611533*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"4d1d4283-c395-48e1-ba2d-6b32bd8011fd"],

Cell["\<\
Note that the length of the force\[CapitalDelta] signal will be n-1. Lets \
plot the linearly detrended signal:\
\>", "Text",
 CellChangeTimes->{{3.9490543291569357`*^9, 3.94905442230484*^9}, {
  3.949054569146193*^9, 
  3.949054618247246*^9}},ExpressionUUID->"1474ef21-86a1-4153-8bb1-\
a32cd74ecb43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"time2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"n", "-", "1"}]}], "]"}], "]"}], ",", 
       "force2\[CapitalDelta]"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotStyle", "->", "Blue"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Time (s)\>\"", ",", " ", "\"\<Detrended Force (N)\>\""}], 
      "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<Detrended Force vs Time\>\""}], ",", 
    
    RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9354985199498987`*^9, 3.935498553981361*^9}, {
   3.9355091083120413`*^9, 3.9355091686937847`*^9}, 3.938165175931233*^9, {
