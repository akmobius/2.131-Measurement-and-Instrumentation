Cell[CellGroupData[{

Cell["Polling Code", "Subsubsection",
 CellChangeTimes->{{3.9360289136682034`*^9, 
  3.9360289222311163`*^9}},ExpressionUUID->"15c5aa59-898d-408a-a919-\
cf62deec4d5f"],

Cell["\<\
We could use Pause[] to specify the time between samples in a loop but this \
is not accurate and always results in times between samples  that are larger \
than the Pause[] time. A better approach is  to use a method called polling \
where we wait for a specified time as specified by a computer absolute timer \
and then take a measurement. Lets  look at how this works when we desire an \
increment of 1 s \
\>", "Text",
 CellChangeTimes->{{3.936028927687533*^9, 3.936029054558606*^9}, {
  3.936029110118868*^9, 3.936029114134903*^9}, {3.93602926926226*^9, 
  3.93602944842916*^9}, {3.936030041383251*^9, 3.936030044430253*^9}, {
  3.948914436016197*^9, 
  3.9489144361233997`*^9}},ExpressionUUID->"14b5b515-1409-4420-8661-\
f63cbbf83390"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"\[Delta]t", "=", "1.0"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"desired", " ", "inter"}], "-", 
    RowBox[{"sample", " ", "interval", " ", "in", " ", "s"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}], ")"}], "<", " ", 
    "\[Delta]t"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}]}], "Input",
 CellChangeTimes->{{3.936029080720674*^9, 3.936029082023897*^9}, {
   3.93602919781686*^9, 3.936029254951956*^9}, 3.936029471708973*^9, {
   3.948914430822466*^9, 3.948914430885374*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"215ef834-3806-4e39-9df7-a7cf40168550"],

Cell[BoxData["1.0091581`7.45550420391409"], "Output",
 CellChangeTimes->{{3.936029244120922*^9, 3.936029262502549*^9}, {
   3.936029478557056*^9, 3.9360294849068403`*^9}, 3.938164707304315*^9, 
   3.938172447122467*^9, 3.948914375558289*^9, 3.948914441757102*^9, 
   3.948965077311685*^9, 3.9490531901799793`*^9, 3.949065270686631*^9, 
   3.9494165327809753`*^9, 3.980337882594125*^9, 3.980350150123122*^9, 
   3.980351563036458*^9, 3.980355032632813*^9, 3.9815553535502872`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"01b9ed06-ab4b-c54f-9f9c-5b0015132deb"]
}, Open  ]],

Cell["Try running this a few times. ", "Text",
 CellChangeTimes->{{3.936029491813108*^9, 
  3.936029522388377*^9}},ExpressionUUID->"e4c197af-c92b-483b-b31d-\
37a25ab8906f"],

Cell["\<\
This approach allows us to do many things between successive samples. In the \
following code we record how many times the While[] function is evaluated, n, \
while its waits for the AbsoluteTime to advance by 1 s:\
\>", "Text",
 CellChangeTimes->{{3.936029535963846*^9, 3.936029603164525*^9}, 
   3.9360296672020683`*^9, {3.9360300018627663`*^9, 3.936030020702507*^9}, {
   3.9360302155983343`*^9, 3.936030219397724*^9}, {3.948914449786992*^9, 
   3.9489144498606567`*^9}},ExpressionUUID->"febabd33-a264-4a49-a3d4-\
38c65a2e6a98"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"\[Delta]t", "=", "1.0"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"desired", " ", "inter"}], "-", 
    RowBox[{"sample", " ", "interval", " ", "in", " ", "s"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}], ")"}], "<", " ", 
     "\[Delta]t"}], ",", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"n", "+", "1"}]}], ";", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{"a", "*", "1.0001"}], "-", "0.00001"}]}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"3", " ", "n"}], ",", 
   RowBox[{
    RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.936029080720674*^9, 3.936029082023897*^9}, {
   3.93602919781686*^9, 3.936029254951956*^9}, 3.936029471708973*^9, {
   3.936029621686252*^9, 3.9360296552524157`*^9}, {3.9360297218446217`*^9, 
   3.936029780104561*^9}, {3.936029886658166*^9, 3.936029886919606*^9}, {
   3.936030225232595*^9, 3.936030237894002*^9}, {3.9489144534194603`*^9, 
   3.9489144535087547`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"3eda9c8d-5937-496b-8946-0a970c86ff6f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"599718", ",", "1.0070104`7.454578949292179"}], "}"}]], "Output",
 CellChangeTimes->{3.9360296769923687`*^9, 3.936029786628057*^9, 
  3.93602989486732*^9, 3.9360299378939657`*^9, 3.936030032516317*^9, 
  3.936030278353874*^9, 3.9381647184371862`*^9, 3.9381724735387487`*^9, 
  3.948914396547134*^9, 3.948914457609055*^9, 3.9489650804118757`*^9, 
  3.949053193931158*^9, 3.949065286252687*^9, 3.9494165364658947`*^9, 
  3.98033789893047*^9, 3.980350155163615*^9, 3.980351565876459*^9, 
  3.980355035669116*^9, 3.981555356448641*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"3e2f0d0e-5e09-6341-876a-26bcecb7b12d"]
}, Open  ]],

Cell["\<\
Here we can see that in the time interval (1 s in this case) we did around 3 \
n = 1.5 million (it will be different on different computers, the higher the \
number the faster your computer) floating point operations (addition, \
multiplication and subtraction) while we waited for the AbsoluteTime to \
advance by 1 s.\
\>", "Text",
 CellChangeTimes->{{3.936029686440551*^9, 3.936029710152323*^9}, {
  3.936029793576713*^9, 3.93602986734339*^9}, {3.93602989963974*^9, 
  3.936029984966786*^9}, {3.936030263942176*^9, 3.9360302667331*^9}, {
  3.948914469964645*^9, 3.948914521804627*^9}, {3.980337925806692*^9, 
  3.980337937656048*^9}},ExpressionUUID->"dba6e8fd-770c-4d4f-a44a-\
194d51c1da77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Experiment 1: Measure Force (with no load) and Temperature for 200 s\
\>", "Subsubsection",
 CellChangeTimes->{{3.929519553773741*^9, 3.92951955694901*^9}, {
  3.9295552329155684`*^9, 3.929555247083957*^9}, {3.930405026450638*^9, 
  3.930405027836367*^9}, {3.930419321483077*^9, 3.930419325562687*^9}, {
  3.930732356861523*^9, 3.930732361839879*^9}, {3.931023608506188*^9, 
  3.931023610074182*^9}, {3.933681591852901*^9, 3.933681596548376*^9}, {
  3.9338732128025703`*^9, 3.9338732278416777`*^9}, {3.934823968366857*^9, 
  3.934823981797825*^9}, {3.935432666512534*^9, 3.935432687662548*^9}, {
  3.948914597551108*^9, 3.948914613123097*^9}, {3.948979198819291*^9, 
  3.948979228097969*^9}},ExpressionUUID->"5ad87e11-6eae-43fc-a7a8-\
cabfb47e3c26"],

Cell["\<\
We set TinkerForge Load Cell Bricklet to have an internal sampling rate of 80 \
Hz. To avoid the possibility of reading the same sample more than once we \
need to read the Load Cell Bricklet at less than this value. So in the \
following experiment we will sample it and the thermocouple at 50 Hz (i.e., \
once every 20 ms). We will collect 10,000 samples per signal. 10,000 samples \
x 0.02 s = 200 s experimental duration. We will use polling as outlined \
above. You should avoid bumping the setup while running the experiment:\
\>", "Text",
 CellChangeTimes->{{3.935488540441543*^9, 3.935488704866056*^9}, {
   3.935506641830635*^9, 3.935506693005168*^9}, {3.9355068014618196`*^9, 
   3.935506865676689*^9}, {3.948914619421755*^9, 3.94891471732333*^9}, {
   3.9489153590701113`*^9, 3.9489154513825293`*^9}, {3.948965152190868*^9, 
   3.948965257073736*^9}, {3.948965297332521*^9, 3.948965334713448*^9}, 
   3.949415950583205*^9, 
   3.980350279085005*^9},ExpressionUUID->"9c46a111-e0d6-4b9f-8fa0-\
1b992799298a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"time1", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"temperature1", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", "n"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"in", " ", "oC"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"force1", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", "n"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"in", " ", "Newtons"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]t", "=", "0.02"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"desired", " ", "inter"}], "-", 
    RowBox[{"sample", " ", "interval", " ", "in", " ", "s"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}], ")"}], "<", " ", 
      RowBox[{"\[Delta]t", 
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"time1", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}]}], ";", " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"temperature1", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{"tc", "@", 
       RowBox[{"GetTemperature", "[", "]"}]}], "/", "100.0"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"force1", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "=", 
     RowBox[{"9.81", " ", 
      FractionBox[
       RowBox[{"lc", "@", 
        RowBox[{"GetWeight", "[", "]"}]}], "10000000"]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"i", ",", "1000"}], "]"}], "==", "0"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "print", " ", "out", " ", "every", " ", "1000", "th", " ", "sample", " ",
         "index"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "i", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "Input",
