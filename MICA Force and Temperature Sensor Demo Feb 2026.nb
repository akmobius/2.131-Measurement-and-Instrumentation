Cell["\<\
It certainly looks as though we have distinct rows of measurements separated \
by some increment that looks to be around 10 \[Mu]N. There is also some small \
fluctuations that can be seen in the values in each row.\
\>", "Text",
 CellChangeTimes->{{3.980348266226177*^9, 3.980348314090118*^9}, {
  3.980355521603623*^9, 3.980355535931004*^9}, {3.980355729643733*^9, 
  3.980355735930264*^9}, {3.980356670062929*^9, 
  3.980356710679254*^9}},ExpressionUUID->"fdf0b0ae-874e-47bb-a796-\
a5b27d338922"],

Cell["\<\
These rows of data points correspond to the smallest values resolvable by the \
force sensor ADC. 
We want an algorithm to find the minimum force difference (or increment).

We can use the DeleteDuplicates[] function to find all the distinctly \
different forces (we will just plot a 10 of them):\
\>", "Text",
 CellChangeTimes->{{3.948993044774356*^9, 3.948993152697555*^9}, {
  3.948994354953776*^9, 3.948994470564077*^9}, {3.948994528734796*^9, 
  3.94899458890164*^9}, {3.9489968030106277`*^9, 3.94899681031533*^9}, {
  3.9494171593106117`*^9, 3.949417169809305*^9}, {3.980338502557172*^9, 
  3.98033858200224*^9}, {3.980338630018688*^9, 3.980338636135201*^9}, {
  3.980338719378297*^9, 3.980338726531027*^9}, {3.980339582477255*^9, 
  3.9803396238088217`*^9}, {3.980339912686961*^9, 3.98033997108504*^9}, {
  3.980348366521703*^9, 3.980348395802401*^9}, {3.9803484694185963`*^9, 
  3.980348477422607*^9}, {3.980348515034801*^9, 3.980348531611492*^9}, {
  3.98034889342832*^9, 
  3.980348894016472*^9}},ExpressionUUID->"e4e46a3d-7df8-41e1-88e4-\
6ef8cbe88a37"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"for1", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"force1\[CapitalDelta]", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#1", "-", "#2"}], "]"}], "<=", "0.0000001"}], "&"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.980339173661209*^9, 3.980339187388709*^9}, {
   3.980339283117569*^9, 3.980339285668461*^9}, 3.9803397175197687`*^9, {
   3.9803484024985523`*^9, 3.980348436099564*^9}, {3.98034853488579*^9, 
   3.980348554620275*^9}, {3.980348615105774*^9, 3.980348638076438*^9}, 
   3.9803489462619343`*^9, 3.980349775517536*^9, {3.9803513247880793`*^9, 
   3.980351326093902*^9}, 3.980354397593916*^9, 3.9803553755158863`*^9, {
   3.980355971023637*^9, 3.980355972348749*^9}},
 CellLabel->"In[90]:=",
 CellID->762819992,ExpressionUUID->"a26bd984-2746-4f5e-9d06-01325dc16ce0"],

Cell["\<\
Note that we specified that any force that were within 0.0000001 N (i.e. 100 \
nN) are treated as being equal.\
\>", "Text",
 CellChangeTimes->{{3.980339640956917*^9, 3.980339714731452*^9}, {
  3.9803485690993547`*^9, 3.980348607183464*^9}, {3.9803489355804853`*^9, 
  3.980348973923132*^9}, {3.980349205194228*^9, 3.980349205272397*^9}, {
  3.9803553891753807`*^9, 
  3.980355397089734*^9}},ExpressionUUID->"3220003c-8b33-4ddd-80e3-\
1139d907881a"],

Cell["We can now sort these:", "Text",
 CellChangeTimes->{{3.980339742990293*^9, 
  3.980339748085003*^9}},ExpressionUUID->"10d6139f-b83b-4156-8d5c-\
c3aeb5d33c5e"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"for1Sorted", "=", 
   RowBox[{"Sort", "[", "for1", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.980339173661209*^9, 3.980339187388709*^9}, {
   3.9803392410899563`*^9, 3.980339245501493*^9}, {3.980339294926256*^9, 
   3.9803393190921593`*^9}, {3.980348988604357*^9, 3.980348998138669*^9}, {
   3.9803497789568777`*^9, 3.980349780270273*^9}, {3.980351329283766*^9, 
   3.980351330469343*^9}, 3.980354400226267*^9, 3.9803560004208937`*^9},
 CellLabel->"In[91]:=",
 CellID->238232954,ExpressionUUID->"862759c0-0bbc-41d9-9191-55a4420aac4d"],

Cell["and determine the differences between these sorted forces:", "Text",
 CellChangeTimes->{{3.9803397617026033`*^9, 3.98033978646708*^9}, {
  3.980349027828418*^9, 
  3.980349028707106*^9}},ExpressionUUID->"260ccf20-ba0a-4141-87d9-\
c9873254de89"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Differences", "[", "for1Sorted", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.980339484008354*^9, 3.980339502019651*^9}, {
   3.980349033293486*^9, 3.980349034976366*^9}, 3.98034978313349*^9, 
   3.980351333339479*^9, 3.980354403114691*^9, 3.980356190695611*^9},
 CellLabel->"In[92]:=",ExpressionUUID->"99f3f596-fb14-404a-b180-b849c6763a1c"],

Cell["The minimum force increment in \[Mu]N will then be given by:", "Text",
 CellChangeTimes->{{3.9803397954301443`*^9, 3.980339818563919*^9}, {
  3.980355777339142*^9, 
  3.980355796658477*^9}},ExpressionUUID->"0b4043dd-c7f9-470a-bd68-\
f8f98a9991ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"\[CapitalDelta]for1", "=", 
   RowBox[{
    SuperscriptBox["10", "6"], " ", 
    RowBox[{"Min", "[", 
     RowBox[{"Differences", "[", "for1Sorted", "]"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.98033953292771*^9, 3.980339550391551*^9}, {
   3.9803490471974907`*^9, 3.980349065236726*^9}, {3.980349785607449*^9, 
   3.980349787101989*^9}, {3.980351334779339*^9, 3.980351335925708*^9}, 
   3.980354418241456*^9, {3.980355814169957*^9, 3.980355815980793*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"d1e39c6c-1ce1-4e29-be36-290dee8a34c6"],

Cell[BoxData["0.9809999999832453`"], "Output",
 CellChangeTimes->{3.9803395535980263`*^9, 3.980349067359614*^9, 
  3.980354419211776*^9, 3.980355408434154*^9, 3.980355764983604*^9, 
  3.980355819139291*^9, 3.980356081317699*^9, 3.980356203095096*^9, 
  3.9815561025133247`*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"008dfdde-069e-0c4e-ba1a-fcb8aa6b118c"]
}, Open  ]],

Cell["\<\
So we have just experimentally determined the minimum force increment \
(otherwise known as the force resolution) as 0.981 N = 0.981 \[Mu]N. \
\>", "Text",
 CellChangeTimes->{{3.948994603208048*^9, 3.948994665481845*^9}, {
   3.980339846486608*^9, 3.980339893702647*^9}, {3.980349151195939*^9, 
   3.980349196180407*^9}, {3.980349661654964*^9, 3.980349703518311*^9}, 
   3.9803497419894457`*^9, {3.9803544736644*^9, 3.980354482726986*^9}, {
   3.9803562222747097`*^9, 
   3.980356240917487*^9}},ExpressionUUID->"dc2361aa-c3fc-453d-bccb-\
294939c6a460"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UnitConvert", "[", 
  RowBox[{
   RowBox[{"Quantity", "[", 
    RowBox[{"0.981", ",", "\"\<MicroNewtons\>\""}], "]"}], 
   ",", "\"\<MilliGramsForce\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.980354566750539*^9, 3.9803546163679533`*^9}, {
  3.9803561415353127`*^9, 3.980356145077533*^9}},
 NumberMarks->False,
 CellLabel->"In[94]:=",ExpressionUUID->"22c610fa-00a9-4d48-b37b-198a16d68b23"],

Cell[BoxData[
 TemplateBox[{
  "0.10003416049313477`", "\"mgf\"", "milligram\[Hyphen]force", 
   "\"MilligramsForce\""},
  "Quantity"]], "Output",
 CellChangeTimes->{
  3.9803545492407846`*^9, {3.980354592612824*^9, 3.980354623280778*^9}, 
   3.980356147812879*^9, 3.9815561063949184`*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"76c56049-6639-7844-b892-a6469bfc04cb"]
}, Open  ]],

Cell["\<\
This is as expected as the TinkerForge Load Cell Bricklet returns integer \
values. We had specified that 1 kg mass on the force sensor during \
calibration would correspond to 10,000,000. This means that if the Load Cell \
returns 1 (the minimum absolute value) then this corresponds to 0.1 mg \
(force) = 0.981 \[Mu]N.
However this is an artificial resolution as it was set by our selection of \
10,000,000 when we calibrated the force sensor. The actual resolution is the \
10 \[Mu]N dominant row separation seen in the plot above.\
\>", "Text",
 CellChangeTimes->{{3.980354661375922*^9, 3.9803548403042517`*^9}, {
  3.9803562556119127`*^9, 3.980356260366126*^9}, {3.980356371830723*^9, 
  3.980356419238791*^9}, {3.980356803471171*^9, 
  3.9803568874863234`*^9}},ExpressionUUID->"b6006940-f64f-4682-9cc1-\
c3c00b5e6949"]
}, Open  ]],

