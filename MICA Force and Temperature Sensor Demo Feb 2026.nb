      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"Histogram", "[", 
   RowBox[{"timeInc", ",", 
    RowBox[{"{", 
     RowBox[{"0.0102", ",", "0.03", ",", "0.0004"}], "}"}], ",", "\"\<PDF\>\"",
     ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Inter-Sample Interval (s)\>\"", 
       ",", "\"\<Probability\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", 
     "\[Rule]", "\"\<Inter-Sample Interval Probability Density\>\""}], ",", 
    RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]], "Input",
