Cell["\<\
We can see a small drift in temperature (your temperature signal may or may \
not show this). 
We also see what appears to be small random step changes in temperature. This \
is caused by the limited resolution (dynamic range) of the Thermocouple \
Bricklet analog to digital converter (ADC). This ADC \
\[OpenCurlyDoubleQuote]bit quantization\[CloseCurlyDoubleQuote] is easier to \
see when we detrend the data:\
\>", "Text",
 CellChangeTimes->{{3.948992089068873*^9, 3.948992185867223*^9}, {
   3.948992219470487*^9, 3.948992377021324*^9}, {3.948992409061635*^9, 
   3.9489924274678917`*^9}, 3.949055284560709*^9, {3.980357049624934*^9, 
   3.980357054696126*^9}},ExpressionUUID->"647224b4-d3c8-4ce8-9d70-\
dd703daa7bd6"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"temperature1\[CapitalDelta]", "=", 
   RowBox[{"Differences", "[", "temperature1", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.949054247552455*^9, 3.949054281856255*^9}, {
   3.949054534145713*^9, 3.94905454754548*^9}, 3.949416944645348*^9, {
   3.980351159964477*^9, 3.9803511635955677`*^9}, {3.980357182050331*^9, 
   3.980357192465063*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"f289032c-c90a-4084-9e41-5479b0e3e80b"],

Cell["\<\
Note that the length of the force1\[CapitalDelta] signal will be n-1. Lets \
plot the linearly detrended signal:\
\>", "Text",
 CellChangeTimes->{{3.9490543291569357`*^9, 3.94905442230484*^9}, {
   3.949054569146193*^9, 3.949054618247246*^9}, 
   3.980351165964364*^9},ExpressionUUID->"c7d6cbf1-c4e8-41f9-878a-\
9abcac9ff169"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"time1", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"n", "-", "1"}]}], "]"}], "]"}], ",", 
       "temperature1\[CapitalDelta]"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotStyle", "->", "Red"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Time (s)\>\"", ",", 
       " ", "\"\<Detrended Temperature (\[Degree]C)\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<Detrended Temperature vs Time\>\""}],
     ",", 
    RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9354985199498987`*^9, 3.935498553981361*^9}, {
