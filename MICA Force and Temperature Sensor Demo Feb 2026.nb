Cell["\<\
A benefit of the SmoothHistogram[] function is that it eliminates the need to \
select a bin width as it does this automatically. This looks similar in shape \
to a Gaussian probability density function (i.e., a \
\[OpenCurlyDoubleQuote]bell shape\[CloseCurlyDoubleQuote]). 
We would like to find the best fit Gaussian probability density function to \
the force data. The Gaussian probability density function is a nonlinear \
function having 2 parameters: the mean, \[Mu], and standard deviation, \
\[Sigma] . \
\>", "Text",
 CellChangeTimes->{{3.948979969236052*^9, 3.948980207358169*^9}, {
   3.948980379836966*^9, 3.948980462201254*^9}, {3.948990808158964*^9, 
   3.948990815447419*^9}, {3.9489908528004*^9, 3.948991008181202*^9}, {
   3.948991039013989*^9, 3.9489910700494947`*^9}, 3.9803383456689453`*^9, {
   3.980354208598423*^9, 
   3.980354282526896*^9}},ExpressionUUID->"fb22f3f1-5473-4142-9a7d-\
0b24676d3d65"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"pdf", "(", "x", ")"}], "=", 
    FractionBox["1", 
     RowBox[{"\[Sigma]", 
      SqrtBox[
       RowBox[{"2", "\[Pi]"}]]}]]}], TraditionalForm]],
  FontSize->24,ExpressionUUID->"61bebfa9-fd52-4c60-9f81-9a1c3c464dd7"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"x", "-", "\[Mu]"}], "\[Sigma]"], ")"}], "2"]}]], 
   TraditionalForm]],
  FontSize->24,ExpressionUUID->"0a6108b6-4948-4676-a325-4a047bbcef52"]
}], "Text",
 CellChangeTimes->{{3.948979969236052*^9, 3.948980207358169*^9}, {
  3.948980379836966*^9, 3.948980462201254*^9}, {3.948990808158964*^9, 
  3.948990815447419*^9}, {3.9489908528004*^9, 3.948991008181202*^9}, {
  3.948991039013989*^9, 3.9489910700494947`*^9}},
 TextAlignment->Center,ExpressionUUID->"02cd3c68-4795-4c9a-9516-f303eaa0c969"],

Cell["\<\
Normally we would have to use a nonlinear minimization algorithm to find the \
best fit parameters, \[Mu] and \[Sigma],  iteratively. However this is not \
required as the computed mean and standard deviation are already the least \
squares best fit parameters!
So we can now plot the best fit Gaussian probability density together with \
the measured (non-parametric) probability density function:\
\>", "Text",
 CellChangeTimes->{{3.948979969236052*^9, 3.948980207358169*^9}, {
  3.948980379836966*^9, 3.948980462201254*^9}, {3.948990808158964*^9, 
  3.948990808472926*^9}, {3.948991089807963*^9, 3.948991103724523*^9}, {
  3.949417040854113*^9, 
  3.9494170424575853`*^9}},ExpressionUUID->"c2cb779b-211c-44c7-b9ac-\
4ff8af12f6ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{"force1\[CapitalDelta]", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "4"}], " ", "force1SD"}], ",", 
        RowBox[{"4", " ", "force1SD"}], ",", 
        RowBox[{"0.15", "force1SD"}]}], "}"}], ",", "\"\<PDF\>\"", ",", 
      RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Detrended Force (N)\>\"", ",", "\"\<Probability\>\""}], 
        "}"}]}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", "\[Rule]", "\"\<Detrended Force Probability Density\>\""}],
       ",", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "force1SD"}], "]"}], ",", "x"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"-", "4"}], " ", "force1SD"}], ",", 
        RowBox[{"4", " ", "force1SD"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}]], "Input",
