Cell[CellGroupData[{

Cell["Force Probability Density and Distribution Functions", "Subsubsection",
 CellChangeTimes->{{3.948978547959515*^9, 3.948978561536441*^9}, {
  3.949052869303347*^9, 
  3.9490528794452467`*^9}},ExpressionUUID->"8ca90e9f-79bc-43ab-b2a2-\
1f766606c621"],

Cell["\<\
Lets determine the non-parametric probability density function of the force. \
If we suspect that a signal is dominated by measurement noise then it is \
common to start by determining the probability density over a range of \
amplitudes \[PlusMinus]4 SD about the mean:\
\>", "Text",
 CellChangeTimes->{{3.9489795949101667`*^9, 3.948979616315774*^9}, {
  3.948979750090857*^9, 
  3.948979885368573*^9}},ExpressionUUID->"41bb5551-4e0a-4b0c-993f-\
ce20cdb7cb40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"Histogram", "[", 
   RowBox[{"force1\[CapitalDelta]", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "force1SD"}], ",", 
      RowBox[{"4", " ", "force1SD"}], ",", 
      RowBox[{"0.15", "force1SD"}]}], "}"}], ",", "\"\<PDF\>\"", ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Detrended Force (N)\>\"", ",", "\"\<Probability\>\""}], 
      "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "\[Rule]", "\"\<Detrended Force Probability Density\>\""}], ",", 
    RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.948967000917329*^9, 3.948967010737829*^9}, {
