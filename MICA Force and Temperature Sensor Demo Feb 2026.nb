    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pause", "[", "5", "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "give", " ", "time", " ", "to", " ", "move", " ", "away", " ", "from", " ", 
    RowBox[{"table", "/", "bench"}], " ", "holding", " ", "the", " ", 
    "setup"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"time2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"temperature2", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", "n"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"in", " ", "oC"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"force2", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", "n"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"in", " ", "Newtons"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]t", "=", "0.02"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"desired", " ", "inter"}], "-", 
    RowBox[{"sample", " ", "interval", " ", "in", " ", "s"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"(", 
