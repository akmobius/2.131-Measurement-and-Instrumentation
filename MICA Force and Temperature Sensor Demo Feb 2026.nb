Cell["It certainly looks like the force sensor noise is Gaussian.", "Text",
 CellChangeTimes->{{3.948980905691248*^9, 
  3.948980926271661*^9}},ExpressionUUID->"7e0e6e05-6508-4a35-9b0d-\
b9811db8ea44"],

Cell["\<\
Lets also look at the force probability distribution function:\
\>", "Text",
 CellChangeTimes->{{3.949052909041738*^9, 
  3.9490529328170443`*^9}},ExpressionUUID->"744597ff-bf26-4ab3-b26b-\
c4c9babee1f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{"force1\[CapitalDelta]", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "4"}], " ", "force1SD"}], ",", 
        RowBox[{"4", " ", "force1SD"}], ",", 
        RowBox[{"0.15", "force1SD"}]}], "}"}], ",", "\"\<CDF\>\"", ",", 
      RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Detrended Force (N)\>\"", ",", "\"\<Probability\>\""}], 
        "}"}]}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", "\[Rule]", "\"\<Detrended Force Probability Density\>\""}],
       ",", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"CDF", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "force1SD"}], "]"}], ",", "x"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"-", "4"}], " ", "force1SD"}], ",", 
        RowBox[{"4", " ", "force1SD"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.767209105318701*^9, 3.767209199426674*^9}, {
   3.767209532034074*^9, 3.7672095323006577`*^9}, {3.767209565648168*^9, 
   3.7672095681822104`*^9}, {3.767209607950657*^9, 3.7672096098382244`*^9}, {
   3.7673085108703356`*^9, 3.7673085371755567`*^9}, {3.76730947412314*^9, 
