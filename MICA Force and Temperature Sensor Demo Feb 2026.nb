Cell["\<\
We can see that there is a small drift in the force signal (your data may or \
may not show this).\
\>", "Text",
 CellChangeTimes->{{3.948991886905773*^9, 
  3.948991964037772*^9}},ExpressionUUID->"72432695-4695-4d0f-837e-\
a59d6d39fe2c"],

Cell["\<\
We could fit a straight line to the force signal and then subtract it to \
remove a linear trend (drift). An equivalent approach is to take successive \
differences between adjacent data points:\
\>", "Text",
 CellChangeTimes->{{3.94905384641578*^9, 3.949053954075554*^9}, {
  3.94905423207335*^9, 
  3.9490542441968393`*^9}},ExpressionUUID->"6df6d1b2-4449-47e6-8018-\
1dc8dc090fcb"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"force1\[CapitalDelta]", "=", 
   RowBox[{"Differences", "[", "force1", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.949054247552455*^9, 3.949054281856255*^9}, {
   3.949054534145713*^9, 3.94905454754548*^9}, 3.949416944645348*^9, {
   3.980351159964477*^9, 3.9803511635955677`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"d546460d-63b4-4331-b136-fe8386dafebf"],

Cell["\<\
Note that the length of the force1\[CapitalDelta] signal will be n-1. Lets \
plot the linearly detrended signal:\
\>", "Text",
 CellChangeTimes->{{3.9490543291569357`*^9, 3.94905442230484*^9}, {
   3.949054569146193*^9, 3.949054618247246*^9}, 
   3.980351165964364*^9},ExpressionUUID->"f1d97318-0f57-4b11-a12a-\
dd5d190f2d45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"time1", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"n", "-", "1"}]}], "]"}], "]"}], ",", 
       "force1\[CapitalDelta]"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotStyle", "->", "Blue"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Time (s)\>\"", ",", " ", "\"\<Detrended Force (N)\>\""}], 
      "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<Detrended Force vs Time\>\""}], ",", 
    
    RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9354985199498987`*^9, 3.935498553981361*^9}, {
   3.9355091083120413`*^9, 3.9355091686937847`*^9}, 3.938165175931233*^9, {
