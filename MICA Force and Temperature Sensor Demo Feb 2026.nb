Cell[CellGroupData[{

Cell["Setup TinkerForge Load Cell Bricklet", "Subsubsection",
 CellChangeTimes->{{3.948964480087336*^9, 
  3.948964493870636*^9}},ExpressionUUID->"f37e3d10-8a14-41b0-985b-\
e76772dbeaf3"],

Cell["\<\
By default the Load Cell Bricklet takes the average of every 4 samples with a \
moving average filter. We do not want such averaging so we need to turn it \
off by setting the average to 1 (i.e. no averaging):\
\>", "Text",
 CellChangeTimes->{{3.948964514902977*^9, 3.9489646262209063`*^9}, 
   3.948964855210688*^9},ExpressionUUID->"14d2cba2-4c8a-4e16-9f06-\
c9e06b099ec8"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"lc", "@", 
   RowBox[{"SetMovingAverage", "[", "1", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.948964594028512*^9, 3.948964597390086*^9}, {
  3.948964631290042*^9, 3.948964631409379*^9}, {3.9489648808667097`*^9, 
  3.948964890510689*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"6a47e588-b268-48a7-9b9f-158ed8e5d818"],

Cell["\<\
By default the Load Cell Bricklet samples at 10 Hz but can sample at 80 Hz \
which is what we want. It also has 3 gain settings (32x, 64x, and 128x). We \
want 128x. Lets set these:\
\>", "Text",
 CellChangeTimes->{{3.948964664426878*^9, 3.94896473684927*^9}, {
  3.948964800281713*^9, 
  3.948964874820928*^9}},ExpressionUUID->"4cd5279a-1745-4ebe-a82e-\
a2569a1ea2af"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"lc", "@", 
   RowBox[{"SetConfiguration", "[", 
    RowBox[{
    "BrickletLoadCellV2`RATEU80HZ", ",", "BrickletLoadCellV2`GAINU128X"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.948964755513338*^9, 3.948964794404323*^9}, {
  3.948964878930272*^9, 3.948964894184939*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"02338323-b8d5-4ffd-9ed0-7cdf69a0e8cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Setup TinkerForge Thermocouple Bricklet", "Subsubsection",
 CellChangeTimes->{{3.9354317507403383`*^9, 3.9354317624278717`*^9}, {
  3.948964498255804*^9, 
  3.948964503620882*^9}},ExpressionUUID->"646e1ca4-2ad3-42f5-8ca7-\
7428afa3a640"],

Cell["\<\
By default the Thermocouple Bricklet averages ever 16 samples. We do not want \
this so we need to explicitly set this to 1.
The Thermocouple Bricklet can infer the thermocouple type, but as we know \
that it is Type K  we will specify this.
Thermocouples tend to pick up voltages induced by adjacent equipment \
connected to the mains (wall outlet) power which in the US is 120 V, 60 Hz).
The Thermocouple Bricklet includes a digital filter designed to attenuate \
this induced \[OpenCurlyDoubleQuote]noise\[CloseCurlyDoubleQuote]. The \
default is 50 Hz but as we are in the US we will set it to 60 Hz.\
\>", "Text",
 CellChangeTimes->{{3.9489050925933533`*^9, 3.948905191867529*^9}, {
   3.94890526727354*^9, 3.9489056560650587`*^9}, 
   3.948914304057501*^9},ExpressionUUID->"69e3a3d3-cba8-448e-8730-\
43756a2dd745"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", "  ", 
   RowBox[{"tc", "@", 
    RowBox[{"SetConfiguration", "[", 
     RowBox[{
     "BrickletThermocoupleV2`AVERAGINGU1", ",", 
      "BrickletThermocoupleV2`TYPEUK", ",", 
      "BrickletThermocoupleV2`FILTERUOPTIONU60HZ"}], "]"}]}], ";"}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.935431778508491*^9, 3.9354317816846313`*^9}, {
   3.935495072909492*^9, 3.935495078216496*^9}, {3.948905052378264*^9, 
