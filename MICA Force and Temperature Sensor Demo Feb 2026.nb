Cell["\<\
The data look highly Gaussian. A common assumption made is to assume that the \
noise variation will increase with amplitude. This is not necessarily the \
case. Lets compare the force probability densities of the detrended 0 load \
and 1 kg mass load experiments:\
\>", "Text",
 CellChangeTimes->{{3.980359099872286*^9, 3.980359259093087*^9}, {
  3.980359605042461*^9, 
  3.980359605727214*^9}},ExpressionUUID->"b59b55bb-734c-4803-bf78-\
ed928c2e6859"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"SmoothHistogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"force1\[CapitalDelta]", ",", "force2\[CapitalDelta]"}], "}"}], ",",
    "Automatic", ",", "\"\<PDF\>\"", ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Detrended Force (N)\>\"", ",", "\"\<Probability\>\""}], 
     "}"}]}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Detrended Force Probability Density (Red 0 kg) (Blue 1 \
kg)\>\""}], ",", 
   RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.767209105318701*^9, 3.767209199426674*^9}, {
   3.767209532034074*^9, 3.7672095323006577`*^9}, {3.767209565648168*^9, 
   3.7672095681822104`*^9}, {3.767209607950657*^9, 3.7672096098382244`*^9}, {
