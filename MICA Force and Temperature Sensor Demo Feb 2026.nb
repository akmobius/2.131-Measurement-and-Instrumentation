Cell["Store Data", "Subsubsection",
 CellChangeTimes->{{3.9310246196828117`*^9, 
  3.931024624378745*^9}},ExpressionUUID->"b763213f-d62c-4806-8bfc-\
76badd8c77bd"],

Cell["\<\
By default Mathematica does not store large amounts of data. We can force it \
store our force and temperature signals using:\
\>", "Text",
 CellChangeTimes->{{3.948915180160934*^9, 
  3.948915244287405*^9}},ExpressionUUID->"776737af-7847-4d67-b429-\
ea0a0ca7140f"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{
   RowBox[{
   "PersistentSymbol", "[", "\"\<NoLoadForceTemperatureData\>\"", "]"}], "=", 
   
   RowBox[{"{", 
    RowBox[{"time1", ",", "force1", ",", "temperature1"}], "}"}]}], 
  ";"}]], "Input",
