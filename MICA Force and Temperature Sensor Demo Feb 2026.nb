    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"temperature2", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{"tc", "@", 
       RowBox[{"GetTemperature", "[", "]"}]}], "/", "100.0"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"force2", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "=", 
     RowBox[{"9.81", " ", 
      FractionBox[
       RowBox[{"lc", "@", 
        RowBox[{"GetWeight", "[", "]"}]}], "10000000"]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"i", ",", "1000"}], "]"}], "==", "0"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "print", " ", "out", " ", "every", " ", "1000", "th", " ", "sample", " ",
         "index"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "i", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "Input",
