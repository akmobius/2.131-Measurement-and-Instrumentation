Cell["\<\
To introduce Newton\[CloseCurlyQuote]s  iterative method to find a root of a \
function.\
\>", "Text",
 CellChangeTimes->{{3.8950011377116194`*^9, 3.8950011390608683`*^9}, {
  3.8987887065458665`*^9, 3.8987887386338615`*^9}, {3.8989356502867393`*^9, 
  3.8989357779110875`*^9}, {3.9005824598670607`*^9, 3.9005824629957952`*^9}, {
  3.9088848793728604`*^9, 3.9088850494847374`*^9}, {3.9089040861909513`*^9, 
  3.908904128839563*^9}, {3.908913628587113*^9, 
  3.908913658642268*^9}},ExpressionUUID->"08197690-fcfb-4aa1-9aa9-\
0146a149aeda"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Keywords", "Subsubsection",
 CellChangeTimes->{{3.8950011521921034`*^9, 
  3.8950011540714774`*^9}},ExpressionUUID->"9f6627e6-2049-49fd-9078-\
fdbbaae7afba"],

Cell["Newton\[CloseCurlyQuote]s Method, Iterative Algorithms, Roots, Golden \
Ratio", "Text",
 CellChangeTimes->{{3.895001160134589*^9, 3.8950011662776003`*^9}, {
   3.898788746465714*^9, 3.89878903884105*^9}, {3.900582469673043*^9, 
   3.9005825032820377`*^9}, {3.908885063884777*^9, 3.9088850806527376`*^9}, {
   3.908885206188813*^9, 3.9088852209487953`*^9}, {3.908885251477429*^9, 
   3.908885291268875*^9}, {3.9088854787730756`*^9, 3.9088854838280077`*^9}, {
   3.9088855584440117`*^9, 3.9088855619479465`*^9}, {3.9088903043739777`*^9, 
   3.9088903117704782`*^9}, {3.9089041324764376`*^9, 3.908904180964176*^9}, 
   3.9089698491438665`*^9},ExpressionUUID->"7890f646-705f-4e98-a9a1-\
124246736249"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Background", "Subsubsection",
 CellChangeTimes->{{3.7961519004776516`*^9, 3.7961519020255537`*^9}, {
  3.7961520383252754`*^9, 3.7961520468963404`*^9}, {3.79621412479053*^9, 
  3.7962141268841257`*^9}},ExpressionUUID->"062e86dc-89ea-425c-802f-\
145f5a7b4e0d"],

Cell["\<\
The roots of a function, g(x), are simply the x values when g(x)=0 (i.e. the \
points at which a function
crosses or touches the x-axis). The roots of second-, third- and fourth-order \
polynomials (i.e. a quadratic, cubic and quartic polynomials) may be found \
using explicit formulas. (mathematicians spent considerable time searching \
for such formulas for 5th and higher order polynomials until the Norwegian \
mathematician Neils Abel proved that no such formulas were possible).\
\>", "Text",
 CellChangeTimes->{{3.908904198864153*^9, 
  3.9089042190141716`*^9}},ExpressionUUID->"a0233a77-3ecb-4060-9afb-\
b37acc619655"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Second-Order Polynomials", "Subsubsection",
 CellChangeTimes->{{3.908904253048473*^9, 
  3.9089042631186457`*^9}},ExpressionUUID->"fd300298-c3aa-4523-9996-\
7ba258a52937"],

Cell["Second-order polynomials are of the form:", "Text",
 CellChangeTimes->{{3.908904271023529*^9, 
  3.9089042907788305`*^9}},ExpressionUUID->"6521a89f-28ae-46c0-9894-\
40d46b7a358c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"x_", ",", "a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"a", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"b", " ", "x"}], "+", "c"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9089043021203766`*^9, 3.9089043511942854`*^9}},
 CellLabel->
  "In[299]:=",ExpressionUUID->"9aacbd54-c92b-42a1-9db1-4f69b266e786"],

Cell["The formulas for the 2 roots are", "Text",
 CellChangeTimes->{{3.9089043714786296`*^9, 
  3.908904383966583*^9}},ExpressionUUID->"e7b0a3dc-61f0-4379-9284-\
5c650440818b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xLower", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"-", "b"}], "-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["b", "2"], "-", 
      RowBox[{"4", " ", "a", " ", "c"}]}]]}], 
   RowBox[{"2", " ", "a"}]]}]], "Input",
 CellChangeTimes->{{3.9089043997971616`*^9, 3.9089044654559765`*^9}},
 CellLabel->
  "In[300]:=",ExpressionUUID->"49f608f4-34ae-43e2-8ccb-86d754850c2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xHigher", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"-", "b"}], "+", 
