Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dif", "=", 
   RowBox[{"NumberForm", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{"g", "[", "x0", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x0", "]"}]], ",", 
        FractionBox[
         RowBox[{"g", "[", "x1", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x1", "]"}]], ",", 
        FractionBox[
         RowBox[{"g", "[", "x2", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x2", "]"}]], ",", 
        FractionBox[
         RowBox[{"g", "[", "x3", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x3", "]"}]], ",", 
        FractionBox[
         RowBox[{"g", "[", "x4", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x4", "]"}]], ",", 
        FractionBox[
         RowBox[{"g", "[", "x5", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x5", "]"}]], ",", 
        FractionBox[
         RowBox[{"g", "[", "x6", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x6", "]"}]]}], "}"}], "]"}], ",", "20", 
     ",", 
     RowBox[{"ExponentFunction", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"Null", "&"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"est", "=", 
   RowBox[{"NumberForm", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{
       "x0", ",", "x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5", ",", 
        "x6"}], "}"}], "]"}], ",", "20", ",", 
     RowBox[{"ExponentFunction", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"Null", "&"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"err", "=", 
   RowBox[{"NumberForm", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
