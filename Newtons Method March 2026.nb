Cell[CellGroupData[{

Cell["Newton\[CloseCurlyQuote]s Method", "Subsubsection",
 CellChangeTimes->{{3.9089051753728285`*^9, 
  3.9089051797811327`*^9}},ExpressionUUID->"43284cb1-3abf-47ec-a92b-\
1315ca4cb931"],

Cell["\<\
But what do we do when we do not know the formulas for the roots?
A number of methods exist to find roots when explicit formulas are not \
available. The most famous of these methods is called \
Newton\[CloseCurlyQuote]s method (or the Newton-Raphson method) developed by \
Issac Newton in the mid 1600s. 
The idea behind this method is to start with an initial guess which is close \
to the desired root.

In the example above lets try to find the second root, xHi (the Golden Ratio).
We will call our initial guess x0 and set\
\>", "Text",
 CellChangeTimes->{{3.9089052023208046`*^9, 3.908905250795006*^9}, {
  3.908906366089695*^9, 3.9089063666918545`*^9}, {3.9399817715394993`*^9, 
  3.9399817728507433`*^9}, {3.97298880515625*^9, 
  3.97298882377249*^9}},ExpressionUUID->"a39b9332-3bb7-41f9-bb82-\
c148b1bfa0fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x0", "=", "2.0"}], ";"}]], "Input",
 CellChangeTimes->{{3.9089052739713545`*^9, 3.9089052784384274`*^9}, {
  3.908906532210449*^9, 3.9089065324832134`*^9}},
 CellLabel->
  "In[308]:=",ExpressionUUID->"937ba100-8f76-42df-b3f3-e33269d59c3c"],

Cell["\<\
We next find the slope of g[x] at the point (x0,g[x0]).
We can get this by differentiation\
\>", "Text",
 CellChangeTimes->{{3.9089052846925993`*^9, 3.9089053061399393`*^9}, {
  3.908906354365549*^9, 
  3.9089064191318355`*^9}},ExpressionUUID->"c74eec18-4766-49f2-8715-\
3f5f4813cb75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "'"}], "[", "x", "]"}]], "Input",
 CellChangeTimes->{{3.9089064293842607`*^9, 3.9089064429455333`*^9}},
 CellLabel->
  "In[309]:=",ExpressionUUID->"0ac1d8b1-9668-4391-9716-d8dfe8f62600"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "1"}], "+", 
  RowBox[{"2", " ", "x"}]}]], "Output",
 CellChangeTimes->{3.908906444280701*^9, 3.908906542859789*^9, 
  3.908967190019476*^9, 3.9089676849235115`*^9, 3.9089677230160923`*^9, 
  3.908968989289916*^9, 3.9089690933692226`*^9, 3.9089691827115083`*^9},
 CellLabel->
  "Out[309]=",ExpressionUUID->"3b8c5c16-a02c-4281-ac7f-58c61526ce50"]
}, Open  ]],

Cell["Newton\[CloseCurlyQuote]s method specifies the next \
\[OpenCurlyDoubleQuote]guess\[CloseCurlyDoubleQuote] as", "Text",
 CellChangeTimes->{{3.9089064711785183`*^9, 
  3.9089064857933874`*^9}},ExpressionUUID->"9e1b729d-14a5-49f1-a5d5-\
4df8255d01e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"x1", "=", 
  RowBox[{"x0", "-", 
   FractionBox[
    RowBox[{"g", "[", "x0", "]"}], 
    RowBox[{
     RowBox[{"g", "'"}], "[", "x0", "]"}]]}]}]], "Input",
 CellChangeTimes->{{3.9089064936372585`*^9, 3.9089065201917925`*^9}},
 CellLabel->
