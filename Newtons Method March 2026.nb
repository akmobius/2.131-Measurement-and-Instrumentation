Cell["Newton\[CloseCurlyQuote]s method specifies the next \
\[OpenCurlyDoubleQuote]guesses\[CloseCurlyDoubleQuote] as", "Text",
 CellChangeTimes->{{3.9089064711785183`*^9, 3.9089064857933874`*^9}, {
  3.9089072647446146`*^9, 
  3.9089072649577866`*^9}},ExpressionUUID->"67afb001-38c1-4aa5-be7f-\
7c99f58037a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x3", "=", 
   RowBox[{"x2", "-", 
    FractionBox[
     RowBox[{"g", "[", "x2", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x2", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x4", "=", 
   RowBox[{"x3", "-", 
    FractionBox[
     RowBox[{"g", "[", "x3", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x3", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x5", "=", 
   RowBox[{"x4", "-", 
    FractionBox[
     RowBox[{"g", "[", "x4", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x4", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x6", "=", 
   RowBox[{"x5", "-", 
