Cell["\<\
The convergence is so fast that we can only see the first few estimates as \
different from the exact value on this plot.\
\>", "Text",
 CellChangeTimes->{{3.908911498263476*^9, 
  3.9089115732391396`*^9}},ExpressionUUID->"329f8036-84c3-41f3-8862-\
e73114d8e843"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Find Pi", "Subsubsection",
 CellChangeTimes->{{3.908912426463066*^9, 
  3.9089124297509837`*^9}},ExpressionUUID->"0d060e3f-87c0-4fc7-b147-\
694e62e65341"],

Cell["\<\
We can use Newton\[CloseCurlyQuote]s Method to estimate \[Pi] by observing \
that Sin[x] becomes 0 when x = \[Pi]. In other words the first positive root \
of Sin[x] is \[Pi]. Lets check:\
\>", "Text",
 CellChangeTimes->{{3.9089134101490183`*^9, 
  3.9089135325075483`*^9}},ExpressionUUID->"96057bb8-6b60-4760-a48d-\
01901c935547"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sin", "[", "\[Pi]", "]"}]], "Input",
 CellChangeTimes->{{3.9089135357066784`*^9, 3.9089135398205647`*^9}},
 CellLabel->
  "In[324]:=",ExpressionUUID->"c70497af-fdef-4e4c-a839-ab8b42fba119"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.908913541916086*^9, 3.9089671904534783`*^9, 
  3.908968989731305*^9, 3.9089690937814417`*^9, 3.9089691831378565`*^9},
 CellLabel->
  "Out[324]=",ExpressionUUID->"38cd3fe5-5db0-468e-ab14-ae331f253eb4"]
}, Open  ]],

Cell["\<\
So we set up the required function (Sin[x] and its derivative:\
\>", "Text",
 CellChangeTimes->{{3.9089135489783382`*^9, 
  3.9089135807803726`*^9}},ExpressionUUID->"cf4471d5-f8ad-4b8e-8b6c-\
6fe62839bd99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "x_", "]"}], ":=", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.908912435477605*^9, 3.908912467327524*^9}},
 CellLabel->
  "In[325]:=",ExpressionUUID->"a4d2e8ad-7d57-4e58-a829-bb3683685cac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "'"}], "[", "x", "]"}]], "Input",
 CellChangeTimes->{{3.908912448338716*^9, 3.908912451439019*^9}},
 CellLabel->
  "In[326]:=",ExpressionUUID->"52ff693c-7cc8-478c-8646-a64c2c9779fa"],

Cell[BoxData[
 RowBox[{"Cos", "[", "x", "]"}]], "Output",
 CellChangeTimes->{{3.908912452853702*^9, 3.908912472919229*^9}, 
   3.9089671904864674`*^9, 3.908968989769347*^9, 3.908969093809538*^9, 
   3.908969183171855*^9},
 CellLabel->
  "Out[326]=",ExpressionUUID->"dea38c7a-bd5f-4dca-a716-bc043282534d"]
}, Open  ]],

