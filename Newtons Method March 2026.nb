Cell["\<\
The root of g[x] is \[Pi] and is near 3. So lets make our first estimate of \
\[Pi] to be 3\
\>", "Text",
 CellChangeTimes->{{3.9089125595247126`*^9, 
  3.908912607728619*^9}},ExpressionUUID->"cf8c2fb9-147f-4818-916d-\
50013bb21dfa"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9089126137449503`*^9, 3.908912629235796*^9}, 
   3.9089127276047053`*^9},
 CellLabel->
  "In[328]:=",ExpressionUUID->"95501a9c-fb1c-47f4-8e25-1dbfc05386c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", "3.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x1", "=", 
   RowBox[{"x0", "-", 
    FractionBox[
     RowBox[{"g", "[", "x0", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x0", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x2", "=", 
   RowBox[{"x1", "-", 
    FractionBox[
     RowBox[{"g", "[", "x1", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x1", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x3", "=", 
   RowBox[{"x2", "-", 
    FractionBox[
     RowBox[{"g", "[", "x2", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x2", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x4", "=", 
   RowBox[{"x3", "-", 
    FractionBox[
     RowBox[{"g", "[", "x3", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x3", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x5", "=", 
   RowBox[{"x4", "-", 
    FractionBox[
     RowBox[{"g", "[", "x4", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x4", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x6", "=", 
   RowBox[{"x5", "-", 
    FractionBox[
     RowBox[{"g", "[", "x5", "]"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", "x5", "]"}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9089072701807547`*^9, 3.9089073580008326`*^9}, {
  3.9089074065165772`*^9, 3.9089075005793676`*^9}, {3.9089075326039534`*^9, 
  3.908907537928494*^9}, {3.9089126548239536`*^9, 3.908912719055912*^9}, {
  3.9089128364704747`*^9, 3.908912836759776*^9}},
 CellLabel->
  "In[329]:=",ExpressionUUID->"7d9d2ea9-e830-4bbe-88bf-c0b3c5fc1644"],

Cell["Lets look at the various estimates and their error:", "Text",
 CellChangeTimes->{{3.908907505465599*^9, 3.908907528391364*^9}, {
  3.9089690816865697`*^9, 
  3.9089690846923513`*^9}},ExpressionUUID->"c8c3c225-c823-49df-9787-\
393dbb61b08b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dif", "=", 
   RowBox[{"NumberForm", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{"g", "[", "x0", "]"}], 
         RowBox[{
          RowBox[{"g", "'"}], "[", "x0", "]"}]], ",", 
        FractionBox[
