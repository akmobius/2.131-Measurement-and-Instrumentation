Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "out"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d6b25a90-6614-4f6f-878c-6117bd56f51f"],
 "  = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["R1", "R2"]}], ")"}], 
    SubscriptBox["V", "in"]}], TraditionalForm]],ExpressionUUID->
  "62bae908-a7fe-4b04-8692-e0acdb424619"]
}], "Text",
 CellChangeTimes->{{3.968754580490622*^9, 
  3.968754617339325*^9}},ExpressionUUID->"71f7df4c-f12e-4997-a17c-\
46f3ad92ca14"],

Cell["Note that the close-loop gain is always > 1", "Text",
 CellChangeTimes->{{3.968754630375738*^9, 
  3.968754642268214*^9}},ExpressionUUID->"3f71a8f5-104a-4334-b435-\
5720be8aff2f"],

Cell[TextData[{
 "Note that a highly undesirable consequence of using this circuit is that \
the output will usually swing to near the positive or negative supply when \
nothing is connected to the input. To avoid this a high value resistor (> ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "6"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da251304-ec6a-470e-8f4f-de3cc8a59f79"],
 " \[CapitalOmega]) is often put between the positive input and ground."
}], "Text",
 CellChangeTimes->{{3.9687546652301702`*^9, 
  3.9687547172689877`*^9}},ExpressionUUID->"529c235a-ba1b-4be6-9828-\
becea43a7179"]
}, Open  ]],

