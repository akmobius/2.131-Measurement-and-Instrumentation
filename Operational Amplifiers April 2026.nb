  FormBox[
   SubscriptBox["G", 
    RowBox[{"open", " ", "loop"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3cdd62a5-ffaa-420e-87df-63b6e8152568"],
 ", of a modern op-amp is typically  >",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "6"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "305e3660-ee60-4568-a720-cbf90861831e"]
}], "Text",
 CellChangeTimes->{{3.968754180602804*^9, 3.968754267384801*^9}, {
  3.968754311830804*^9, 
  3.968754311830823*^9}},ExpressionUUID->"e980fb1f-ccdd-41ac-b4c5-\
db6617602bb4"],

Cell[TextData[{
 "The closed-loop gain, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", 
    RowBox[{"closed", " ", "loop"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e8fb5cb5-0528-4057-bcc6-c96e6c539bca"],
 ", of a modern op-amp is = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["G", 
     RowBox[{"open", " ", "loop"}]], 
    RowBox[{"1", "+", 
     SubscriptBox["G", 
      RowBox[{"open", " ", "loop"}]]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "daafe493-2925-4c45-a230-d70df19cbb9b"],
 " which is very close to 1.\nTherefore we say that the output \
\[OpenCurlyDoubleQuote]follows\[CloseCurlyDoubleQuote] the input."
}], "Text",
 CellChangeTimes->{{3.968754285356476*^9, 3.9687543086180058`*^9}, {
  3.968754346178411*^9, 
  3.968754421420611*^9}},ExpressionUUID->"9f6acb49-e4f4-4d44-85dc-\
b5eeb925d97d"]
}, Open  ]],

