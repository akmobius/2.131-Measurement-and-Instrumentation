 CellChangeTimes->{
  3.98613130717424*^9, {3.986131341669937*^9, 
   3.986131540647592*^9}},ExpressionUUID->"a9de23fb-dd1c-4a85-9638-\
e3c8a053c97e"],

Cell["\<\
Normally you need 2 op amps to create a second-order filter but the \
Sallen-Key design only needs 1 op amp and it has a positive gain (i.e. \
non-inverting).\
\>", "Text",
 CellChangeTimes->{{3.986131624067072*^9, 
  3.9861317011839457`*^9}},ExpressionUUID->"84ba22a3-9cb2-4c5b-b570-\
82dd89fa77e5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Second-Order Low-pass Sallen-Key Filter", "Subsubsection",
 CellChangeTimes->{{3.794934366658835*^9, 3.794934378254829*^9}, {
  3.9861315964675903`*^9, 3.9861315995923*^9}, {3.9861321001143627`*^9, 
  3.986132105281917*^9}},ExpressionUUID->"02cd4ffc-508b-4499-bee5-\
84c70c27577f"],

Cell["\<\
For the case of a second-order, low-pass, filter where we want to have a \
specified static gain and a specified damping parameter we need to add a few \
more components:\
\>", "Text",
 CellChangeTimes->{{3.7949344139327483`*^9, 3.7949344548651333`*^9}, {
  3.795811136937931*^9, 3.7958111883572416`*^9}, {3.970164196967429*^9, 
  3.970164241638542*^9}},ExpressionUUID->"c90d1aac-7341-46fb-94e4-\
798b4865289d"],

