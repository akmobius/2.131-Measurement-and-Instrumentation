Cell[CellGroupData[{

Cell["Input Buffered Differential Amplifier", "Subsubsection",
 CellChangeTimes->{
  3.9687559426684227`*^9},ExpressionUUID->"b40298dd-8d52-4697-a240-\
8ec3396a9439"],

Cell["\<\
It is often a good idea to isolate the differential amplifier from previous \
circuit elements such as sensors. This may be achieved by adding a unity gain \
buffer in front of each input to the circuit as shown below.\
\>", "Text",
 CellChangeTimes->{{3.9687559595960484`*^9, 
  3.96875596536071*^9}},ExpressionUUID->"18a4542e-528b-4392-8fe7-\
208d0a72a65c"],

