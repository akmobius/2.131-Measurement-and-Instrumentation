Cell[CellGroupData[{

Cell["Active Half-Wave Rectifier", "Subsubsection",
 CellChangeTimes->{
  3.9687702460645857`*^9},ExpressionUUID->"f3216794-ccad-49d6-a25b-\
c7d7d4b476e5"],

Cell["\<\
So far all of our circuits have contained linear elements (resistors, \
capacitors) and have implemented linear analog transformations \
(multiplication, addition, subtraction, filtering, etc). A common nonlinear \
operation is the rectifier.\
\>", "Text",
 CellChangeTimes->{{3.9687702599418297`*^9, 
  3.968770272983912*^9}},ExpressionUUID->"18822fb2-d6d9-484e-8e9e-\
4cdad78677d5"],

Cell["The following circuit implements a half-wave rectifier.", "Text",
 CellChangeTimes->{
  3.968770287309823*^9},ExpressionUUID->"78db7cda-99c0-4f94-9151-\
959f4b09b1d8"],

