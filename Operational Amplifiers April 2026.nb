Cell["\<\
In order to achieve the desired \[Alpha], \[Omega], and \[Zeta] using \
standard precision resistors and capacitors we typically have to use two \
capacitors in series to get the desired capacitance (because like resistors \
and inductors, capacitors only come in a limited range of values). \
\>", "Text",
 CellChangeTimes->{{3.970164281778907*^9, 3.9701643949866533`*^9}, {
  3.986131750939443*^9, 
  3.986131812528404*^9}},ExpressionUUID->"f25ebab4-d5c2-4454-8976-\
c8c85812c44f"],

Cell["\<\
There are a few ways we can choose the values of the components to get the \
desired static gain, \[Alpha], natural frequency (in rad/s) \[Omega] and \
damping parameter, \[Zeta]. 
We can choose a design where the capacitors are equal as follows:    C1a =  \
C2a  \[Congruent]  Ca   and    C1b =  C2b  \[Congruent]  Cb\
\>", "Text",
 CellChangeTimes->{{3.794936418619673*^9, 3.7949364245986934`*^9}, {
  3.794936457259291*^9, 3.794936480515072*^9}, {3.969730060689822*^9, 
  3.9697302244035807`*^9}, {3.969730264036491*^9, 3.9697303320899553`*^9}, {
  3.969730381803838*^9, 3.969730407006042*^9}, {3.96973090900091*^9, 
  3.969730929834475*^9}, {3.9698129626894608`*^9, 3.969813027145177*^9}, {
  3.9698130670164003`*^9, 3.9698130706293907`*^9}, {3.969813248909877*^9, 
  3.969813259394125*^9}, {3.986131833898201*^9, 
  3.9861318342985363`*^9}},ExpressionUUID->"3bc24421-6a60-4ee8-a13b-\
c1deea1b73c7"],

Cell["\<\
The transfer function will have the form of a second-order, low-pass, \
transfer function:\
\>", "Text",
 CellChangeTimes->{{3.794936418619673*^9, 3.7949364245986934`*^9}, {
   3.794936457259291*^9, 3.794936480515072*^9}, {3.969730060689822*^9, 
   3.9697302244035807`*^9}, {3.969730264036491*^9, 3.969730344346184*^9}, 
   3.9697304122514553`*^9},ExpressionUUID->"1e202528-c78e-49bf-b7f0-\
57716f924799"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"tf", "[", 
    RowBox[{"s_", ",", "\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], 
    "]"}], ":=", 
   FractionBox[
    RowBox[{"\[Alpha]", " ", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{
     SuperscriptBox["s", "2"], "+", 
     RowBox[{"2", "\[Zeta]", " ", "\[Omega]", " ", "s"}], "+", 
     SuperscriptBox["\[Omega]", "2"]}]]}]}]], "Input",
 CellChangeTimes->{{3.794936491507659*^9, 3.794936626259134*^9}, {
  3.795003635928898*^9, 3.795003643430056*^9}, {3.7958115498389482`*^9, 
  3.795811558951366*^9}, {3.795813115179233*^9, 3.795813119258857*^9}},
 NumberMarks->False,
 CellLabel->
  "In[185]:=",ExpressionUUID->"cffe3702-886e-4a60-bec9-985c720ba12e"],

Cell["\<\
Lets say we want   \[Alpha] = 2, \[Omega] = 2\[Pi] rad/s (i.e. 1 kHz), and \
\[Zeta] = 0.3 then we could use:\
\>", "Text",
 CellChangeTimes->{{3.9697306703009872`*^9, 3.969730673479053*^9}, {
  3.986131898577321*^9, 
  3.9861320416307287`*^9}},ExpressionUUID->"88498eb8-a2dc-43bd-aa64-\
6075bd860fa3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R1", "=", 
    RowBox[{"50.", " ", 
     SuperscriptBox["10", "3"]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"50", " ", "k\[CapitalOmega]"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R2", "=", 
    RowBox[{"18.", " ", 
     SuperscriptBox["10", "3"]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"18", " ", "k\[CapitalOmega]"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R3", "=", 
    RowBox[{"10.", " ", 
     SuperscriptBox["10", "3"]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"10", " ", "k\[CapitalOmega]"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R4", "=", 
    RowBox[{"10.", " ", 
     SuperscriptBox["10", "3"]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"10", " ", "k\[CapitalOmega]"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ca", "=", 
    RowBox[{"8.2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"8.2", " ", "nF"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cb", "=", " ", 
    RowBox[{"15.", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"15", " ", "nF"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
