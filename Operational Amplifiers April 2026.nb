Cell["\<\
This is a very elegant circuit in which the first op amp half wave rectifies \
(negative values \[OpenCurlyDoubleQuote]passed\[CloseCurlyDoubleQuote]) Vin \
which is then multiplied by 2 and added to Vin by the second op amp with the \
result that Vout(t) = |Vin(t)| .\
\>", "Text",
 CellChangeTimes->{{3.968770516669759*^9, 
  3.968770540638423*^9}},ExpressionUUID->"d9ac9b1d-9c37-4580-83b1-\
36381ac87266"],

