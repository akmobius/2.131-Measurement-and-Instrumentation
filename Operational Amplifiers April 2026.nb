   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "Ca"], "+", 
      FractionBox["1", "Cb"]}], ")"}], 
    RowBox[{"-", "1"}]]}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "8.2", " ", "nF", " ", "in", " ", "series", " ", "with", " ", "15", " ", 
     "nF"}], " ", "=", " ", 
    RowBox[{"5.3017", " ", "nF"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.969730677997881*^9, 3.969730903734726*^9}, {
