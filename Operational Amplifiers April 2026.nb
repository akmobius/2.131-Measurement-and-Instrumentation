Cell[CellGroupData[{

Cell["Instrumentation amplifiers", "Subsubsection",
 CellChangeTimes->{
  3.9861239519033203`*^9},ExpressionUUID->"6fb02be0-dd14-450f-aaba-\
0eb0a00fabf0"],

Cell["\<\
Instrumentation amps (INA\[CloseCurlyQuote]s) are a much smaller market than \
op amps. The selection axes are: (1) gain-setting method (single resistor vs \
digitally programmable vs fixed), (2) input common-mode range relative to \
supply, (3) DC accuracy (V\:2092\:209b, drift, CMRR at gain), and (4) noise. \
The list below covers what\[CloseCurlyQuote]s actually used in the lab.\
\>", "Text",
 CellChangeTimes->{
  3.9861239635956507`*^9, {3.986132866527182*^9, 
   3.986132870855508*^9}},ExpressionUUID->"7c45f667-4a91-4505-9310-\
6845d636a93e"],

