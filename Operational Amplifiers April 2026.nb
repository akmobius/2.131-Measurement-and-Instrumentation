Cell["R is commonly some value between 10 k\[CapitalOmega] and 100 k\
\[CapitalOmega].", "Text",
 CellChangeTimes->{
  3.968755658635635*^9},ExpressionUUID->"e7bacbf8-1c52-41da-8627-\
006887f15bfe"],

Cell["\<\
A good general purpose 10 V precision voltage reference is the Ref01 made by \
Analog Devices.
A selection of different types of voltage references is given at the end of \
these notes.\
\>", "Text",
 CellChangeTimes->{
  3.968755673445854*^9, {3.986132403764484*^9, 
   3.986132432550419*^9}},ExpressionUUID->"abaa23cd-0eee-4bff-aae9-\
3d590617065f"]
}, Open  ]],

