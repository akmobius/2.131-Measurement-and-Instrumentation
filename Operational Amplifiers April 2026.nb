Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "out"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fa1a607-0b99-46da-8cd5-063e8e69e0d2"],
 "  = ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0590c161-36ec-4947-8d6b-0848db9c5225"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", 
     SubscriptBox["V2", "in"]}]}], TraditionalForm]],ExpressionUUID->
  "c9973012-7092-4c5e-aade-da0b21416af5"],
 " -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["V1", "in"]}], TraditionalForm]],ExpressionUUID->
  "488a3224-10dc-4de2-8253-d3e0c2a4cb0b"],
 ")"
}], "Text",
 CellChangeTimes->{{3.968755882704426*^9, 3.968755915171344*^9}, {
  3.9687561566902*^9, 
  3.968756163772751*^9}},ExpressionUUID->"6f599681-c727-4a38-a3cd-\
f7a45a7f7fbd"],

Cell["where the instrumentation amplifier gain, G is", "Text",
 CellChangeTimes->{
  3.9687561943112993`*^9},ExpressionUUID->"fdd144e8-d9b6-4398-bb65-\
d690b6fbb016"],

Cell[TextData[{
 "G = 1 + 2 ",
 Cell[BoxData[
  FormBox[
   FractionBox["R", 
    RowBox[{
     SuperscriptBox["\[InvisiblePrefixScriptBase]", "R"], "G"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48a8e60a-52e9-43bc-9323-36246a5896f5"]
}], "Text",
 CellChangeTimes->{{3.968756206446327*^9, 
  3.9687562851678658`*^9}},ExpressionUUID->"abd2cc2d-7974-4e73-990d-\
66d5211f96a6"],

Cell[TextData[{
 "A good general purpose low cost instrumentation amplifier is the Amp02 made \
by Analog Devices.\nThe Amp02 has a common mode rejection ratio (CMRR) of \
nearly ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "6"], TraditionalForm]],ExpressionUUID->
  "336723ff-9217-44f4-bbce-cee488d9adcf"],
 " at low frequencies.\nA selection of suggested instrumentation amps is \
given near the end of these notes."
}], "Text",
 CellChangeTimes->{{3.968756302494811*^9, 3.9687563212885027`*^9}, {
  3.986132900328967*^9, 
  3.986132944160287*^9}},ExpressionUUID->"cb0af352-53de-49a5-92d2-\
03f63bb2512f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["First-Order Low-Pass Filter", "Subsubsection",
 CellChangeTimes->{
  3.9687563447912807`*^9},ExpressionUUID->"4a83e3cc-f3ee-4cd9-b2ba-\
20286f86e74e"],

Cell["\<\
The inverting amplifier may be modified into a first-order, low-pass filter \
by the addition of a capacitor in the feedback loop.\
\>", "Text",
 CellChangeTimes->{{3.9687563732282963`*^9, 
  3.968756399651273*^9}},ExpressionUUID->"7d212f61-3c5b-4109-99d7-\
8b2bb5f097ce"],

