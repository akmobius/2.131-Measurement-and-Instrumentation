Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "out"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f6a65a0-ebec-4ede-a67f-81a06d555c85"],
 "  = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["R1", "R2"]}], 
    SubscriptBox["V", "in"]}], TraditionalForm]],ExpressionUUID->
  "bddb4af6-92f3-4c48-9626-2d07316d93af"]
}], "Text",
 CellChangeTimes->{{3.968754799051714*^9, 
  3.968754810675581*^9}},ExpressionUUID->"f34269d0-1d73-4ad7-b660-\
8ba8c9a8401a"],

Cell["\<\
Note that the magnitude of the gain can be greater than 1, equal to 1 (if R1 \
= R2) or less than 1.\
\>", "Text",
 CellChangeTimes->{{3.968754833143277*^9, 
  3.968754841832429*^9}},ExpressionUUID->"ff5d5525-537e-44d8-be00-\
1c57ec502944"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Variable Gain (from -1 to 1) Amplifier", "Subsubsection",
 CellChangeTimes->{
  3.968754866579616*^9},ExpressionUUID->"5f1cdcba-4f57-4ef1-80c2-\
85063e73be4b"],

Cell["\<\
Sometimes it is necessary to attenuate a signal with a gain which between -1 \
and 1. The following simple yet beautiful circuit achieves this.\
\>", "Text",
 CellChangeTimes->{{3.968754882626534*^9, 
  3.968754887235962*^9}},ExpressionUUID->"b7aecc73-8dad-4a4f-84ad-\
fdae7cbead0e"],

