    BoxForm`ImageTag["Byte", ColorSpace -> "RGB", Interleaving -> True],
    Selectable->False],
   DefaultBaseStyle->"ImageGraphics",
   ImageSize->Automatic,
   ImageSizeRaw->{302.1, 150.},
   PlotRange->{{0, 302.1}, {0, 150.}}]], "Input",ExpressionUUID->
  "615099cf-8e53-4cf4-ae59-491affec5a84"],
 "\n\nwhere Z1, Z2, Z3 and Z4 can each be any parallel or series combination \
of resistors, capacitors and inductors. By choosing what Z1, Z2, Z3, and Z4 \
are we can design a variety of second-order filters (low-pass, high-pass, \
band-pass and band-stop).\nFrom ",
 ButtonBox["https://upload.wikimedia.org/wikipedia/commons/e/e3/Sallen-Key_\
Generic _Circuit.svg",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://upload.wikimedia.org/wikipedia/commons/e/e3/Sallen-Key_\
Generic_Circuit.svg"], None},
  ButtonNote->
   "https://upload.wikimedia.org/wikipedia/commons/e/e3/Sallen-Key_Generic_\
Circuit.svg"],
 "\nThe general transfer function is:\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"tf", "[", "s_", "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{"z3", "[", "s", "]"}], 
      RowBox[{"z4", "[", "s", "]"}]}], 
     RowBox[{
      RowBox[{
       RowBox[{"z1", "[", "s", "]"}], " ", 
       RowBox[{"z2", "[", "s", "]"}]}], " ", "+", 
      RowBox[{
       RowBox[{"z3", "[", "s", "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z1", "[", "s", "]"}], "+", 
         RowBox[{"z2", "[", "s", "]"}]}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"z3", "[", "s", "]"}], " ", 
       RowBox[{"z4", "[", "s", "]"}]}]}]]}], "\n"}]], "Input",
  CellChangeTimes->{{3.794933436496151*^9, 3.794933513012993*^9}, {
    3.7949335491461353`*^9, 3.794933612080341*^9}, 3.794933874712912*^9, 
    3.794934357249836*^9, 3.794946497236697*^9},ExpressionUUID->
  "1045d0e4-2331-48e1-ac7b-848818606d12"],
 "\n",
 Cell[BoxData[
