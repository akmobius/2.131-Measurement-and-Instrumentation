   FractionBox["R1", "R2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "97b8037b-59e4-4e2b-97b0-22b74e87e74d"],
 "  and the time constant, \[Tau]  = R1 C"
}], "Text",
 CellChangeTimes->{{3.9687564385041103`*^9, 
  3.968756528726584*^9}},ExpressionUUID->"5b706ea5-2bcb-44ae-a2d2-\
4ef14c85f2d0"],

Cell[TextData[{
 "The cut-off frequency, (frequency at which the gain is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"G", " "}], 
    RowBox[{" ", 
     SqrtBox["2"]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ead0a21f-7b29-4054-a052-992b19e099f2"],
 "  =  0.7071 G    or  3 dB down)   =   ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[Tau]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1b86174b-23d7-4ab4-8138-63391a2179f0"],
 " rads/s\nThe transfer function is \nH(s) = ",
 Cell[BoxData[
  FormBox[
   FractionBox["G", 
    RowBox[{
     RowBox[{"\[Tau]", " ", "s"}], " ", "+", " ", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0edea709-79ba-4496-9490-814d5e306849"],
 "\n\nFor example if  R1  = 100 k\[CapitalOmega] ,  R2 = 10 k\[CapitalOmega], \
  C = 10 nF  then  G = -",
 Cell[BoxData[
  FormBox[
   FractionBox["R1", "R2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e1e1d49-b99a-4add-bdb2-d0f97ccf47b2"],
 " = -10   and  \[Tau] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"R1", " ", "C"}], " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4b1e2dc1-d666-4c07-ad88-b6eeb498e0b7"],
 "s  =  1 ms"
}], "Text",
 CellChangeTimes->{
  3.968756551824008*^9, {3.968761956409994*^9, 3.96876209136587*^9}, {
   3.968762720683753*^9, 
   3.96876307299711*^9}},ExpressionUUID->"4643cd0c-5e11-4db3-a705-\
51c949ea768d"],

Cell[TextData[{
 "The transfer function is  H(s) = ",
 Cell[BoxData[
  FormBox[
   FractionBox["G", 
    RowBox[{
     RowBox[{"\[Tau]", " ", "s"}], " ", "+", " ", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f92b8db2-7259-4416-ac3a-8dcea009ea48"],
 "  = ",
 Cell[BoxData[
  FormBox[
   FractionBox["5", 
    RowBox[{
     RowBox[{"0.001", " ", "s"}], " ", "+", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0fb82dec-6e4a-4c7e-862e-5216f9744ee6"]
}], "Text",
 CellChangeTimes->{{3.968763083315569*^9, 
  3.968763135759635*^9}},ExpressionUUID->"e638cfb7-fdc9-427b-b886-\
eb53b9ce6c13"],

Cell["\<\
Note that because the gain is negative (remember this low-pass filter design \
is a modification of the inverting amplifier) the phase starts at 180 instead \
of 0 deg.\
\>", "Text",
 CellChangeTimes->{{3.968763219755416*^9, 
  3.968763224891609*^9}},ExpressionUUID->"214fd9ad-ac6f-473b-a91e-\
8a451bfab500"],

Cell["\<\
The general equation for the transfer function of a first-order low-pass \
filter is:\
\>", "Text",
 CellChangeTimes->{{3.795798108024832*^9, 3.7957981519245596`*^9}, {
  3.968766434115527*^9, 
  3.968766435032123*^9}},ExpressionUUID->"742392bf-eed0-4b12-a266-\
73ba95955ec3"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"s_", ",", "\[Alpha]_", ",", "\[Omega]_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"\[Alpha]", " ", "\[Omega]"}], 
    RowBox[{"s", "+", "\[Omega]"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.795798156957447*^9, 3.7957982612023764`*^9}, 
   3.795811951276453*^9, {3.9687663962860813`*^9, 3.96876642612199*^9}},
 CellLabel->
  "In[1242]:=",ExpressionUUID->"5c370e35-2c8f-4cac-b854-a80be2862d1c"],

Cell["\<\
where the static gain is \[Alpha], the \[OpenCurlyDoubleQuote]cut-off\
\[CloseCurlyDoubleQuote] frequency (in radians/s) is \[Omega] = 1/\[Tau].\
\>", "Text",
 CellChangeTimes->{{3.795807739015408*^9, 3.795807789760621*^9}, {
  3.968766448305517*^9, 3.9687664620606737`*^9}, {3.968770116205327*^9, 
  3.9687701235367823`*^9}},ExpressionUUID->"c4a3ec61-b5cd-49ee-9ae8-\
563e065119db"],

Cell[CellGroupData[{

