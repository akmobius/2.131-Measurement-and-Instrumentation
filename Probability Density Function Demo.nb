Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Histogram", ",", "PDF", ",", 
    RowBox[{"and", " ", "CDF", " ", "Interactive", " ", "Demonstration"}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Multiple", " ", "signal", " ", "types"}], "+", 
    RowBox[{"sort", " ", "button"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nSamples", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fs", "=", "50000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vMin", "=", 
     RowBox[{"-", "4"}]}], ";", 
    RowBox[{"vMax", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"binWidths", "=", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.1", ",", "0.2", ",", "0.5", ",", "1.0"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"signalModes", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<gauss\>\"", ",", "\"\<sin\>\"", ",", "\"\<binary\>\"", 
       ",", "\"\<laplace\>\"", ",", "\"\<expon\>\""}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"Generate", " ", "all", " ", "signals"}], "==="}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"xData", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<gauss\>\"", "->", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", "1"}], "]"}], ",", "nSamples"}], "]"}]}], ",", 
       RowBox[{"\"\<sin\>\"", "->", 
        RowBox[{"N", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"2", " ", "Pi", " ", "100", " ", 
              RowBox[{"k", "/", "fs"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"nSamples", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
       RowBox[{"\"\<binary\>\"", "->", 
        RowBox[{"N", "@", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"2", " ", 
                RowBox[{"RandomChoice", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], ",", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"{", 
                 RowBox[{"50", ",", "200"}], "}"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", "200", "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "nSamples"}], "]"}], "]"}]}]}], ",", 
       RowBox[{"\"\<laplace\>\"", "->", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"LaplaceDistribution", "[", 
           RowBox[{"0", ",", 
            RowBox[{"1", "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], ",", "nSamples"}], 
         "]"}]}], ",", 
       RowBox[{"\"\<expon\>\"", "->", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"ExponentialDistribution", "[", "1", "]"}], ",", 
          "nSamples"}], "]"}]}]}], "|>"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xLabels", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<gauss\>\"", 
        "->", "\"\<Gaussian (\[Mu]=0, \[Sigma]=1 V)\>\""}], ",", 
       RowBox[{"\"\<sin\>\"", "->", "\"\<Sinusoid (100 Hz, A=2 V)\>\""}], ",", 
       RowBox[{"\"\<binary\>\"", "->", "\"\<Binary (\[PlusMinus]2 V)\>\""}], ",", 
       RowBox[{"\"\<laplace\>\"", 
        "->", "\"\<Laplace (\[Mu]=0, b=1/\[Sqrt]2)\>\""}], ",", 
       RowBox[{"\"\<expon\>\"", "->", "\"\<Exponential (\[Lambda]=1)\>\""}]}],
       "|>"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Clip", " ", "display", " ", "values"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"clipV", "[", "v_", "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{"vMin", ",", "vMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xPtsU", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sm", "->", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"nSamples", "-", "1"}]}], "]"}], ",", 
            RowBox[{"clipV", "/@", 
             RowBox[{"xData", "[", "sm", "]"}]}]}], "}"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"sm", ",", "signalModes"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"xPtsS", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sm", "->", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"nSamples", "-", "1"}]}], "]"}], ",", 
            RowBox[{"clipV", "/@", 
             RowBox[{"Sort", "[", 
              RowBox[{"xData", "[", "sm", "]"}], "]"}]}]}], "}"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"sm", ",", "signalModes"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Theoretical", " ", 
     RowBox[{"PDF", "/", "CDF"}], " ", "curves"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sinPdfPts", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "v", "]"}], "<", "1.999"}], ",", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"Pi", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"4", "-", 
                RowBox[{"v", "^", "2"}]}], "]"}]}], ")"}]}], ",", "0"}], 
          "]"}], ",", "v"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", 
         RowBox[{"-", "1.999"}], ",", "1.999", ",", "0.005"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sinCdfPts", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "2"}], "+", 
          RowBox[{
           RowBox[{"ArcSin", "[", 
            RowBox[{"v", "/", "2"}], "]"}], "/", "Pi"}]}], ",", "v"}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", 
         RowBox[{"-", "1.999"}], ",", "1.999", ",", "0.005"}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pdfCurves", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<gauss\>\"", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PDF", "[", 
             RowBox[{
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", "1"}], "]"}], ",", "v"}], "]"}], ",", "v"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vMin", ",", "vMax", ",", "0.02"}], "}"}]}], 
         "]"}]}], ",", 
       RowBox[{"\"\<sin\>\"", "->", "sinPdfPts"}], ",", 
       RowBox[{"\"\<binary\>\"", "->", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"\"\<laplace\>\"", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PDF", "[", 
             RowBox[{
              RowBox[{"LaplaceDistribution", "[", 
               RowBox[{"0", ",", 
                RowBox[{"1", "/", 
                 RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], ",", "v"}], 
             "]"}], ",", "v"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vMin", ",", "vMax", ",", "0.02"}], "}"}]}], 
         "]"}]}], ",", 
       RowBox[{"\"\<expon\>\"", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v", ">=", "0"}], ",", 
              RowBox[{"PDF", "[", 
               RowBox[{
                RowBox[{"ExponentialDistribution", "[", "1", "]"}], ",", 
                "v"}], "]"}], ",", "0"}], "]"}], ",", "v"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vMin", ",", "vMax", ",", "0.02"}], "}"}]}], 
         "]"}]}]}], "|>"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cdfCurves", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<gauss\>\"", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"CDF", "[", 
             RowBox[{
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", "1"}], "]"}], ",", "v"}], "]"}], ",", "v"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vMin", ",", "vMax", ",", "0.02"}], "}"}]}], 
         "]"}]}], ",", 
       RowBox[{"\"\<sin\>\"", "->", "sinCdfPts"}], ",", 
       RowBox[{"\"\<binary\>\"", "->", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"\"\<laplace\>\"", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"CDF", "[", 
             RowBox[{
              RowBox[{"LaplaceDistribution", "[", 
               RowBox[{"0", ",", 
                RowBox[{"1", "/", 
                 RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], ",", "v"}], 
             "]"}], ",", "v"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vMin", ",", "vMax", ",", "0.02"}], "}"}]}], 
         "]"}]}], ",", 
       RowBox[{"\"\<expon\>\"", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"CDF", "[", 
             RowBox[{
              RowBox[{"ExponentialDistribution", "[", "1", "]"}], ",", "v"}], 
             "]"}], ",", "v"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vMin", ",", "vMax", ",", "0.02"}], "}"}]}], 
         "]"}]}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Histograms", " ", "per", " ", "signal", " ", "and", " ", "bin", " ", 
     "width"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"histAll", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sm", "->", 
