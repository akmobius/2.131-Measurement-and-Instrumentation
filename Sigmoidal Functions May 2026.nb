 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f7", "[", "x_", "]"}], ":=", 
   FractionBox["x", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"Abs", "[", "x", "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
