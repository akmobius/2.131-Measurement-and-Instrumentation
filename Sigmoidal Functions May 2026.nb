Cell["\<\
The slope of this function at 0 is 1. But if we also want it to produce \
values which go from -1 to 1 then we modify it:\
\>", "Text",
 CellChangeTimes->{{3.784813856318081*^9, 3.784813907487045*^9}, {
  3.7848141370490456`*^9, 
  3.784814137814498*^9}},ExpressionUUID->"0c8daf77-7839-45bd-9d10-\
898d67266efd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f2", "[", "x_", "]"}], ":=", 
   RowBox[{
    FractionBox["2", "\[Pi]"], 
    RowBox[{"ArcTan", "[", 
     RowBox[{
      FractionBox["\[Pi]", "2"], "x"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f2", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<f[x]\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", 
    "\"\<\!\(\*FractionBox[\(2\), \
\(\[Pi]\)]\)ArcTan[\!\(\*FractionBox[\(\[Pi]\), \(2\)]\)x]\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.784813993394031*^9, 3.784814039249844*^9}, {
   3.7848143402209806`*^9, 3.784814361217389*^9}, {3.784814396882306*^9, 
