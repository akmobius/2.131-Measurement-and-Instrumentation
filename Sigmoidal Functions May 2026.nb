Cell[CellGroupData[{

Cell["Error function", "Subsubsection",
 CellChangeTimes->{{3.7848117887627344`*^9, 
  3.784811791483763*^9}},ExpressionUUID->"2f6bbff3-c96d-45f0-a0f2-\
1c7dbe65e0bf"],

Cell[TextData[{
 "The error function (see ",
 ButtonBox["https://en.wikipedia.org/wiki/Error_function",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Error_function"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Error_function"],
 "  ), Erf[x], is the integral of the Gaussian density function, given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"erf", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["2", 
      SqrtBox["\[Pi]"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "x"], 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"-", 
         SuperscriptBox["t", "2"]}]], "d", "\[InvisibleSpace]", "t"}]}]}]}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "f3f1ca14-d78d-4f42-a0dc-269ccf418355"],
 ". "
}], "Text",
 CellChangeTimes->{{3.784845470050391*^9, 3.784845505553863*^9}, {
  3.7848455393037777`*^9, 3.784845545398319*^9}, {3.784846193555282*^9, 
  3.784846213511471*^9}},ExpressionUUID->"8b494750-a16e-4728-99dc-\
746ea3cb77d4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f4", "[", "x_", "]"}], ":=", 
   RowBox[{"Erf", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f4", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<f[x]\>\""}], "}"}]}], ",", 
