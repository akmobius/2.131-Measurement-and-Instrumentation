      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"df", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"f2", "'"}], "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"df", "[", "0", "]"}]}], "Input",
 CellChangeTimes->{{3.784813625544548*^9, 3.784813698665322*^9}, {
   3.784813828171273*^9, 3.7848138308550615`*^9}, {3.784814062723115*^9, 
