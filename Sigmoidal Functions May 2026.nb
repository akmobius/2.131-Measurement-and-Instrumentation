Cell[" If we want the slope at 0 to be 1 then we modify it to :", "Text",
 CellChangeTimes->{{3.7848149376372333`*^9, 
  3.784814966832948*^9}},ExpressionUUID->"88ffdce8-71f1-4f3f-8f00-\
1cf408550904"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f4", "[", "x_", "]"}], ":=", 
   RowBox[{"Erf", "[", 
    RowBox[{
     FractionBox[
      SqrtBox["\[Pi]"], "2"], "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f4", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<f[x]\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", 
    "\"\<Erf[\!\(\*FractionBox[SqrtBox[\(\[Pi]\)], \(2\)]\)x]\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.784815011709876*^9, 3.7848150449500246`*^9}, 
   3.784815544119948*^9, 3.7848167443234415`*^9},
 CellLabel->
  "In[191]:=",ExpressionUUID->"a650dc18-0b12-49d7-9202-573691c5b98f"],

