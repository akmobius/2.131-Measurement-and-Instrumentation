Cell[CellGroupData[{

Cell["Tanh function", "Subsubsection",
 CellChangeTimes->{{3.784811738452515*^9, 
  3.784811748595894*^9}},ExpressionUUID->"06f2561d-963b-40fa-92c5-\
a551adf17e4b"],

Cell[TextData[{
 "The tanh function is defined by  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tanh", "(", "x", ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "x"}]], "-", "1"}], 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "x"}]], "+", "1"}]]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"039f0d46-1bd6-4f1c-ac8d-79c154649d33"]
}], "Text",
 CellChangeTimes->{{3.7848457217165546`*^9, 
  3.784845778421814*^9}},ExpressionUUID->"b07e8d15-5b85-402f-859e-\
28e39bc97d37"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f3", "[", "x_", "]"}], ":=", 
   RowBox[{"Tanh", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f3", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
