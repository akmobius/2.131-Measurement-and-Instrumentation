Cell[CellGroupData[{

Cell["Sigmoids", "Subsubsection",
 CellChangeTimes->{{3.784811057764207*^9, 
  3.784811060482317*^9}},ExpressionUUID->"5e0ce746-d2a2-4fc8-b340-\
921c3eff3834"],

Cell[TextData[{
 "A sigmoidal function has an \
\[OpenCurlyDoubleQuote]S\[CloseCurlyDoubleQuote] shape as seen below. There \
are a wide variety of functions that can be considered to be sigmoids (see ",
 ButtonBox["https://en.wikipedia.org/wiki/Sigmoid_function",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Sigmoid_function"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Sigmoid_function"],
 " ). Sigmoidal functions are used in muscle physiology to describe the \
relationship between the calcium ion concentration around the molecules (e.g. \
actin, myosin, troponin, tropomyosin)  inside a muscle fiber and the force \
they produce. The Gaussian probability distribution function has a sigmoidal \
form. \nHere are a number of sigmoidal functions"
}], "Text",
 CellChangeTimes->{{3.784811066717452*^9, 3.7848110707815046`*^9}, {
  3.784811120129481*^9, 3.7848114021690826`*^9}, {3.7848114438340015`*^9, 
  3.7848115120966234`*^9}, {3.7848116462961316`*^9, 3.784811655877562*^9}, {
  3.784845248427936*^9, 
  3.784845277012187*^9}},ExpressionUUID->"7f0a2227-93aa-4d1b-b9c1-\
cb320de4a92a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Logistic function", "Subsubsection",
 CellChangeTimes->{{3.7848116667385287`*^9, 
  3.7848116700237026`*^9}},ExpressionUUID->"38aefd5e-4f0b-4f02-8bba-\
dfd5a9862488"],

Cell[TextData[{
 "The logistic function (see ",
 ButtonBox[" https://en.wikipedia.org/wiki/Logistic_function",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Logistic_function"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Logistic_function"],
 " ), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Sigma]", "(", "x", ")"}], "\[LongEqual]", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"exp", "(", 
        RowBox[{"-", "x"}], ")"}]}], ")"}]}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"a95ee7cd-6140-4b70-b6e9-0048788acc26"],
 " is a solution to the differential equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "\[Prime]",
     MultilineFunction->None], "\[LongEqual]", 
    RowBox[{"y", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "y"}], ")"}]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"1f1d2a6b-b56e-493c-a3dc-2380eed0ccc4"],
 "."
}], "Text",
 CellChangeTimes->{{3.78484556272887*^9, 3.784845571737544*^9}, {
  3.784845614554598*^9, 3.784845635645732*^9}, {3.784846266488681*^9, 
  3.784846283071457*^9}},ExpressionUUID->"35dad841-cfcb-49dd-bbeb-\
392c75730e95"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
