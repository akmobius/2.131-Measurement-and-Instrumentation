Cell[CellGroupData[{

Cell["Gudermannian function", "Subsubsection",
 CellChangeTimes->{{3.78481194027503*^9, 
  3.784811947840896*^9}},ExpressionUUID->"9c156ba9-e370-4a9d-9911-\
2eead4421364"],

Cell[TextData[{
 "The Gudermannian function (see ",
 ButtonBox["https://en.wikipedia.org/wiki/Gudermannian_function",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Gudermannian_function"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Gudermannian_function"],
 " ), Gudermannian[x] =  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{
      SuperscriptBox["tan", 
       RowBox[{"-", "1"}]], "(", 
      SuperscriptBox["\[ExponentialE]", "x"], ")"}]}], "-", 
    RowBox[{"\[Pi]", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "aa54a86c-dc99-45fd-b4aa-c5b58992ddf1"]
}], "Text",
 CellChangeTimes->{{3.7848453845171185`*^9, 3.784845439494452*^9}, {
  3.784846134060317*^9, 
  3.7848461696414833`*^9}},ExpressionUUID->"a7b6aa1c-fd47-433f-8a32-\
3b7354c341f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f5", "[", "x_", "]"}], ":=", 
   RowBox[{"Gudermannian", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f5", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<f[x]\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Gudermannian[x]\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.784815098796993*^9, 3.784815125776123*^9}, {
   3.784815172837855*^9, 3.784815192468508*^9}, {3.784815269444698*^9, 
