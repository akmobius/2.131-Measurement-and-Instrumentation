Cell["Check that the slope at 0 is 1 :", "Text",
 CellChangeTimes->{{3.78481440918262*^9, 3.784814410416705*^9}, 
   3.784814785033659*^9},ExpressionUUID->"af2e5901-e445-44bb-a57f-\
b019d84ba834"],

