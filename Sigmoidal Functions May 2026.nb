Cell["Check that the slope at 0 is 1 :", "Text",
 CellChangeTimes->{{3.7848147243252296`*^9, 3.784814739082343*^9}, {
  3.784814900576618*^9, 
  3.784814901581574*^9}},ExpressionUUID->"b7729971-ae0e-46d5-b2c4-\
3fca6a117de3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"df", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"f3", "'"}], "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"df", "[", "0", "]"}]}], "Input",
 CellChangeTimes->{{3.784814199050977*^9, 3.784814207618927*^9}, 
   3.784815536616147*^9},
