Cell["\<\
If we want it to produce values that go from -1 to 1 and we want its slope at \
0 to be 1 then we modify it to :\
\>", "Text",
 CellChangeTimes->{{3.784815225182885*^9, 
  3.784815263116087*^9}},ExpressionUUID->"2f996d43-d803-4511-9cd3-\
e91932ea62d9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"f5", "[", "x_", "]"}], ":=", 
   RowBox[{
    FractionBox["2", "\[Pi]"], 
    RowBox[{"Gudermannian", "[", 
     RowBox[{
      FractionBox["\[Pi]", "2"], "x"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f5", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<f[x]\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", 
    "\"\<\!\(\*FractionBox[\(2\), \(\[Pi]\)]\)Gudermannian[\!\(\*FractionBox[\
\(\[Pi]\), \(2\)]\)x]\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.784815098796993*^9, 3.784815125776123*^9}, {
   3.784815172837855*^9, 3.784815192468508*^9}, 3.7848153248422422`*^9, 
   3.784815558935375*^9, {3.784815660354188*^9, 3.784815665777079*^9}, 
   3.784816753183863*^9},
