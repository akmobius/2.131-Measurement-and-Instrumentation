Cell["\<\
We can see that the data triplets {time,Ch1,Ch2} start at row 26 (count back \
from row 30):
So now we can import all the Ch2 (i.e., microphone) measurements:\
\>", "Text",
 CellChangeTimes->{{3.979821206136807*^9, 3.979821247256312*^9}, {
  3.979821296049584*^9, 3.979821307096778*^9}, {3.979821370665448*^9, 
  3.979821379924034*^9}, {3.979821590697476*^9, 
  3.9798216028108177`*^9}},ExpressionUUID->"821d40d2-2f5c-4e99-ba60-\
66a5a234d358"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"row", "=", "26"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "row", " ", "at", " ", "which", " ", "the", " ", "first", " ", "sample", " ",
     "occurs", " ", 
    RowBox[{"(", 
     RowBox[{
     "yours", " ", "may", " ", "be", " ", "slighlty", " ", "different", " ", 
      RowBox[{"(", 
       RowBox[{"check", " ", "to", " ", "see"}], ")"}]}], ")"}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
