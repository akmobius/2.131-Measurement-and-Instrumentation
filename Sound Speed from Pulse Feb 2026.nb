Cell["\<\
Mathematica allows us to access a huge data base of material properties, \
constants and physical equations. 
Lets ask for the speed of sound in air at 24 deg C (the temperature of my \
basement lab):\
\>", "Text",
 CellChangeTimes->{{3.9483810863843107`*^9, 3.948381176986947*^9}, 
   3.9798305071183033`*^9},ExpressionUUID->"88f97cb6-cea3-4e42-9177-\
e4a31e28f868"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"soundSpeedAirAt24degC", "=", 
   RowBox[{"ThermodynamicData", "[", 
    RowBox[{"\"\<Air\>\"", ",", " ", "\"\<SoundSpeed\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Temperature\>\"", " ", "->", " ", 
       TemplateBox[{
        "24", "\"\[Degree]C\"", "degrees Celsius", "\"DegreesCelsius\""},
        "Quantity"]}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.948386147399887*^9, 3.948386168850226*^9}, 
   3.966350645488969*^9, {3.97982940282661*^9, 3.9798294029449587`*^9}, {
   3.979830494047645*^9, 3.9798304946782103`*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"224ee618-65f7-4754-8ace-2fca743ff5dc"],

