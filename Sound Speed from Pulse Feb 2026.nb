Cell[TextData[{
 "There should be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "15"], TraditionalForm]],ExpressionUUID->
  "639d0025-39a9-4933-9615-57004a782fbe"],
 " = 32768 samples in each of the 5 signals. This is the Digilent Discovery 3 \
max buffer length (Option 2 selected before)."
}], "Text",
