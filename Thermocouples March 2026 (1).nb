Cell["\<\
We can check against the original data (but now we plot thermocouple \
temperature as a function of thermocouple voltage):\
\>", "Text",
 CellChangeTimes->{{3.949342419887645*^9, 3.949342430327805*^9}, {
  3.949344528058361*^9, 
  3.9493445662799683`*^9}},ExpressionUUID->"e0048173-987e-497b-ade9-\
ca4c1ac83fd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"typeKmV", ",", "typeKtemp"}], "}"}], "\[Transpose]"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}], ",", 
      RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Junction Voltage (mV)\>\"", 
         ",", "\"\<Temperature (\[Degree]C)\>\""}], "}"}]}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "\[Rule]", "\"\<Temperature vs Type K Thermocouple Voltage\>\""}], ",", 
      RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"interpolatingFnInv", "[", "v", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", 
        RowBox[{"typeKmV", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"typeKmV", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
