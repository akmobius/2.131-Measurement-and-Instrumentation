Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "the", " ", "residuals"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residuals6", "=", 
   RowBox[{"typeKmV", "-", 
    RowBox[{"(", 
     RowBox[{"fittedPolynomial6", " ", "/.", " ", 
      RowBox[{"t", "->", "typeKtemp"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9492600958260098`*^9, 3.949260165852276*^9}, {
   3.949260409211422*^9, 3.9492604873169823`*^9}, {3.949260811535562*^9, 
