Cell[CellGroupData[{

Cell["Fit 10th-Order Polynomial to Type K Thermocouple Data", "Subsubsection",
 CellChangeTimes->{{3.9492612679651127`*^9, 3.949261274737982*^9}, {
  3.949261326737483*^9, 
  3.949261327294096*^9}},ExpressionUUID->"09cdf584-ef7c-4028-b668-\
5c5281707e65"],

Cell["Lets fit an even higher order polynomial:", "Text",
 CellChangeTimes->{{3.94926063975082*^9, 3.9492606760970697`*^9}, 
   3.949260935934841*^9},ExpressionUUID->"0f059023-2fff-4387-8e84-\
56153cc62184"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Fit", " ", "a", " ", "10", "th", " ", "order", " ", "polynomial"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fittedPolynomial10", "=", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"typeKtemp", ",", "typeKmV"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "t", ",", 
       RowBox[{"t", "^", "2"}], ",", 
       RowBox[{"t", "^", "3"}], ",", 
       RowBox[{"t", "^", "4"}], ",", 
       RowBox[{"t", "^", "5"}], ",", 
       RowBox[{"t", "^", "6"}], ",", 
       RowBox[{"t", "^", "7"}], ",", 
       RowBox[{"t", "^", "8"}], ",", 
       RowBox[{"t", "^", "9"}], ",", 
       RowBox[{"t", "^", "10"}]}], "}"}], ",", "t"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9492600958260098`*^9, 3.949260186422534*^9}, {
   3.9492606861628304`*^9, 3.949260703957835*^9}, {3.9492607552403316`*^9, 
   3.949260777366045*^9}, 3.949261001262925*^9, {3.949261330776318*^9, 
   3.94926135193821*^9}, 3.949344438210005*^9},
 CellLabel->"In[61]:=",ExpressionUUID->"1411d4fc-466e-46ed-91f9-cbfbf3adc9f6"],

