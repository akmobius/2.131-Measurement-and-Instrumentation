Cell[CellGroupData[{

Cell["Determine the Inverse Function (Reversion)", "Subsubsection",
 CellChangeTimes->{{3.949342005825221*^9, 
  3.949342031653256*^9}},ExpressionUUID->"73588f0c-3a08-4cfc-be0b-\
bbeadcf3dc85"],

Cell["\<\
Once we have the interpolating function relating temperature to thermocouple \
voltage we can ask is there a way to do the reverse: namely to find a \
function that predicts temperature from thermocouple voltage. 
Yes, we can using InverseFunction[].

For example if we specify:\
\>", "Text",
 CellChangeTimes->{{3.9493420394895763`*^9, 3.949342137801407*^9}, {
  3.949342195029652*^9, 
  3.9493422142147093`*^9}},ExpressionUUID->"d400525c-6c62-4b9c-9760-\
f4e753315ffb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"InverseFunction", "[", "Sin", "]"}]}]], "Input",
 CellChangeTimes->{{3.949342217215638*^9, 3.949342233520588*^9}, 
   3.9493445145178833`*^9},
 CellLabel->"In[78]:=",ExpressionUUID->"07fcaf11-f7f7-4fd2-9f58-8251586ba658"],

Cell[BoxData["ArcSin"], "Output",
 CellChangeTimes->{3.949342235738317*^9, 3.981451522076025*^9, 
  3.981451924443549*^9, 3.9827558775625153`*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"5c9cf2a8-5876-3f4c-a0d3-5738d82d976e"]
}, Open  ]],

Cell["we get the expected ArcSin.", "Text",
 CellChangeTimes->{{3.949342243312834*^9, 3.94934225045424*^9}, 
   3.9493422814608383`*^9},ExpressionUUID->"37c2170a-91c2-4b0d-8987-\
dd5675eff19a"],

