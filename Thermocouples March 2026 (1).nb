Cell[CellGroupData[{

Cell["Fit 6th-Order Polynomial to Type K Thermocouple Data", "Subsubsection",
 CellChangeTimes->{{3.9492612679651127`*^9, 
  3.949261274737982*^9}},ExpressionUUID->"619340a3-8ffc-4b5c-b0ad-\
84d29d889d3c"],

Cell["Lets fit an even higher order polynomial:", "Text",
 CellChangeTimes->{{3.94926063975082*^9, 3.9492606760970697`*^9}, 
   3.949260935934841*^9},ExpressionUUID->"238feec5-830b-4b04-977e-\
d81024b1552c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Fit", " ", "a", " ", "6", "th", " ", "order", " ", "polynomial"}],
    " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fittedPolynomial6", "=", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"typeKtemp", ",", "typeKmV"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "t", ",", 
       RowBox[{"t", "^", "2"}], ",", 
       RowBox[{"t", "^", "3"}], ",", 
       RowBox[{"t", "^", "4"}], ",", 
       RowBox[{"t", "^", "5"}], ",", 
       RowBox[{"t", "^", "6"}]}], "}"}], ",", "t"}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.9492600958260098`*^9, 3.949260186422534*^9}, {
   3.9492606861628304`*^9, 3.949260703957835*^9}, {3.9492607552403316`*^9, 
   3.949260777366045*^9}, 3.949261001262925*^9, 3.94934441541434*^9},
 CellLabel->"In[53]:=",ExpressionUUID->"90106102-53c5-456d-b925-3e010cd06ca7"],

