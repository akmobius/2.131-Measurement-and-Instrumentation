        RowBox[{"\"\<Temperature (\[Degree]C)\>\"", 
         ",", "\"\<Junction Voltage (mV)\>\""}], "}"}]}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "\[Rule]", "\"\<Type K Thermocouple Voltage vs Temperature\>\""}], ",", 
      RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{"fittedPolynomial10", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "300"}], ",", "1400"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Black"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
