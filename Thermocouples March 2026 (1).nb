Cell["\<\
This is unacceptably high maximum error.
Lets try a second-order polynomial fit:\
\>", "Text",
 CellChangeTimes->{{3.94926063975082*^9, 3.9492606760970697`*^9}, 
   3.949260935934841*^9, 3.949261248849641*^9, {3.949323920883793*^9, 
   3.9493239342822723`*^9}},ExpressionUUID->"efadb5a6-38fa-4bf5-8677-\
ba8506b7dadc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fit 2nd-Order Polynomial to Type K Thermocouple Data", "Subsubsection",
 CellChangeTimes->{{3.9492599488584146`*^9, 3.949259968941594*^9}, {
  3.9492612197309847`*^9, 
  3.94926123199658*^9}},ExpressionUUID->"5c14938d-0dfa-4eab-9674-\
4a771213353a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Fit", " ", "a", " ", "quadratic", " ", "polynomial"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fittedPolynomial2", "=", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"typeKtemp", ",", "typeKmV"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "t", ",", 
       RowBox[{"t", "^", "2"}]}], "}"}], ",", "t"}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.9492600958260098`*^9, 3.949260186422534*^9}, {
   3.9492606861628304`*^9, 3.949260703957835*^9}, 3.949261009096202*^9, {
   3.949344385360002*^9, 3.949344395688979*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"cd0c9a52-df28-41f6-a06e-f61dec8320b7"],

