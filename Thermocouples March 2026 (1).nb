 CellChangeTimes->{{3.949233601033402*^9, 3.949233622064672*^9}},
 TextAlignment->Center,ExpressionUUID->"f56735db-15a8-4a5f-aed5-9cd6ad31deec"],

Cell[TextData[{
 "There are actually 4 voltages generated in the circuit above:\n1. the \
temperature difference between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "sense"], TraditionalForm]],ExpressionUUID->
  "684c4119-3676-4f3d-a650-bdb230e03abf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ref"], TraditionalForm]],ExpressionUUID->
  "8ce0cfc0-7bef-4727-aa54-483b785686a2"],
 " in the chromel wire gives rise to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "1"], TraditionalForm]],ExpressionUUID->
  "4249f0e4-0880-4523-897a-2a229a7b4a3f"],
 "\n2. the temperature difference between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "sense"], TraditionalForm]],ExpressionUUID->
  "40710fe8-0593-406e-a0d9-2bc6de999285"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ref"], TraditionalForm]],ExpressionUUID->
  "c7c72470-2820-43a1-9407-e4f572856c55"],
 " in the alumel wire gives rise to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "2"], TraditionalForm]],ExpressionUUID->
  "b9fc508e-23cc-42b9-9156-7c816810dc22"],
 "\n3. the temperature difference between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ref"], TraditionalForm]],ExpressionUUID->
  "dd35a985-0136-4665-bf49-903b7bd7f8f2"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "meter"], TraditionalForm]],ExpressionUUID->
  "5a2a9f41-f650-44b3-98a7-e7760315f107"],
 " in the upper copper wire gives rise to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "3"], TraditionalForm]],ExpressionUUID->
  "c9a6cc2f-77e9-411f-9782-a0b24b5a7052"],
 "\n4.  the temperature difference between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ref"], TraditionalForm]],ExpressionUUID->
  "174b4f30-7f56-4685-9c2f-f323d064e045"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "meter"], TraditionalForm]],ExpressionUUID->
  "b56a2c91-bc6a-44d3-8cb9-979111454bba"],
 " in the lower copper wire gives rise to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "4"], TraditionalForm]],ExpressionUUID->
  "2184efda-4c1f-4370-ba8e-afbaad3adacc"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "3"], TraditionalForm]],ExpressionUUID->
  "4d5f8654-a9e3-4ce7-a106-55a681a262bb"],
 " =  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "4"], TraditionalForm]],ExpressionUUID->
  "9b133c86-647f-4c25-9357-f937deb3ada7"],
 " and so they cancel out. It also means that the value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "meter"], TraditionalForm]],ExpressionUUID->
  "940b5ba2-6992-49ab-84a8-dbca58892328"],
 " does not matter. The value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ref"], TraditionalForm]],ExpressionUUID->
  "2f0e0055-bdb7-48e8-a6be-505bdd06b747"],
 " does matter and in a typical thermocouple circuit it is measured using a \
separate temperature sensor (typically a calibrated semiconductor temperature \
sensor). In the case of the NIST data analyzed below ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ref"], TraditionalForm]],ExpressionUUID->
  "0e4c8adf-cd67-43df-a0e5-761825e9ea7d"],
 " is an ice bath and so = 0 \[Degree]C. \nOnly ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "1"], TraditionalForm]],ExpressionUUID->
  "e9f8fb9e-59a6-4b47-b3de-4a2e30740d2d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "2"], TraditionalForm]],ExpressionUUID->
  "ec255fd6-8e9a-4e81-8f99-7093831b7fa5"],
 " contribute to the overall voltage, V.  For this reason it is common to \
think of the temperature measurement as only \[OpenCurlyDoubleQuote]coming\
\[CloseCurlyDoubleQuote] from the thermocouple bead temperature, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "sense"], TraditionalForm]],ExpressionUUID->
  "35733110-cb23-44f5-9f4f-acbb0b45a7ce"],
 " and not the rest of the thermocouple wire."
}], "Text",
 CellChangeTimes->{{3.949253022347803*^9, 3.949253173430773*^9}, {
  3.949254132020987*^9, 3.949254483979115*^9}, {3.94925453187193*^9, 
  3.949254565820168*^9}, {3.949254606141555*^9, 3.949254655581996*^9}, {
  3.949254742106782*^9, 3.949255114794691*^9}, {3.949255161720319*^9, 
  3.949255279247699*^9}, {3.949344342872438*^9, 
  3.949344354253829*^9}},ExpressionUUID->"e539670b-e474-47de-b7e0-\
703586847248"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Thermocouple Data", "Subsubsection",
 CellChangeTimes->{{3.949175232823084*^9, 
  3.9491752384774437`*^9}},ExpressionUUID->"e7b0c431-d1ef-46cd-91e5-\
4b4876aa9a64"],

Cell[TextData[{
 "NIST makes available raw thermocouple data. The measurement of thermocouple \
voltage was made by NIST using the circuit shown above with the 2 reference \
junctions sitting in an ice bath at 0 \[Degree]C (i.e.,",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    SubscriptBox["T", "ref"]}], TraditionalForm]],ExpressionUUID->
  "8a36abbf-b7e1-47d5-b974-c3fd104cb17d"],
 " = 0 \[Degree]C) .\n\nThe output voltage of this configuration is 0 V at 0 \
\[Degree]C (see plot below). NIST measured the voltage generated every 1 \
\[Degree]C increment over a range of temperatures they deemed reasonable for \
a range of different thermocouple types  (B, E, J, K, N, R, S, and T).\nNIST \
also provides the coefficients of high-order polynomials fitted to the data \
(both for T \[LongRightArrow] mV and for mV  \[LongRightArrow] T). \
Unfortunately such high-order polynomials lead to numerical errors both \
because of the high powers involved and often the very small values of the \
coefficients.\n\nIn the following we fit such higher-order polynomials, point \
out potential numerical problems and then show an alternative approach using \
interpolating functions  to get T \[LongRightArrow] mV  and their inverses to \
get mV  \[LongRightArrow] T ."
}], "Text",
 CellChangeTimes->{{3.9491752455878897`*^9, 3.9491754807844687`*^9}, {
  3.949233319748822*^9, 3.9492335207352*^9}, {3.9492336878856173`*^9, 
  3.949233787608273*^9}, {3.949233823553316*^9, 3.94923444209101*^9}, {
  3.949252473156365*^9, 3.949252575850944*^9}, {3.949255310840863*^9, 
  3.9492553821059504`*^9}, {3.949342705120652*^9, 3.9493428464580584`*^9}, {
  3.949343478565559*^9, 3.9493434814335423`*^9}, {3.949343518001495*^9, 
  3.949343519368387*^9}},ExpressionUUID->"c60f7d79-588b-485f-8138-\
ec94032d1f5d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Import NIST Thermocouple Data", "Subsubsection",
 CellChangeTimes->{{3.949252603798526*^9, 
  3.949252618377199*^9}},ExpressionUUID->"0396673f-341e-4ff6-b21f-\
169d79ab83f6"],

Cell["\<\
The data can be imported from NIST or from the following source in .csv file \
format. Here we Import[] in to the Mathematica Tabular data type which allows \
us to scroll through data sets in a spread-sheet like manner:\
\>", "Text",
 CellChangeTimes->{{3.949252632748616*^9, 3.949252675109666*^9}, {
  3.949255408459127*^9, 3.949255439391611*^9}, {3.9493428662144213`*^9, 
  3.949342915699967*^9}, {3.981452332712392*^9, 
  3.981452333568213*^9}},ExpressionUUID->"3c619942-a851-4e01-abda-\
423c21f3fd89"],

Cell["\<\
http://www.mosaic-industries.com/embedded-systems/microcontroller-projects/\
temperature-measurement/thermocouple/type-k-calibration-table\
\>", "Text",
 CellChangeTimes->{
  3.949176423908888*^9},ExpressionUUID->"90457c1c-ca4e-4014-8685-\
0466cedbfadb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{
  "file", "=", "\"\<C:\\Users\\ariel\\Downloads\\NIST Thermocouple Data.csv\>\
\""}], ";"}], "\n", 
 RowBox[{"data", "=", 
  RowBox[{"Import", "[", 
   RowBox[{"file", ",", "\"\<Tabular\>\""}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9491757955686493`*^9, 3.949175896398753*^9}, {
   3.9491760420308857`*^9, 3.949176042156972*^9}, {3.949176120254137*^9, 
   3.949176123963395*^9}, {3.94917651529986*^9, 3.949176526781348*^9}, 
