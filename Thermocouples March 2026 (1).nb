Cell["\<\
The fit now looks great but perhaps not significantly better than the 6th \
order fit?\
\>", "Text",
 CellChangeTimes->{{3.949260799025926*^9, 3.9492608077265453`*^9}, {
  3.94926138441726*^9, 
  3.9492614119044313`*^9}},ExpressionUUID->"6546c1d1-721b-4a46-9be0-\
