Cell["\<\
So as we can see our estimate of the Wiener system static nonlinearity, n1(\
\[CenterDot]),  is close to the actual static nonlinear element, n(\
\[CenterDot]).\
\>", "Text",
 CellChangeTimes->{{3.783719290990895*^9, 3.7837193991868715`*^9}, {
  3.783950954000724*^9, 3.783950954109677*^9}, {3.784031586066572*^9, 
  3.7840315934266877`*^9}},ExpressionUUID->"80c21e46-59cc-4b48-9864-\
9966fca24aac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict output", "Subsubsection",
 CellChangeTimes->{{3.784411958991873*^9, 
  3.7844119632125397`*^9}},ExpressionUUID->"f7155188-746b-4690-a50e-\
ba598eaa9ccf"],

Cell["\<\
Now that we have the estimate, n1(\[CenterDot]), we can predict the output, \
y1(t), from our u1(t) estimate:\
\>", "Text",
 CellChangeTimes->{{3.783767802005376*^9, 
  3.783767885369144*^9}},ExpressionUUID->"d3e61f28-1207-4e4c-aa19-\
abfba9753a08"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"y1", "=", 
   RowBox[{"n1", "[", "u1", "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ti", ",", "y1"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
