Cell["\<\
So as we can see our estimate of the Wiener system static nonlinearity, n2(\
\[CenterDot]),  is very close to the actual static nonlinear element, n(\
\[CenterDot]).\
\>", "Text",
 CellChangeTimes->{{3.783719290990895*^9, 3.7837193991868715`*^9}, {
   3.783950954000724*^9, 3.783950954109677*^9}, {3.783986735042588*^9, 
   3.783986735136224*^9}, 
   3.784032340413211*^9},ExpressionUUID->"9c42b817-7847-49b8-86e6-\
d96a7da25085"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict the output", "Subsubsection",
 CellChangeTimes->{{3.784411890726039*^9, 
  3.7844118935685244`*^9}},ExpressionUUID->"af40a10e-0ad8-40ec-b5cc-\
06e4894ad2e0"],

Cell["\<\
Now that we have the new estimate, n2(\[CenterDot]), we can predict the \
output, y2(t), from our u3(t) estimate:\
\>", "Text",
 CellChangeTimes->{{3.783767802005376*^9, 3.783767885369144*^9}, {
  3.7839867765582356`*^9, 
  3.78398678676464*^9}},ExpressionUUID->"9798e0a0-ffdc-4fc4-a50a-\
080f1266dda0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"y2", "=", 
   RowBox[{"n2", "[", "u3", "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ti", ",", "y2"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
