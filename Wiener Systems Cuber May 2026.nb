Cell["\<\
This is the system continuous (or symbolic) unit impulse response function \
which we will denote h in order to distinguish it from the sampled version \
(see below) which we will denote, h. We also denote the continuous lag domain \
by \[Tau] to distinguish it from the sampled version  (see below) which is \
denoted by \[Tau]i.\
\>", "Text",
 CellChangeTimes->{{3.7805211038938465`*^9, 3.780521137385879*^9}, {
  3.7806007890200195`*^9, 3.780600790097852*^9}, {3.780658828039255*^9, 
  3.780658829819742*^9}, {3.783947569834304*^9, 3.783947605292026*^9}, {
  3.783947794455504*^9, 3.783947877742697*^9}, {3.7840300778331175`*^9, 
  3.7840301092711897`*^9}},ExpressionUUID->"d558c393-4d7e-4d53-a023-\
993b3d7c3e2b"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"\[Tau]_", ",", "\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], 
    "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Zeta]"}], " ", "\[Tau]", " ", "\[Omega]"}]], " ", 
     "\[Alpha]", " ", "\[Omega]", " ", 
     RowBox[{"Sinh", "[", 
      RowBox[{
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["\[Zeta]", "2"]}]], " ", "\[Tau]", " ", "\[Omega]"}], 
      "]"}]}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[Zeta]", "2"]}]]]}]}]], "Input",
 CellChangeTimes->{{3.780521060934205*^9, 3.780521076727903*^9}, {
   3.7805770350457377`*^9, 3.780577046390332*^9}, {3.780658840161008*^9, 
