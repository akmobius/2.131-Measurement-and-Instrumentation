Cell[CellGroupData[{

Cell["Convolve, h(\[Tau]), with x(t) to produce, u(t)", "Subsubsection",
 CellChangeTimes->{{3.7824011341765585`*^9, 3.7824011484232025`*^9}, {
  3.782401184836568*^9, 3.782401189241764*^9}, {3.783700767065414*^9, 
  3.783700792788222*^9}, {3.783716461076644*^9, 
  3.783716465359772*^9}},ExpressionUUID->"00063707-4891-4ce4-b106-\
7f431ee74b92"],

Cell["\<\
We now numerically convolve our sampled input, x(t), with the sampled version \
of our impulse response function, h(\[Tau]), to generate the internal signal, \
u(t):\
\>", "Text",
 CellChangeTimes->{{3.782413976611094*^9, 3.7824140675477753`*^9}, {
  3.782561624936803*^9, 3.782561716794967*^9}, {3.7837128979241686`*^9, 
  3.783712906441495*^9}, {3.783712937383318*^9, 3.7837129774571385`*^9}, {
  3.783948960187085*^9, 
  3.783949059625407*^9}},ExpressionUUID->"39e7e822-d2ee-4abe-835f-\
209b75027057"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"u", "=", 
   RowBox[{"\[CapitalDelta]t", " ", 
    RowBox[{"ListConvolve", "[", 
     RowBox[{"hi", ",", "x", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], " ", ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "x"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "u"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
