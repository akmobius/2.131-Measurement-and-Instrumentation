Cell["\<\
The prediction is not at all that good. Lets calculate the residuals, r1(t):\
\>", "Text",
 CellChangeTimes->{{3.7837679072050567`*^9, 3.783767961565934*^9}, {
  3.784412127998342*^9, 
  3.784412151896059*^9}},ExpressionUUID->"050be084-dc05-4fb8-ba55-\
66389f6803f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"r1", "=", 
   RowBox[{"y", "-", "u1"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "r1"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
