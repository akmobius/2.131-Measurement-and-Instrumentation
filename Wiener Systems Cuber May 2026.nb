Cell[TextData[{
 "This is a remarkable result!! It shows that despite the presence of a major \
static nonlinearity such as a cuber, the stochastic system identification \
techniques were able to nevertheless get an estimate of the Wiener system\
\[CloseCurlyQuote]s dynamic linear element. This amazing result (for the case \
of cross-correlation) seems to have been first discovered by Julian Bussgang \
(",
 ButtonBox["https://en.wikipedia.org/wiki/Julian_J._Bussgang",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Julian_J._Bussgang"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Julian_J._Bussgang"],
 ") in 1951 during his Master\[CloseCurlyQuote]s thesis research when he was \
a student at the Research Lab for Electronics (RLE) at MIT (",
 ButtonBox["https://en.wikipedia.org/wiki/Bussgang_theorem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Bussgang_theorem"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Bussgang_theorem"],
 ")."
}], "Text",
 CellChangeTimes->{{3.78371738062884*^9, 3.783717517016073*^9}, {
  3.783717828149418*^9, 3.783717854303652*^9}, {3.783717885186178*^9, 
  3.783717914030853*^9}, {3.783717953336012*^9, 3.783717964170323*^9}, {
  3.7837179962798457`*^9, 3.783718092315293*^9}, {3.7837181431238804`*^9, 
  3.7837181547528276`*^9}, {3.783718188306381*^9, 3.7837182057636027`*^9}, {
  3.783718257333372*^9, 
  3.783718257786672*^9}},ExpressionUUID->"5f5670bb-880e-4aa0-a81c-\
cdb3a8f96fba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict u(t)", "Subsubsection",
 CellChangeTimes->{{3.783717796126632*^9, 
  3.783717804457378*^9}},ExpressionUUID->"7f0d029b-0b9b-49c2-b344-\
a792f8be6566"],

Cell["\<\
Now that we have h1(\[Tau]), we can convolve it with the input, x(t), to \
produce a prediction of the output but as we will shortly be assuming that \
the system is possibly a Wiener system this prediction can also be thought of \
as a prediction, u1(t), of the internal signal, u(t):\
\>", "Text",
 CellChangeTimes->{{3.783717815751061*^9, 3.7837178182156763`*^9}, {
  3.783718267880698*^9, 3.783718324735853*^9}, {3.784411772047218*^9, 
  3.784411849702398*^9}, {3.784412046056183*^9, 
  3.784412046556415*^9}},ExpressionUUID->"036c000b-9aea-486e-8e5b-\
287225b7605f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"u1", "=", 
   RowBox[{"\[CapitalDelta]t", " ", 
    RowBox[{"ListConvolve", "[", 
     RowBox[{"hi1", ",", "x", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti", ",", "u1"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.3"}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Wiener System Output, y(t) (blue) and Prediction u1(t) \
(blue)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.78371834797988*^9, 3.783718351147012*^9}, {
   3.783878813286706*^9, 3.783878816129774*^9}, 3.7840315046686997`*^9, {
