Cell["\<\
Notice that there is now much less scatter. This suggests that we are getting \
closer to want might be the true shape of the static nonlinearity.
We can find an approximation to the new estimate, n2(\[CenterDot]) by fitting \
a high order polynomial (again with only odd powers) to the u3(t) vs y(t) \
cross-plot:\
\>", "Text",
 CellChangeTimes->{{3.783767708140251*^9, 3.783767783297245*^9}, {
  3.7838862731778*^9, 3.7838862790712776`*^9}, {3.783892429545247*^9, 
  3.783892443624403*^9}, {3.783986569983921*^9, 3.78398659962346*^9}, {
  3.7840322489019823`*^9, 3.784032302742878*^9}, {3.784053132355072*^9, 
  3.784053145218618*^9}},ExpressionUUID->"7b0be356-cad4-4fc0-ae92-\
6e212851f02b"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"n2", "=", 
   RowBox[{
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u3", ",", "y"}], "}"}], "\[Transpose]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", "uu", ",", 
        SuperscriptBox["uu", "3"], ",", 
        SuperscriptBox["uu", "5"], ",", 
        SuperscriptBox["uu", "7"], ",", 
        SuperscriptBox["uu", "9"]}], "}"}], ",", "uu"}], "]"}], 
    "[", "\"\<Function\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.783890424793599*^9, {3.7838915351732826`*^9, 3.783891554464476*^9}, 
   3.783891696049228*^9, {3.7839866063278747`*^9, 3.7839866107363644`*^9}, 
   3.784053114570986*^9},
 CellLabel->
  "In[114]:=",ExpressionUUID->"2109712b-f530-493f-8a13-a1881fdf2106"],

Cell["\<\
Lets plot this estimate, n2(\[CenterDot]), of the nonlinearity together with \
the cross-plot of u3(t) vs y(t):\
\>", "Text",
 CellChangeTimes->{{3.783718675464451*^9, 3.783718706893976*^9}, {
  3.783768741616623*^9, 3.783768749179517*^9}, {3.7838923005098767`*^9, 
  3.78389231160559*^9}, {3.7839866219567895`*^9, 
  3.783986628863921*^9}},ExpressionUUID->"92a93221-2901-432e-b9c8-\
fff698242342"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u3", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
       RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<u1 amplitude\>\"", ",", "\"\<y amplitude\>\""}], 
         "}"}]}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
       RowBox[{
       "PlotLabel", 
        "\[Rule]", "\"\<u1(t) vs y(t) (black dots) and n2 (red)\>\""}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"n2", "[", "uu", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"uu", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.783768315345127*^9, 3.7837685428300443`*^9}, {
