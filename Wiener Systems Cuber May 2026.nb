      RowBox[{"s", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], "]"}], 
     ",", "s", ",", "\[Tau]"}], "]"}], "//", "FullSimplify"}]}]], "Input",
