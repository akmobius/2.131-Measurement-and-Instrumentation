      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"{", 
   RowBox[{"vaf0", ",", "vaf1", ",", "vaf2"}], "}"}]}]], "Input",
