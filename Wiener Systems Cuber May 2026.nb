Cell[CellGroupData[{

Cell["Compare input and output probability density functions ", \
"Subsubsection",
 CellChangeTimes->{{3.784051136768323*^9, 
  3.784051161105425*^9}},ExpressionUUID->"aa70e343-fb28-430e-8711-\
f0efa3f31127"],

Cell["\<\
We now calculate the input and output probability density functions using \
Mathematica\[CloseCurlyQuote]s SmoothHistogram[ ] function which determines \
the probability density functions via a different technique than the usual \
Histogram[ ] function. There is a whole area of statistics devoted to \
different probability density function determination methods.
Notice that while the original input, x(t) is Gaussian:\
\>", "Text",
 CellChangeTimes->{{3.783949157686884*^9, 3.7839492097692595`*^9}, 
   3.783949271551796*^9, 3.7839496546798625`*^9, {3.783949799430415*^9, 
   3.783949802566524*^9}, {3.784078795260476*^9, 3.784078886346873*^9}, {
   3.784078923043865*^9, 
   3.78407896549532*^9}},ExpressionUUID->"91cdc8a1-47db-49b8-8372-\
26473f35fca0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"SmoothHistogram", "[", 
   RowBox[{"x", ",", "Automatic", ",", "\"\<PDF\>\"", ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Amplitude\>\"", ",", "\"\<Probability\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<Input Probability Density\>\""}], ",", 
    RowBox[{"ImageSize", "\[Rule]", 
     RowBox[{"Automatic", "\[Rule]", "400"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.784051740064619*^9, 3.7840518002943606`*^9}, {
  3.7840524903403053`*^9, 3.7840524990501432`*^9}, {3.784066357633221*^9, 
  3.784066357758543*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"7d4d6c46-78c7-4f55-8e7d-7f01e7b0dd54"],

