Cell["\<\
This VAF is so high there is no point in going any further other than to \
generate explicit parametric models for both the impulse response function \
and the static nonlinearity.\
\>", "Text",
 CellChangeTimes->{{3.783986907723431*^9, 3.783986953878984*^9}, {
  3.783988622765644*^9, 
  3.783988683940835*^9}},ExpressionUUID->"68e90c1b-c5ca-434b-bef8-\
911524fbdcf3"],

Cell["As a reminder of our progress lets review the various VAFs:", "Text",
 CellChangeTimes->{{3.784413566401648*^9, 
  3.784413580637849*^9}},ExpressionUUID->"7273dc93-7b46-4fc2-89fd-\
65fe6aeb47f0"],

