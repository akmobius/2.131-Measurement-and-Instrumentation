  PlotLabel->FormBox[
   "\"hi(\[Tau]) (red) and hi2(\[Tau]) (black)\"", TraditionalForm],
  PlotRange->{{0, 0.25}, {-1.2903281742263735`, 27.644581493177455`}},
  PlotRangeClipping->True,
