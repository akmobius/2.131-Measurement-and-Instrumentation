Cell[CellGroupData[{

Cell["Wiener system identification", "Subsubsection",
 CellChangeTimes->{{3.783713551789595*^9, 
  3.783713557634798*^9}},ExpressionUUID->"644c23a0-ef85-49df-97d6-\
9ed7454c09d7"],

Cell["\<\
We now ask if it is possible to determine the two internal subsystems, \
namely, h(\[Tau]) and n(\[CenterDot]) solely from the input, x(t), and \
output, y(t), signals.
Lets see what happens when we compute the nonparametric impulse response \
function, hi1(\[Tau]), between the input, x(t), and the output, y(t). \
\>", "Text",
 CellChangeTimes->{{3.783713565921198*^9, 3.783713717832489*^9}, {
  3.784031069023693*^9, 
  3.7840310789616203`*^9}},ExpressionUUID->"22be696a-1fb1-4ac7-8255-\
512a84bf8147"],

Cell["\<\
To do this we compute the input auto-correlation function, xacf(\[Tau]), and \
the cross-correlation function between x(t) and y(t), xyccf(\[Tau]).\
\>", "Text",
 CellChangeTimes->{{3.78371373757178*^9, 
  3.7837138217594433`*^9}},ExpressionUUID->"76d3a245-323b-42f6-bf07-\
ac9241c725c4"],

Cell["\<\
Define a function to perform biased auto- and cross-correlation functions \
(strictly speaking it calculates auto- and cross-covariance functions)\
\>", "Text",
 CellChangeTimes->{{3.767892774421827*^9, 
  3.767892845090962*^9}},ExpressionUUID->"321895f4-e993-4c92-897c-\
16c602adcf17"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"cor", "[", 
    RowBox[{"x_", ",", "y_", ",", "m_"}], "]"}], ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "x", "]"}]}], ",", 
       RowBox[{"xMn", "=", 
        RowBox[{"Mean", "[", "x", "]"}]}], ",", 
       RowBox[{"yMn", "=", 
        RowBox[{"Mean", "[", "y", "]"}]}]}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", 
               RowBox[{"n", "-", "j"}]}], "]"}], "]"}], "-", "xMn"}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"y", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", "+", "j"}], ";;", "n"}], "]"}], "]"}], "-", 
            "yMn"}], ")"}]}], ")"}], " ", "/", "n"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "m"}], "}"}]}], "]"}]}], " ", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.769779922298*^9, 3.769780019509486*^9}, {
   3.769780060136121*^9, 3.769780079027103*^9}, {3.769780109855212*^9, 
   3.7697801201870894`*^9}, 3.7697825126210775`*^9, {3.769783795139135*^9, 
   3.769783795486774*^9}, 3.769802427549733*^9, {3.7837139835016*^9, 
   3.7837139836661596`*^9}, {3.783714044343013*^9, 3.783714050897458*^9}, {
   3.783714081464754*^9, 3.783714094709354*^9}, {3.783714155500865*^9, 
   3.7837142151744204`*^9}, {3.783714488332246*^9, 3.783714505553217*^9}, {
   3.783714546187606*^9, 3.783714578605006*^9}, 3.7837147187493706`*^9, {
   3.7837150379192905`*^9, 3.78371504465526*^9}, {3.7837151301367793`*^9, 
   3.783715133419041*^9}, 3.783767189271289*^9, {3.783878744140111*^9, 
   3.7838787534547815`*^9}, {3.784030929996602*^9, 3.784030945546364*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"b8e3c6a5-b688-4a4d-80a0-d8a74313fa9c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"xacf", "=", 
   RowBox[{"cor", "[", 
    RowBox[{"x", ",", "x", ",", 
     RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xyccf", "=", 
   RowBox[{"cor", "[", 
    RowBox[{"x", ",", "y", ",", 
     RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"toe", "=", 
   RowBox[{"ToeplitzMatrix", "[", "xacf", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"invtoe", "=", 
   RowBox[{"Inverse", "[", "toe", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hi1", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"invtoe", ".", "xyccf"}], ")"}], "/", "\[CapitalDelta]t"}]}], 
  ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi1"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<h(\[Tau]) (red) and h1(\[Tau]) (black)\>\""}],
    ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.783714401465455*^9, 3.783714418475966*^9}, {
  3.783714460951434*^9, 3.78371446133645*^9}, {3.783714770898028*^9, 
  3.783714771006693*^9}, {3.783715145543625*^9, 3.783715153668929*^9}, {
  3.783767191643694*^9, 3.783767225811871*^9}, {3.783878756768091*^9, 
