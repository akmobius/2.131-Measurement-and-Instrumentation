Cell["\<\
Note that the VAF is now really high!! At this point we could stop because \
the VAF is so high. However in this simulation of a Wiener system we did not \
add noise to our output (which would have decreased the VAF). We will \
therefor attempt to refine our estimates of h(\[Tau]) and n(\[CenterDot]) to \
see if we can achieve an even higher VAF.\
\>", "Text",
 CellChangeTimes->{{3.7840316403386602`*^9, 3.78403174500974*^9}, {
  3.784032829657956*^9, 3.784032869101379*^9}, {3.784412604075108*^9, 
  3.784412612890189*^9}, {3.9233955111784267`*^9, 
  3.923395514481135*^9}},ExpressionUUID->"ddbc8260-15a9-4450-abe9-\
6f280974f7d9"],

Cell["", "PageBreak",
 PageBreakBelow->True,ExpressionUUID->"6310f607-e586-45b3-9d83-e17a697f0072"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Function reversion (sometimes called function inversion)", \
"Subsubsection",
 CellChangeTimes->{{3.783867688487379*^9, 3.7838677022852354`*^9}, {
  3.783871119345084*^9, 3.7838711329108686`*^9}, {3.7840328871238937`*^9, 
  3.7840328945783405`*^9}},ExpressionUUID->"18eac896-dad5-4af4-8947-\
866550b8a897"],

Cell["\<\
There are many occasions in which given a function y = f(x) we want to find a \
function x = g(y). Function g() is often (including Mathematica) called the \
inverse function of f() and sometimes in mathematics texts it is called the \
reversion of f(). For example, you might have a function  voltage = \
f(temperature) relating the voltage generated by a thermocouple junction to \
its temperature. However if you measure the voltage across a thermocouple \
junction and wish to deduce the its temperature you need the inverse \
function, g(), so that given a voltage you can calculate the temperature via  \
  temperature = g(voltage).

Many of the worlds most famous mathematicians have worked on the reversion \
problem including Gauss and Lagrange.
Mathematica has some powerful function reversion capabilities (under the \
functions InverseFunction[ ] and InverseSeries[ ].\
\>", "Text",
 CellChangeTimes->{{3.783867728326445*^9, 3.7838680913233395`*^9}, {
   3.783871012321344*^9, 3.7838710339776587`*^9}, {3.783871100451456*^9, 
   3.783871219460364*^9}, {3.78387198160404*^9, 3.7838721206412134`*^9}, {
   3.7838741029400806`*^9, 3.783874107628079*^9}, 3.783951154470834*^9, {
   3.7840329187577877`*^9, 
   3.7840330384360337`*^9}},ExpressionUUID->"07204c15-b7fa-4a6d-893c-\
1d05741b80ae"],

Cell["\<\
For example, the reversion (or inverse) of  y = sin (x) is x = arcsin (y)\
\>", "Text",
 CellChangeTimes->{{3.783872124064892*^9, 3.783872127267349*^9}, {
  3.784033043812891*^9, 
  3.784033047187721*^9}},ExpressionUUID->"34af179b-564e-4663-b4c7-\
e2dcf54b3e1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"InverseFunction", "[", "Sin", "]"}]}]], "Input",
 CellChangeTimes->{3.78395118324038*^9},
 CellLabel->
  "In[102]:=",ExpressionUUID->"dbaff7e7-2f0b-478f-94f6-1826f5aa9976"],

Cell[BoxData["ArcSin"], "Output",
 CellChangeTimes->{3.890850496167716*^9, 3.923395539627721*^9, 
  3.9538124579924507`*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"81d05304-8f96-4cd4-b3a2-c45ee06eb5f0"]
}, Open  ]],

Cell["\<\
We would like to find the reversion of n1(\[CenterDot]) so that given y(t) we \
can generate a new estimate, u2(t), of u(t).\
\>", "Text",
 CellChangeTimes->{{3.7838710423229423`*^9, 3.78387104712119*^9}, {
  3.783871472408286*^9, 
  3.783871553699001*^9}},ExpressionUUID->"678215b0-766d-43f0-8976-\
0f8aff9f2e25"],

Cell["\<\
A simple way to \[OpenCurlyDoubleQuote]invert\[CloseCurlyDoubleQuote] n1(\
\[CenterDot]) is to refit the u1(t) vs y(t) but this time by reversing their \
roles to y(t) vs u1(t)as follows. We could use traditional polynomials like \
we did before:\
\>", "Text",
 CellChangeTimes->{{3.783951246288273*^9, 3.78395134144982*^9}, {
  3.784031767921772*^9, 3.7840317968914304`*^9}, {3.784052842670265*^9, 
  3.7840529512005177`*^9}, {3.784052989008944*^9, 3.7840529919176054`*^9}, {
  3.7844126560452847`*^9, 3.784412693061239*^9}, {3.784412763004517*^9, 
  3.784412835434699*^9}, {3.784412887059346*^9, 3.7844129213837104`*^9}, {
  3.784412962944233*^9, 
  3.784412966856254*^9}},ExpressionUUID->"cbe513a5-c401-4ab4-aa1d-\
1b056848b372"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"n1Inv", "=", 
   RowBox[{
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y", ",", "u1"}], "}"}], "\[Transpose]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", "uu", ",", 
        SuperscriptBox["uu", "2"], ",", 
        SuperscriptBox["uu", "3"], ",", 
        SuperscriptBox["uu", "4"], ",", 
        SuperscriptBox["uu", "5"], ",", 
        SuperscriptBox["uu", "6"], ",", 
        SuperscriptBox["uu", "7"], ",", 
        SuperscriptBox["uu", "8"], ",", 
        SuperscriptBox["uu", "9"]}], "}"}], ",", "uu"}], "]"}], 
    "[", "\"\<Function\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", "u1"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<y amplitude\>\"", ",", "\"\<u1 amplitude\>\""}], "}"}]}], 
     ",", 
     RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
     RowBox[{
     "PlotLabel", 
      "\[Rule]", "\"\<y(t) vs u1(t) (black dots) and n1 (red)\>\""}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"n1Inv", "[", "uu", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"uu", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.783966290200716*^9, 3.783966339824714*^9}, {
   3.7839663777166233`*^9, 3.783966385402114*^9}, 3.783984862163167*^9, {
