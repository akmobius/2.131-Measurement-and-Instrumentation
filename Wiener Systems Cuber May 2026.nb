Cell["\<\
This is looking much better.

Now that we have n1Inv we can generate a u2(t) from y(t):\
\>", "Text",
 CellChangeTimes->{{3.783985290653713*^9, 3.783985354059054*^9}, {
  3.7844133581614776`*^9, 
  3.7844133703192644`*^9}},ExpressionUUID->"6a8442a8-a437-435a-b041-\
a7bbaab11787"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"u2", "=", 
   RowBox[{"n1Inv", "[", "y", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.783985357620766*^9, 3.78398536783005*^9}, 
   3.784031937870295*^9, 3.784032034627388*^9, 3.784132771583787*^9},
 CellLabel->
  "In[107]:=",ExpressionUUID->"0db11c43-032e-40cd-b324-3c7d97d5a2a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-estimate h(\[Tau])", "Subsubsection",
 CellChangeTimes->{{3.783872273900545*^9, 
  3.7838722939976053`*^9}},ExpressionUUID->"36d6a514-bdad-4a36-9bc5-\
8be356f2e9b8"],

Cell["Now that we have u2(t) we can re-estimate h(\[Tau]):", "Text",
 CellChangeTimes->{{3.7838723002228827`*^9, 
  3.783872352361056*^9}},ExpressionUUID->"3289d73d-0551-4ef0-8b9d-\
801efde1a71c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"xyccf", "=", 
   RowBox[{"cor", "[", 
    RowBox[{"x", ",", "u2", ",", 
     RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hi2", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"invtoe", ".", "xyccf"}], ")"}], "/", "\[CapitalDelta]t"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hi2", "=", 
    RowBox[{"hi2", "/", 
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]\[Tau]", " ", 
       RowBox[{"Total", "[", "hi2", "]"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "scales", " ", "hi2", " ", "to", " ", "have", " ", "unity", " ", "static", 
    " ", "gain"}], " ", "*)"}]}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi2"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<hi(\[Tau]) (red) and hi2(\[Tau]) (black)\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.783872435253662*^9, 3.783872458051525*^9}, {
   3.7838789978450627`*^9, 3.783879031445504*^9}, 3.784031947771618*^9, {
