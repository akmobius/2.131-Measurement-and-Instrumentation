Cell[CellGroupData[{

Cell["Generate output, y(t)", "Subsubsection",
 CellChangeTimes->{{3.7837131830105715`*^9, 3.783713189794434*^9}, {
  3.783770186592855*^9, 
  3.783770193266863*^9}},ExpressionUUID->"adca6cf9-bbe2-498a-a45f-\
0224ec8c0bb0"],

Cell["\<\
We now pass u(t) through our static nonlinearity, n(), to produce the output, \
y(t):\
\>", "Text",
 CellChangeTimes->{{3.7839490950072885`*^9, 
  3.783949147161079*^9}},ExpressionUUID->"a5cdb84a-7959-454f-875f-\
580a4d188464"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"y", "=", 
   RowBox[{"n", "[", "u", "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", "Blue"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.3"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Wiener System Output, y(t)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}], "Input",
