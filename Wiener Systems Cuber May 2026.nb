Cell["\<\
But as you see the fit is really bad. 
So because the nonlinearity looks somewhat cubic lets instead use nth roots \
as terms in the \[OpenCurlyDoubleQuote]nonparametric\[CloseCurlyDoubleQuote] \
fit. As even powered roots have imaginary parts which we cannot use here we \
will restrict the nth root terms to have odd root powers.
Incidentally nth roots are sometimes called surd functions.\
\>", "Text",
 CellChangeTimes->{{3.7844129809549613`*^9, 3.784412995912811*^9}, {
  3.7844131564048204`*^9, 
  3.7844133373128*^9}},ExpressionUUID->"c7361b3c-e3df-4998-8892-63d298977417"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"n1Inv", "=", 
   RowBox[{
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y", ",", "u1"}], "}"}], "\[Transpose]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", "uu", ",", 
        RadicalBox["uu", "3",
         MultilineFunction->None,
         SurdForm->True], ",", 
        RadicalBox["uu", "5",
         MultilineFunction->None,
         SurdForm->True], ",", 
        RadicalBox["uu", "7",
         MultilineFunction->None,
         SurdForm->True], ",", 
        RadicalBox["uu", "9",
         MultilineFunction->None,
         SurdForm->True]}], "}"}], ",", "uu"}], "]"}], "[", "\"\<Function\>\"",
     "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", "u1"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<y amplitude\>\"", ",", "\"\<u1 amplitude\>\""}], "}"}]}], 
     ",", 
     RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
     RowBox[{
     "PlotLabel", 
      "\[Rule]", "\"\<y(t) vs u1(t) (black dots) and n1 (red)\>\""}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"n1Inv", "[", "uu", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"uu", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.783966290200716*^9, 3.783966339824714*^9}, {
