 CellLabel->"Out[64]=",ExpressionUUID->"2659973c-4bf8-44a2-8f11-8593806a2370"]
}, Open  ]],

Cell["This is close enough. ", "Text",
 CellChangeTimes->{{3.7839484805645633`*^9, 
  3.7839484886441245`*^9}},ExpressionUUID->"f9f55a6f-0925-4a8d-b0ec-\
2752c55d99c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cuber static nonlinearity", "Subsubsection",
 CellChangeTimes->{{3.782401158764203*^9, 3.7824012289043856`*^9}, {
  3.783713071382585*^9, 
  3.78371308810529*^9}},ExpressionUUID->"8427b656-f2fb-4004-8929-\
caf3fefa3f6f"],

Cell["\<\
In this example we will make the static nonlinearity a cuber with a scaling \
of 10:\
\>", "Text",
 CellChangeTimes->{{3.7824152448218746`*^9, 3.782415338668754*^9}, {
  3.783948578671671*^9, 3.783948598975423*^9}, {3.7840524467834854`*^9, 
  3.784052455463761*^9}},ExpressionUUID->"58ea694a-2fb7-47c7-8299-\
9ab7acbe7965"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"n", "[", "u_", "]"}], ":=", 
   RowBox[{"10", 
    SuperscriptBox["u", "3"]}]}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"n", "[", "u", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
    RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<u amplitude\>\"", ",", "\"\<y amplitude\>\""}], "}"}]}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<u1(t) vs y(t)\>\""}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.7837131140046954`*^9, 3.783713164114299*^9}, 
   3.783713200138769*^9, {3.783878664119571*^9, 3.783878715869732*^9}, {
   3.784052459496893*^9, 3.7840524595901904`*^9}, {3.784066184365676*^9, 
