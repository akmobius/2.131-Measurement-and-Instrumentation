Cell["\<\
This VAF is so high there is no point in going any further other than to \
generate explicit parametric models for both the impulse response function \
and the static nonlinearity.\
\>", "Text",
 CellChangeTimes->{{3.783986907723431*^9, 3.783986953878984*^9}, {
  3.783988622765644*^9, 
  3.783988683940835*^9}},ExpressionUUID->"146e5e81-08ee-4985-97d6-\
349e2573cf11"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parametric models", "Subsubsection",
 CellChangeTimes->{{3.783988828077304*^9, 
  3.783988836030966*^9}},ExpressionUUID->"961fe5e8-7443-4cb6-9f61-\
5adee909af2a"],

Cell["\<\
Now that we have a good nonparametric models for the impulse response \
function and the static nonlinearity it is appropriate to go one more step \
and generate parametric (equation based) models for both. \
\>", "Text",
 CellChangeTimes->{{3.783988719029609*^9, 
  3.783988812451602*^9}},ExpressionUUID->"86b838e7-907d-4950-9b47-\
ab9a32cc8f29"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parametric impulse response function model", "Subsubsection",
 CellChangeTimes->{{3.783988697718488*^9, 
  3.783988710911713*^9}},ExpressionUUID->"84e0f87e-91be-4318-aa5e-\
be529a5c1f8b"],

Cell["\<\
By observation of the shape of hi2(\[Tau]) it looks as though it might be \
well approximated (fitted) by a second-order low-pass underdamped impulse \
response function.\
\>", "Text",
 CellChangeTimes->{{3.7839950129271984`*^9, 3.783995078776976*^9}, 
   3.784032405647569*^9},ExpressionUUID->"ed758e3d-357d-4da1-83db-\
89df4125cafa"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"\[Tau]_", ",", "\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], 
    "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Zeta]"}], " ", "\[Tau]", " ", "\[Omega]"}]], " ", 
     "\[Alpha]", " ", "\[Omega]", " ", 
     RowBox[{"Sinh", "[", 
      RowBox[{
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["\[Zeta]", "2"]}]], " ", "\[Tau]", " ", "\[Omega]"}], 
      "]"}]}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[Zeta]", "2"]}]]]}]}]], "Input",
 CellChangeTimes->{{3.780521060934205*^9, 3.780521076727903*^9}, {
   3.7805770350457377`*^9, 3.780577046390332*^9}, {3.780658840161008*^9, 
   3.78065884434752*^9}, {3.780659132946929*^9, 3.780659149130973*^9}, 
   3.781434523395187*^9, {3.783945053504515*^9, 3.7839450712935605`*^9}, {
   3.783946372123941*^9, 3.7839463950660706`*^9}, 3.783946625811929*^9, {
   3.783947610380336*^9, 3.783947667639703*^9}, 3.7839493518407583`*^9, {
   3.7839952761438246`*^9, 3.783995333586475*^9}, {3.784032412086402*^9, 
   3.7840324278356915`*^9}, 3.7840331303232803`*^9},
 CellLabel->"In[83]:=",ExpressionUUID->"d707b62d-0ba9-4221-986c-500938ad8ea9"],

Cell["\<\
We start by defining an objective function to be minimized. Lets find the 3 \
parameters of the parametric second order low-pass underdamped impulse \
response function which minimize the sum of squared differences between it \
and the best nonparametric impulse response function model we determined, \
namely, h2(\[Tau]). \
\>", "Text",
 CellChangeTimes->{{3.783994767297222*^9, 3.783995004376489*^9}, 
   3.7839951059851317`*^9},ExpressionUUID->"4a13490d-d767-4549-b0e1-\
fcadb4afd749"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{
   RowBox[{"rmsError", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "hi2", "]"}]}], "}"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"hi2", "-", 
            RowBox[{"h", "[", 
             RowBox[{
             "\[Tau]i", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], 
             "]"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{"hi2", "-", 
            RowBox[{"h", "[", 
             RowBox[{
             "\[Tau]i", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], 
             "]"}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"n", "-", "2"}], ")"}]}], "]"}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.783996541013671*^9, 3.783996543575557*^9}, {
   3.784032436326697*^9, 3.784032465222828*^9}, 3.7840325181863413`*^9, {
   3.7840331718543177`*^9, 3.784033173322715*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"f0ebc040-28cf-4439-bbda-05e2c3b4929a"],

Cell["\<\
From inspection of h2(\[Tau]) above lets estimate that the natural frequency \
will be near 7 Hz. Which in rad/s is  :\
\>", "Text",
 CellChangeTimes->{
  3.773065373714017*^9, {3.773065755066406*^9, 3.773065854754451*^9}, 
   3.777497493328702*^9, {3.7805046917313194`*^9, 3.780504693106388*^9}, {
   3.780504787671176*^9, 3.780504884305323*^9}, {3.780520411298387*^9, 
   3.780520472369947*^9}, {3.780520529916589*^9, 3.780520549099173*^9}, {
   3.781301673115805*^9, 3.7813016890495653`*^9}, {3.7839956754224033`*^9, 
   3.783995710002454*^9}, {3.7839958136906013`*^9, 3.7839958306940956`*^9}, {
   3.783996126646549*^9, 
   3.783996126646549*^9}},ExpressionUUID->"e774e3da-4a13-4a5b-a6c2-\
be09662efb4f"],

