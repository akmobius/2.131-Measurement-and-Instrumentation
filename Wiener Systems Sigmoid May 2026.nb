    RowBox[{
    "PlotLabel", 
     "\[Rule]", "\"\<Wiener System Output, y(t) (blue) and y2(t) (red)\>\""}],
     ",", 
    RowBox[{"ImageSize", "\[Rule]", 
     RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}]}], "Input",
