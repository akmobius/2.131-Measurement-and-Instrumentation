      RowBox[{
      "PlotLabel", 
       "\[Rule]", "\"\<Input (red) and Output (blue) Probability \
Distributions\>\""}], ",", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"Automatic", "\[Rule]", "400"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"SmoothHistogram", "[", 
     RowBox[{"y", ",", "Automatic", ",", "\"\<CDF\>\"", ",", 
      RowBox[{"PlotStyle", "\[Rule]", "Blue"}]}], "]"}]}], "]"}]}]], "Input",
