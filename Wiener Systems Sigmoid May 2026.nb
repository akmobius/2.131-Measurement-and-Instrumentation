Cell[CellGroupData[{

Cell["Sigmoid static nonlinearity", "Subsubsection",
 CellChangeTimes->{{3.782401158764203*^9, 3.7824012289043856`*^9}, {
  3.783713071382585*^9, 3.78371308810529*^9}, {3.784235618831352*^9, 
  3.784235622661675*^9}},ExpressionUUID->"990639a1-e05b-4ef6-9a66-\
0b817cf9f37b"],

Cell["\<\
In this example we will make the static nonlinearity a sigmoid with the \
following scaling and offset:\
\>", "Text",
 CellChangeTimes->{{3.7824152448218746`*^9, 3.782415338668754*^9}, {
  3.783948578671671*^9, 3.783948598975423*^9}, {3.7840524467834854`*^9, 
  3.784052455463761*^9}, {3.784122715473578*^9, 3.784122733247451*^9}, {
  3.7841227679765863`*^9, 3.784122779185865*^9}, {3.7841311204514856`*^9, 
  3.784131206669443*^9}},ExpressionUUID->"06ee2808-3421-4ab4-850c-\
727afbdf7fa2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"n", "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{"LogisticSigmoid", "[", 
      RowBox[{"10", " ", "u"}], "]"}]}], "-", "1"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"n", "[", "u", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
