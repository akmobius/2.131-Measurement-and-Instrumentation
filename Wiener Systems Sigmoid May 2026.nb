Cell["Now that we have n1Inv we can generate a u2(t) from y(t):", "Text",
 CellChangeTimes->{{3.783985290653713*^9, 
  3.783985354059054*^9}},ExpressionUUID->"006bba48-d6ab-4aed-9522-\
03afc05b7aa9"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"u2", "=", 
   RowBox[{"n1Inv", "[", "y", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.783985357620766*^9, 3.78398536783005*^9}, 
   3.784031937870295*^9, 3.784032034627388*^9, 3.7841232100764837`*^9},
 CellLabel->"In[68]:=",ExpressionUUID->"ff88b844-a7e8-4f63-a106-fd0ec7b6bc53"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-estimate h(\[Tau])", "Subsubsection",
 CellChangeTimes->{{3.783872273900545*^9, 
  3.7838722939976053`*^9}},ExpressionUUID->"3bfdd441-06ae-4cbf-8ec1-\
b5ba84cc6076"],

Cell["Now that we have u2(t) we can re-estimate h(\[Tau]):", "Text",
 CellChangeTimes->{{3.7838723002228827`*^9, 
  3.783872352361056*^9}},ExpressionUUID->"6596690a-9e72-4b1b-93b3-\
be4358352fa5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"xyccf", "=", 
   RowBox[{"cor", "[", 
    RowBox[{"x", ",", "u2", ",", 
     RowBox[{"\[Tau]Max", "/", "\[CapitalDelta]t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hi2", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"invtoe", ".", "xyccf"}], ")"}], "/", "\[CapitalDelta]t"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hi2", "=", 
    RowBox[{"hi2", "/", 
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]\[Tau]", " ", 
       RowBox[{"Total", "[", "hi2", "]"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "scales", " ", "hi2", " ", "to", " ", "have", " ", "unity", " ", "static", 
    " ", "gain"}], " ", "*)"}]}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi2"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<hi(\[Tau]) (red) and hi2(\[Tau]) (black)\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.783872435253662*^9, 3.783872458051525*^9}, {
   3.7838789978450627`*^9, 3.783879031445504*^9}, 3.784031947771618*^9, {
   3.784032115884511*^9, 3.784032186088181*^9}, {3.784066285158949*^9, 
   3.784066285299923*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"5b69988a-f30f-4316-ada6-f4d4ac97a6b2"],

