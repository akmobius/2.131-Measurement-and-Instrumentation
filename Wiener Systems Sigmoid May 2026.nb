       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", 
   RowBox[{"\[Omega]\[Omega]", "=", 
    RowBox[{"2", "\[Pi]", " ", "7.0"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.780520507030995*^9, {3.7805733047871118`*^9, 3.780573314972561*^9}, 
   3.780658948261367*^9, 3.7806591980256915`*^9, {3.780751511730538*^9, 
   3.7807515144486456`*^9}, {3.783995835226578*^9, 3.783995835273799*^9}, {
