Cell[CellGroupData[{

Cell["Re-estimate u(t)", "Subsubsection",
 CellChangeTimes->{{3.783985636597284*^9, 
  3.783985650021831*^9}},ExpressionUUID->"9d93d1fa-5889-468a-9eaf-\
e669fa4f879b"],

Cell["\<\
Now that we have the new impulse response function estimate, h2(t), we can \
convolve it with the input, x(t), to give a new estimate u3(t):\
\>", "Text",
 CellChangeTimes->{{3.7839856576384735`*^9, 
  3.783985770727736*^9}},ExpressionUUID->"ad47cab5-84d5-4446-ab03-\
61775900b952"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"u3", "=", 
   RowBox[{"\[CapitalDelta]t", " ", 
    RowBox[{"ListConvolve", "[", 
     RowBox[{"hi2", ",", "x", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.7839857784000435`*^9, 3.783985788579406*^9}, 
   3.784032228224021*^9},
 CellLabel->"In[73]:=",ExpressionUUID->"a444ba99-945d-4aa8-82b4-3316cbe0d36c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Re-estimate n(\[CenterDot])", "Subsubsection",
 CellChangeTimes->{{3.7837183640009174`*^9, 3.783718373394162*^9}, {
  3.7839858437455773`*^9, 
  3.783985851286141*^9}},ExpressionUUID->"74bcaee5-d7bc-4bc1-be9d-\
407753c656d5"],

Cell["\<\
Now that we have a new estimate u3(t) we can predict the form of the static \
nonlinearity by simply cross-plotting u3 vs y:\
\>", "Text",
 CellChangeTimes->{{3.783718378302371*^9, 3.783718469262151*^9}, {
  3.783985856591826*^9, 
  3.783985873862835*^9}},ExpressionUUID->"0fce9362-9a2d-42cd-82ba-\
f833d322efe5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u3", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<u1 amplitude\>\"", ",", "\"\<y amplitude\>\""}], "}"}]}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<u3(t) vs y(t)\>\""}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7837185008003106`*^9, 3.783718502911722*^9}, {
   3.783718545905715*^9, 3.783718664886136*^9}, {3.783719087333482*^9, 
