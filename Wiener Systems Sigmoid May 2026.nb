Cell["\<\
Notice that this impulse response function \[OpenCurlyDoubleQuote]dies out\
\[CloseCurlyDoubleQuote] by around 0.15 s. \
\>", "Text",
 CellChangeTimes->{{3.783947103552388*^9, 
  3.783947172911163*^9}},ExpressionUUID->"4d02a223-2854-4f15-aa65-\
fc9b4f23f83e"],

Cell["\<\
We will need to sample this symbolic version of the impulse response function \
to produce a sampled version. To do this we need to specify the inter-sample \
interval, \[CapitalDelta]\[Tau], and the maximum lag, \[Tau]Max. Lets make \
the sampling increment be 2 ms (i.e., a sampling rate of 500 Hz) and the \
maximum lag be 0.25 s (as above).\
\>", "Text",
 CellChangeTimes->{{3.783946685890066*^9, 3.78394690897995*^9}, {
  3.7839471880585613`*^9, 3.783947243718254*^9}, {3.783947274135067*^9, 
  3.783947308828124*^9}},ExpressionUUID->"79b157ac-dd16-44f1-a874-\
98a5732587c4"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"\[CapitalDelta]\[Tau]", "=", "0.002"}], ";", " ", 
  RowBox[{"\[Tau]Max", "=", "0.25"}], ";"}]], "Input",
 CellChangeTimes->{{3.7839468778124237`*^9, 3.78394688350027*^9}, {
   3.7839472506128483`*^9, 3.783947260018023*^9}, 3.783949339616306*^9},
 CellLabel->"In[21]:=",ExpressionUUID->"79c02b2e-a411-4222-abae-7f9af2032577"],

Cell["We can now generate a sampled version of the lag domain, \[Tau]:", \
"Text",
 CellChangeTimes->{{3.783946915438351*^9, 3.783946916672799*^9}, {
  3.783947323663118*^9, 3.783947364098708*^9}, {3.7839474172486115`*^9, 
  3.783947427017119*^9}},ExpressionUUID->"3213d0d4-0a25-4f28-ad18-\
2c272e2537b2"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"\[Tau]i", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "\[Tau]Max", ",", " ", "\[CapitalDelta]\[Tau]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.783947380836618*^9, 3.783947398971887*^9}, 
   3.783949337242231*^9, 3.784030309475007*^9},
 CellLabel->"In[22]:=",ExpressionUUID->"d1abf77a-510c-4bd0-a55c-fae9de2ca0cd"],

Cell["and a sampled version of the impulse response function:", "Text",
 CellChangeTimes->{{3.783947946633292*^9, 
  3.783947957619953*^9}},ExpressionUUID->"5bba1f3d-8838-4fab-8732-\
5b9f5f35a808"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"hi", "=", 
   RowBox[{"h", "[", "\[Tau]i", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.783947961044117*^9, 3.783947983172306*^9}, 
   3.7839493313809414`*^9, {3.784030320864812*^9, 3.7840303320727873`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"9f8c2afc-31b6-4ed0-98e3-b09890e4675a"],

Cell["\<\
Now we can plot both the continuous and sampled versions of h:\
\>", "Text",
 CellChangeTimes->{{3.783947450028835*^9, 
  3.783947474266962*^9}},ExpressionUUID->"612ec9a8-8f72-48fc-b9fa-\
47fea3d57489"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"h", "[", "\[Tau]", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0", ",", "0.25"}], "}"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
      RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
      RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
      RowBox[{
      "PlotLabel", 
       "\[Rule]", "\"\<SubSystem Impulse Response Function (Continuous (red)) \
and (Sampled (black))\>\""}], ",", 
      RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.783947478315706*^9, 3.783947479846728*^9}, {
   3.783947918671012*^9, 3.783947931909869*^9}, {3.7839479964279346`*^9, 
