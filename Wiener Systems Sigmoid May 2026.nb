   3.784031921526533*^9}, {3.7840528050361404`*^9, 3.7840528251670985`*^9}, {
   3.78406639581544*^9, 3.784066395909579*^9}, {3.7841229975488806`*^9, 
   3.784123018589834*^9}, {3.784123067630803*^9, 3.784123112521506*^9}, {
   3.7841231426132717`*^9, 3.784123153181305*^9}, {3.784123192054213*^9, 
   3.7841232034011335`*^9}},
