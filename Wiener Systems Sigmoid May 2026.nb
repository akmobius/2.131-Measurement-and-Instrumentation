Cell["\<\
We can find an approximation to the estimate, n1(\[CenterDot]), of n(\
\[CenterDot]) above by fitting a high order polynomial to the u1(t) vs y(t) \
cross-plot:\
\>", "Text",
 CellChangeTimes->{{3.783767708140251*^9, 3.783767783297245*^9}, {
  3.7838862731778*^9, 3.7838862790712776`*^9}, {3.783892429545247*^9, 
  3.783892443624403*^9}},ExpressionUUID->"132ce1eb-91fd-4df1-baf8-\
3da8016e5f37"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"n1", "=", 
   RowBox[{
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u1", ",", "y"}], "}"}], "\[Transpose]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", "uu", ",", 
        SuperscriptBox["uu", "3"], ",", 
        SuperscriptBox["uu", "5"], ",", 
