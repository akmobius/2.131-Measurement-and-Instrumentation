Cell["\<\
If we multiply h(\[Tau]) by \[Alpha] and divide n(\[CenterDot]) by \[Alpha] \
there will be no change in the output, y(t). In other words there is a \
scaling constant, \[Alpha] , that can freely move from h(\[Tau]) to n(\
\[CenterDot]). So lets scale h1(\[Tau]) so that the area under it (i.e. the \
static gain) is 1:\
\>", "Text",
 CellChangeTimes->{{3.78371710219084*^9, 3.7837172733655787`*^9}, {
  3.783950889107704*^9, 3.783950893562702*^9}, {3.7840311448116307`*^9, 
  3.7840311581834393`*^9}, {3.7840312164117684`*^9, 3.784031230019982*^9}, {
  3.784032775086342*^9, 
  3.784032779259611*^9}},ExpressionUUID->"7b79ed7e-4578-4eda-b87a-\
29dc40db5897"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"hi1", "=", 
    RowBox[{"hi1", "/", 
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]\[Tau]", " ", 
       RowBox[{"Total", "[", "hi1", "]"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "scales", " ", "hi1", " ", "to", " ", "have", " ", "unity", " ", "static", 
    " ", "gain"}], " ", "*)"}]}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi1"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Lag (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.5"}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<hi(\[Tau]) (red) and a hi1(\[Tau]) (black)\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.78371730478526*^9, 3.783717352662325*^9}, 
