Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"InverseLaplaceTransform", "[", 
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"s", ",", "\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], "]"}], 
     ",", "s", ",", "\[Tau]"}], "]"}], "//", "FullSimplify"}]}]], "Input",
 CellChangeTimes->{
  3.780521088600496*^9, {3.780577027879145*^9, 3.780577028035688*^9}, 
   3.7806591433975577`*^9, 3.7814345206926947`*^9, {3.783945046503774*^9, 
   3.783945046816345*^9}, 3.7839454011156845`*^9, {3.783945491926641*^9, 
   3.783945499726366*^9}, {3.783945565313716*^9, 3.78394561619458*^9}, {
