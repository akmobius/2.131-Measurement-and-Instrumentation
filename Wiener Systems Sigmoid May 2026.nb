 CellLabel->"In[85]:=",ExpressionUUID->"5efe9862-91c5-46a3-8ce7-95f553576d24"],

Cell["\<\
The system is clearly only slightly underdamped (i.e., a little less than \
1.0) so lets set it to be:\
\>", "Text",
 CellChangeTimes->{
  3.773065373714017*^9, {3.773065755066406*^9, 3.773065854754451*^9}, 
   3.777497493328702*^9, {3.7805046917313194`*^9, 3.780504693106388*^9}, {
