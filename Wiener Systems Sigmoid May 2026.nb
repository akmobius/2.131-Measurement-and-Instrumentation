Cell["\<\
As an example lets start by generating an impulse response function, \
h(\[Tau]), (to model the linear dynamic element) and lets make the nonlinear \
static element, n(\[CenterDot]), a sigmoid function.\
\>", "Text",
 CellChangeTimes->{{3.783946101397366*^9, 3.783946249493556*^9}, {
  3.923395933578536*^9, 
  3.923395937185679*^9}},ExpressionUUID->"33cba847-28f8-4e5f-b2ce-\
406b8d75afd2"]
}, Open  ]],

