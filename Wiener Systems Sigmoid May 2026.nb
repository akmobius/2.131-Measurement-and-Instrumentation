Cell[CellGroupData[{

Cell["Generate output, y(t)", "Subsubsection",
 CellChangeTimes->{{3.7837131830105715`*^9, 3.783713189794434*^9}, {
  3.783770186592855*^9, 
  3.783770193266863*^9}},ExpressionUUID->"33a90506-35c5-49bf-95c7-\
660efcacd10d"],

Cell["\<\
We now pass u(t) through our static nonlinearity, n(), to produce the output, \
y(t):\
\>", "Text",
 CellChangeTimes->{{3.7839490950072885`*^9, 
  3.783949147161079*^9}},ExpressionUUID->"d79e1c41-3fdb-4922-8d65-\
90fadf91cabd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{"y", "=", 
   RowBox[{"n", "[", "u", "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ti", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", "Blue"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
