      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"y2", "=", 
   RowBox[{"n2", "[", "u3", "]"}]}], ";"}], "\n", 
