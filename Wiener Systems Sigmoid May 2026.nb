 CellLabel->"In[17]:=",ExpressionUUID->"502ba20d-fc0f-4443-8a42-a464b8360ea0"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Zeta]"}], " ", "\[Tau]", " ", "\[Omega]"}]], " ", 
   "\[Alpha]", " ", "\[Omega]", " ", 
   RowBox[{"Sinh", "[", 
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[Zeta]", "2"]}]], " ", "\[Tau]", " ", "\[Omega]"}], 
    "]"}]}], 
  SqrtBox[
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["\[Zeta]", "2"]}]]]], "Output",
