   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u3", ",", "y"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"p1", " ", 
