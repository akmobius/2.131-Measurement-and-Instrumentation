     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.3"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<x(t) (red) and u(t) (black)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"Automatic", "\[Rule]", "600"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.783878597792067*^9, 3.783878608878515*^9}, 
   3.7838786507570095`*^9, {3.7839490689072313`*^9, 3.78394906937622*^9}, {
