      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1", ",", "1.0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p2", ",", "1.0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p3", ",", "1.0"}], "}"}]}], "}"}], ",", "uu", ",", " ", 
     RowBox[{"Method", "\[Rule]", "\"\<LevenbergMarquardt\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}], "\n", 
 RowBox[{
