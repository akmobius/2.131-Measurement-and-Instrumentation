Cell["\<\
Notice that at low frequencies (10 to 100 Hz) the LR circuit behaves as a \
resistor (gain slope of 0 and phase of 0 deg), then at higher frequencies (10 \
kHz to 1 MHz) the LR circuit behaves like an inductor (gain slope of +1 and \
phase of +90 deg).\
\>", "Text",
 CellChangeTimes->{{3.792766733796895*^9, 3.792766812161793*^9}, {
  3.792767335113457*^9, 3.792767392072953*^9}, {3.7927674269593925`*^9, 
  3.792767431118195*^9}, {3.7927687559626875`*^9, 3.792768756416023*^9}, {
  3.792770210807773*^9, 3.792770257881145*^9}, {3.7927717086998177`*^9, 
  3.7927719688635845`*^9}, {3.921785636705758*^9, 
  3.9217857300957747`*^9}},ExpressionUUID->"40cc4a3a-9a56-45c4-8ed0-\
8c3e72b1da04"],

Cell["\<\
Compare this simulation with the measurements made on the real 1 mH inductor.\
\>", "Text",
 CellChangeTimes->{{3.921785746415799*^9, 3.92178578135187*^9}, {
  3.950811615599658*^9, 
  3.950811618885868*^9}},ExpressionUUID->"a507fae3-2545-4353-af92-\
920ca4856a09"]
}, Open  ]],

