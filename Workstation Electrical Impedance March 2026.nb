}, Open  ]],

Cell[TextData[{
 "Note that the slope of this plot is 1 on these Log Log axes.\nGiven the \
impedance gain plot we can deduce the value of the inductor by evaluating \
z[s] at s = 1 (i.e. 1 rad/s = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", "\[Pi]"}]], TraditionalForm]],ExpressionUUID->
  "525db92f-2625-4005-84ba-4db2ddb356bd"],
 "Hz = 0.159155 Hz). The dashed lines show that at a frequency of 1 rad/s \
(i.e., ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", "\[Pi]"}]], TraditionalForm]],ExpressionUUID->
  "8a5f870b-f2ae-43f6-bd77-1c7cc3fc3e8d"],
 "Hz) the impedance is 1 m\[CapitalOmega]. This corresponds to an inductance \
of 1 mH."
}], "Text",
 CellChangeTimes->{{3.7927657715390506`*^9, 3.792766039773599*^9}, {
   3.79276630895539*^9, 3.792766480286957*^9}, {3.792766839180423*^9, 
   3.792766860486235*^9}, {3.792766892766351*^9, 3.7927669122100134`*^9}, {
   3.792767186840396*^9, 3.79276727887668*^9}, {3.92177722434793*^9, 
   3.9217772476805677`*^9}, 3.921780116777856*^9, {3.9217802301452103`*^9, 
   3.9217802457295427`*^9}, {3.950810427063045*^9, 
   3.9508104394825583`*^9}},ExpressionUUID->"c0c4be05-45d2-4cb6-b1ad-\
0060577e9165"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"z", "[", 
    RowBox[{"\[ImaginaryI]", " ", "1"}], "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.92178020693115*^9, 3.921780211008943*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"7c0ea808-3f62-4ebc-96a2-dbcd47325cd3"],

