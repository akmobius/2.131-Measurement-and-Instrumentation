  3.7927696667917876`*^9}, {3.792769727960247*^9, 3.792769747795161*^9}, {
  3.792769968558185*^9, 3.792769981122341*^9}, {3.921786131625474*^9, 
  3.921786195577758*^9}, {3.95081017694746*^9, 
  3.950810181386402*^9}},ExpressionUUID->"ec8c1cb1-2464-4148-9b68-\
7eba54064b89"],

Cell["The electrical impedance of an ideal inductor is:", "Text",
 CellChangeTimes->{{3.792760621922182*^9, 3.792760633028642*^9}, {
  3.792767539773631*^9, 3.792767558842907*^9}, {3.7927682004171944`*^9, 
