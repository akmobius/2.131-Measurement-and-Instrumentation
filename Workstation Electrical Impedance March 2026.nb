Cell["\<\
Every time the resistor value is changed you will hear the relays on the \
Impedance Analyzer board click. If you do not hear this click then something \
is wrong.\
\>", "Text",
 CellChangeTimes->{{3.790965184479844*^9, 3.790965251143151*^9}, {
  3.792784768994398*^9, 
  3.792784771275179*^9}},ExpressionUUID->"136b32b6-7196-4e75-91d3-\
9267f06f4832"]
}, Open  ]],

