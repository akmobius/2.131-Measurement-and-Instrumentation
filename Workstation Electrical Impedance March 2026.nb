     RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<Frequency (Hz)\>\"", 
        ",", "\"\<Gain (\[CapitalOmega])\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "\[Rule]", "\"\<Series RCL Electrical Impedance (Gain)\>\""}], ",", " ", 
     RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "0.4"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.792764028824176*^9, 3.7927640327607083`*^9}, {
