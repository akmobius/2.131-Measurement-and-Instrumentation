   3.9217794032310553`*^9, 3.921780026677184*^9, 3.921780387993442*^9, {
   3.9217815247024927`*^9, 3.9217815398967*^9}, 3.921781587966992*^9, {
   3.921781629716823*^9, 3.921781652350086*^9}, 3.9217817188990088`*^9, {
   3.92178175767026*^9, 3.9217817749256363`*^9}, 3.9508102323646803`*^9, 
   3.9508103693751574`*^9, 3.971950592156438*^9, 3.9839674192313614`*^9},
