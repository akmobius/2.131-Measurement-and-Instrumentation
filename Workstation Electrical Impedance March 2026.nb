Cell["\<\
If we have a variable capacitor (such as are used to tune analog AM radios) \
then we can sweep the notch across frequencies:\
\>", "Text",
 CellChangeTimes->{{3.951240365460328*^9, 
  3.951240426647647*^9}},ExpressionUUID->"0b177049-8040-4df6-9e45-\
edd53d68b189"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"z", "[", "s_", "]"}], ":=", 
      RowBox[{"resR", " ", "+", " ", 
       FractionBox["1", 
        RowBox[{"capC", " ", "s"}]], "+", " ", 
       RowBox[{"indL", " ", "s"}]}]}], " ", ";", "\[IndentingNewLine]", 
     RowBox[{"resR", "=", "0.1"}], " ", ";", " ", 
     RowBox[{"indL", "=", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{"LogLogPlot", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"z", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", "2", "\[Pi]"}], 
          "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Omega]", ",", "10", ",", 
          SuperscriptBox["10", "6"]}], "}"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"10", ",", "1000000"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.1", ",", "100000"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"12", ",", "Black"}], "}"}]}], ",", 
        RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Frequency (Hz)\>\"", 
           ",", "\"\<Gain (\[CapitalOmega])\>\""}], "}"}]}], ",", 
        RowBox[{
        "PlotLabel", 
         "\[Rule]", "\"\<Series RCL Electrical Impedance (Gain)\>\""}], ",", 
        " ", 
        RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", "0.4"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"capC", ",", 
        RowBox[{"100.", " ", 
         SuperscriptBox["10", 
          RowBox[{"-", "8"}]]}], ",", "\"\<Capacitance\>\""}], "}"}], ",", 
      RowBox[{"25.", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "8"}]]}], ",", 
      RowBox[{"25.", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "6"}]]}], ",", 
      RowBox[{"1.", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "8"}]]}], ",", 
      RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.792764028824176*^9, 3.7927640327607083`*^9}, {
