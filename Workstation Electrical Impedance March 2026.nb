Cell[CellGroupData[{

Cell["Objectives", "Subsubsection",
 CellChangeTimes->{{3.895001130256463*^9, 
  3.895001131990163*^9}},ExpressionUUID->"f2a3befb-e31a-4c9c-9782-\
4c1d99c22c34"],

Cell["\<\
In this Workstation we discuss electrical impedance analysis and use the \
Digilent Discovery 3 Impedance Analyzer to measure the electrical impedance \
of a variety of components.\
\>", "Text",
 CellChangeTimes->{{3.772912659333026*^9, 3.772912905093886*^9}, {
   3.789595330774129*^9, 3.789595397217356*^9}, {3.789649883331626*^9, 
   3.789649912169527*^9}, {3.78973500207251*^9, 3.789735004259595*^9}, {
   3.789760806361284*^9, 3.7897608416068997`*^9}, {3.7899301108063717`*^9, 
   3.789930111493773*^9}, {3.790964438999732*^9, 3.790964560430269*^9}, 
   3.792757861185259*^9, 3.7927847265599947`*^9, {3.910697205962845*^9, 
   3.910697206177839*^9}, {3.910701183842566*^9, 3.9107011955327067`*^9}, {
   3.921788668740766*^9, 
   3.921788668873785*^9}},ExpressionUUID->"c7ed77b0-a4d4-4bb8-bfeb-\
0d4cf888ab5d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Note", "Subsubsection",
 CellChangeTimes->{{3.8950011521921034`*^9, 3.8950011540714774`*^9}, {
  3.910700844374333*^9, 
  3.9107008452922015`*^9}},ExpressionUUID->"8e45e48b-d03a-435b-9909-\
69f3f1de36c4"],

Cell["\<\
Note that when the Digilent Impedance Analyzer is first used via the Digilent \
Discovery 3 running Waveforms it is important to tell the software that the \
Impedance Analyzer is attached. If this is not done then incorrect impedance \
values will be recorded. As shown in the image below the menu above Mode: \
should be set to Adapter.\
\>", "Text",
 CellChangeTimes->{{3.790964575230902*^9, 3.7909647608008037`*^9}, {
  3.790965124664005*^9, 3.79096516553544*^9}, {3.9106972208487773`*^9, 
  3.910697220922803*^9}},ExpressionUUID->"5d8772fc-185b-4a63-94df-\
3bad3238454f"],

