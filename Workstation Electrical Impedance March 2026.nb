      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Show", "[", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
