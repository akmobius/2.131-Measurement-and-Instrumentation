Cell[TextData[{
 "Notice that the phase of an ideal inductor is 90 deg.\nTherefor for an \
inductor the impedance Bode plot gain has a slope of +1 and a phase of +90 \
deg.\nAn ideal inductor stores energy given by  0.5 L",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox["I", "2"]}], TraditionalForm]],ExpressionUUID->
  "1ba7e8a1-4731-4eaf-8fff-3e3c66956f06"],
 " (where I is current).\n"
}], "Text",
 CellChangeTimes->{{3.792766733796895*^9, 3.792766812161793*^9}, {
  3.792767335113457*^9, 3.792767392072953*^9}, {3.7927674269593925`*^9, 
  3.792767431118195*^9}, {3.7927687559626875`*^9, 3.792768756416023*^9}, {
  3.792770210807773*^9, 
  3.792770257881145*^9}},ExpressionUUID->"fa4aac1b-37ac-4fda-9433-\
811f30c07c86"]
}, Open  ]],

