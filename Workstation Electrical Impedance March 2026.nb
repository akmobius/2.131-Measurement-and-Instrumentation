Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"capC", "=", 
    RowBox[{"680", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"680", " ", "nF"}], " ", "*)"}]}], "\n", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"z", "[", 
       RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", "2", "\[Pi]"}], "]"}], 
