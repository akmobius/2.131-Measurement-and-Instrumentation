Cell["\<\
Here we have a resistor in series with a capacitor and inductor in parallel. \
So for the circuit above we get:\
\>", "Text",
 CellChangeTimes->{{3.792772080943583*^9, 3.79277224005504*^9}, {
  3.79278533494853*^9, 
  3.792785340464933*^9}},ExpressionUUID->"86133a4b-2826-4ea8-9845-\
ef3dbeeb8ad1"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"z", "[", "s_", "]"}], ":=", 
   RowBox[{"resR", " ", "+", 
    SuperscriptBox[
     RowBox[{"(", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["1", 
          RowBox[{"capC", " ", "s"}]], ")"}], 
        RowBox[{"-", "1"}]], "+", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"indL", " ", "s"}], ")"}], 
        RowBox[{"-", "1"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.7927722455557804`*^9, 3.792772346097842*^9}, 
   3.792784353056509*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"81339702-5c9b-4811-9972-ba7bd79390f5"],

Cell["If we set the resistance, capacitance and inductance to:", "Text",
 CellChangeTimes->{{3.792770590588015*^9, 
  3.792770622397064*^9}},ExpressionUUID->"a5415acd-6c4f-44b2-8a81-\
bdd673f548b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"resR", "=", 
    SuperscriptBox["10", "4"]}], " ", ";", "   ", 
   RowBox[{"capC", "=", 
    RowBox[{"680", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], ";", "  ", 
   RowBox[{"indL", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.792770631586937*^9, 3.792770708792121*^9}, 
   3.792771278127737*^9, {3.7927713239153814`*^9, 3.792771350258509*^9}, {
   3.792834940121391*^9, 3.792834941675903*^9}, 3.950811678755312*^9},
