Cell[TextData[{
 "Note that the slope of this plot is 0 and the value of the resistor is the \
impedance gain which is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "4"], TraditionalForm]],ExpressionUUID->
  "f9890635-31cb-49f8-9b77-5af2164487de"],
 "\[CapitalOmega] = 10 k\[CapitalOmega] ."
}], "Text",
 CellChangeTimes->{{3.7927657715390506`*^9, 3.792766039773599*^9}, {
