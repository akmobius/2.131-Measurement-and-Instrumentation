Cell[TextData[{
 "Notice that the phase of an ideal capacitor is -90 deg.\nTherefor for a \
capacitor the impedance Bode plot gain has a slope of -1 and the phase is -90 \
deg.\nAn ideal capacitor stores energy given by  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5", " "}], TraditionalForm]],ExpressionUUID->
  "29364abf-1ba4-450a-8cf0-cd64a1676db7"],
 "C",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "2"], TraditionalForm]],ExpressionUUID->
  "4166106b-bfd6-4b5a-88c8-97801d93280a"],
 " (where V is voltage)"
}], "Text",
 CellChangeTimes->{{3.792766733796895*^9, 3.792766812161793*^9}, {
  3.792768766042094*^9, 3.792768766513526*^9}, {3.7927701157002573`*^9, 
  3.7927701748513813`*^9}, {3.7927702632730823`*^9, 
  3.7927702684774284`*^9}},ExpressionUUID->"13acdc99-6bff-49a2-9dc1-\
380313470555"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Real Capacitor", "Subsubsection",
