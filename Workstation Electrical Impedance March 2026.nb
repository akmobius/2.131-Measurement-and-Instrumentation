Cell["\<\
Here we have a resistor (R),  a capacitor (C) and an inductor (L) all in \
parallel. The electrical impedance of a circuit consisting of L or R or C \
components in parallel is simply given by the reciprocal of the sum of the \
reciprocals of the individual impedance transfer functions. So for the \
circuit above we get:\
\>", "Text",
 CellChangeTimes->{{3.792772080943583*^9, 3.79277224005504*^9}, {
  3.79278426143032*^9, 3.792784280578478*^9}, {3.792785011081554*^9, 
  3.7927850518882527`*^9}, {3.792785193133292*^9, 
  3.7927852047912025`*^9}},ExpressionUUID->"4ae58c0b-647a-4864-adde-\
f62df91d24a5"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"z", "[", "s_", "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", " ", 
     RowBox[{
      SuperscriptBox["resR", 
       RowBox[{"-", "1"}]], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{"capC", " ", "s"}]], ")"}], 
       RowBox[{"-", "1"}]], "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"indL", " ", "s"}], ")"}], 
       RowBox[{"-", "1"}]]}], ")"}], 
    RowBox[{"-", "1"}]]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.7927722455557804`*^9, 3.792772346097842*^9}, {
  3.792784301708361*^9, 3.792784346664294*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"57a4d653-cb56-4b8e-ab4c-714affab6e26"],

Cell["If we set the resistance, capacitance and inductance to:", "Text",
 CellChangeTimes->{{3.792770590588015*^9, 
  3.792770622397064*^9}},ExpressionUUID->"b7a5d583-af76-49e6-aad6-\
f9f63ee986f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"resR", "=", 
    SuperscriptBox["10", "4"]}], " ", ";", "   ", 
   RowBox[{"capC", "=", 
    RowBox[{"680", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], ";", "  ", 
   RowBox[{"indL", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.792770631586937*^9, 3.792770708792121*^9}, 
   3.792771278127737*^9, {3.7927713239153814`*^9, 3.792771350258509*^9}, {
   3.792834940121391*^9, 3.792834941675903*^9}, 3.950811653372654*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"a99676f5-ef46-4eca-a6dd-07b544b91016"],

Cell["We get an electrical impedance Bode plot of:", "Text",
 CellChangeTimes->{{3.792770828457741*^9, 3.7927708518367558`*^9}, {
  3.792771481370473*^9, 
  3.792771487140997*^9}},ExpressionUUID->"3c622117-aad0-4920-9bd0-\
11073f191158"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"Show", "[", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"z", "[", 
       RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", "2", "\[Pi]"}], "]"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Omega]", ",", "10", ",", 
       SuperscriptBox["10", "6"]}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
