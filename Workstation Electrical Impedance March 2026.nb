Cell[TextData[{
 "Note that the slope of this plot is -1 on these Log Log axes.\nGiven the \
impedance gain plot we can deduce the value of the capacitor by evaluating \
z[s] at s = 1 (i.e. 1 rad/s = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", "\[Pi]"}]], TraditionalForm]],ExpressionUUID->
  "e580aeb6-5481-47d0-907f-35b9035f015c"],
 "Hz = 0.159155 Hz) and taking the reciprocal. The dashed lines show that at \
a frequency of 1 rad/s (i.e., ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", "\[Pi]"}]], TraditionalForm]],ExpressionUUID->
  "03d723d5-2c01-4002-b765-0390b07d6031"],
 "Hz) the impedance is :"
}], "Text",
 CellChangeTimes->{{3.7927657715390506`*^9, 3.792766039773599*^9}, {
  3.79276630895539*^9, 3.792766480286957*^9}, {3.792766839180423*^9, 
  3.792766860486235*^9}, {3.792766892766351*^9, 3.7927669122100134`*^9}, {
  3.7928347726054983`*^9, 
  3.79283477881962*^9}},ExpressionUUID->"00149c6d-5e2a-4507-9bec-\
3054959c6ba8"],

