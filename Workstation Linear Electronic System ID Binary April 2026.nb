Cell[CellGroupData[{

Cell["Predict Output", "Subsubsection",
 CellChangeTimes->{{3.8982308698158407`*^9, 
  3.898230872495672*^9}},ExpressionUUID->"c7106181-2edc-4819-bb18-\
cdffc2225a37"],

Cell["\<\
We can now re-predict our output but now using the 3 parameter parametric \
second-order model.
We numerically convolve the measured input, x2, with the system as \
represented by the second-order parametric impulse response function, h, to \
predict the output, yp. Note that we use x2 as input and not the training \
data, x1.

 We need to sample the parametric impulse response function to a version \
suitable for numeric convolution:\
\>", "Text",
 CellChangeTimes->{{3.898052950543316*^9, 3.8980529632935*^9}, {
   3.8980539805398927`*^9, 3.8980539826352167`*^9}, {3.898230880822817*^9, 
   3.898230945309235*^9}, {3.970150432074746*^9, 3.970150454107727*^9}, 
   3.970163272869124*^9, {3.970163409779695*^9, 3.970163557291238*^9}, {
   3.9704151066480503`*^9, 
   3.970415153299697*^9}},ExpressionUUID->"85a7fa8b-716b-47ef-8502-\
d41f3394b38e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"yp", "=", 
    RowBox[{"\[CapitalDelta]t", " ", 
     RowBox[{"ListConvolve", "[", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{
        "\[Tau]i", ",", "\[Alpha]\[Alpha]\[Alpha]", ",", 
         "\[Zeta]\[Zeta]\[Zeta]", ",", " ", "\[Omega]\[Omega]\[Omega]"}], 
        "]"}], ",", "x2", ",", "1"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "1", " ", "tells", " ", "the", " ", "algorithm", " ", "to", " ", "make", " ",
     "the", " ", "input", " ", "and", " ", "output", " ", "lengths", " ", 
    "the", " ", "same"}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.8980529659431815`*^9, 3.8980529876324167`*^9}, 
   3.8980538962939577`*^9, {3.8980539841022005`*^9, 3.8980539852997503`*^9}, {
