Cell["\<\
We can see that the static gain predicted by this method is also very close \
to 2.\
\>", "Text",
 CellChangeTimes->{{3.970150332935602*^9, 3.970150359246801*^9}, {
  3.9702214676052933`*^9, 
  3.9702214682410297`*^9}},ExpressionUUID->"ce250cdf-5fe0-4038-b54f-\
449d32f42f15"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict Output", "Subsubsection",
 CellChangeTimes->{{3.8982308698158407`*^9, 
  3.898230872495672*^9}},ExpressionUUID->"3dd8793f-5df1-42f4-98df-\
667a3b7e599b"],

Cell["\<\
We will now predict the output using numerical convolution. But instead of \
using the x1 and y1 data we will use the x2 and y2 data. We want to make sure \
that our predictions are truly made from a separate data set.
 We now numerically convolve the measured input, x2, with the system as \
represented by the impulse response function, hSVD, to predict the output, \
ynp:\
\>", "Text",
 CellChangeTimes->{{3.898052950543316*^9, 3.8980529632935*^9}, {
   3.8980539805398927`*^9, 3.8980539826352167`*^9}, {3.898230880822817*^9, 
   3.898230945309235*^9}, {3.970150432074746*^9, 3.970150454107727*^9}, 
   3.970163272869124*^9, {3.970413917111692*^9, 3.970414009442869*^9}, {
   3.9704140456238194`*^9, 
   3.970414148440825*^9}},ExpressionUUID->"0b43e2a2-6609-4906-9b60-\
e3a2d29d3cf0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";", " ", 
   RowBox[{"ynp", "=", 
    RowBox[{"\[CapitalDelta]t", " ", 
     RowBox[{"ListConvolve", "[", 
      RowBox[{"hSVD", ",", "x2", ",", "1"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "1", " ", "tells", " ", "the", " ", "algorithm", " ", "to", " ", "make", " ",
     "the", " ", "input", " ", "and", " ", "output", " ", "lengths", " ", 
    "the", " ", "same"}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.8980529659431815`*^9, 3.8980529876324167`*^9}, 
   3.8980538962939577`*^9, {3.8980539841022005`*^9, 3.8980539852997503`*^9}, {
   3.898054329659712*^9, 3.898054345734746*^9}, {3.8980544233367443`*^9, 
   3.8980544754302998`*^9}, {3.898054774691493*^9, 3.8980548000010667`*^9}, {
