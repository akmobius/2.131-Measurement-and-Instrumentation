  "Out[674]//MatrixForm=",ExpressionUUID->"fd48f5cb-f2ac-4720-b1c5-\
6f3009ea0957"]
}, Open  ]],

Cell["\<\
Note the particular symmetry of this matrix. We will form the Toeplitz matrix \
from the input auto-correlation function values.\
\>", "Text",
 CellChangeTimes->{{3.8988882601393275`*^9, 
  3.8988883231956882`*^9}},ExpressionUUID->"28185740-1d72-4578-b031-\
f4f42975d6ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Estimate the System Impulse Response Function via Toeplitz Matrix Inversion\
\>", "Subsubsection",
 CellChangeTimes->{{3.9698997993941507`*^9, 3.9698998015536327`*^9}, {
  3.969899851450988*^9, 3.96989985708432*^9}, {3.9701387483374643`*^9, 
  3.970138757503438*^9}},ExpressionUUID->"a290a855-f1f1-44fb-8bea-\
630e2c887798"],

Cell[TextData[{
 "This deconvolution may be implemented using a matrix equation involving the \
inverse of the Toeplitz matrix formed from the input auto-correlation \
function times the cross-correlation function. \nHowever this is a brute \
force approach and when the length, m, of cxx gets large then the Toeplitz \
matrix gets huge (m x m). Only use the following direct matrix inversion if m \
\[LessEqual]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox["2", "9"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24af4623-4c7b-463c-a2fc-1b761bd8c5bc"]
}], "Text",
 CellChangeTimes->{{3.8982329374103403`*^9, 3.898232945694025*^9}, {
   3.8988878726121025`*^9, 3.8988881513949857`*^9}, {3.898888229957262*^9, 
   3.8988882382193575`*^9}, {3.89888833180163*^9, 3.898888334035705*^9}, {
   3.898888469803116*^9, 3.898888475574673*^9}, 3.9701492482978477`*^9, {
   3.970149391992114*^9, 3.9701494544689217`*^9}, 3.9702203015138187`*^9, {
   3.9702203644791*^9, 3.9702205247649107`*^9}, {3.970220563351886*^9, 
   3.97022059086544*^9}},ExpressionUUID->"6fc9b022-e840-47a9-92e2-\
1cc3b9b3f388"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Solve", " ", "for", " ", "impulse", " ", "response"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"hi", "=", 
    RowBox[{
     FractionBox["1", "\[CapitalDelta]t"], 
     RowBox[{
      RowBox[{"Inverse", "[", 
       RowBox[{"ToeplitzMatrix", "[", "cxx", "]"}], "]"}], ".", "cxy"}]}]}], 
   ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "probably", " ", "best", " ", "not", " ", "to", " ", "execute", " ", 
    "this"}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.962822088087101*^9, 3.962822088089099*^9}, {
   3.962822126201241*^9, 3.962822187241994*^9}, 3.962823270822446*^9, {
   3.962823523983478*^9, 3.962823548384651*^9}, 3.962879345893909*^9, {
   3.963075518025675*^9, 3.963075523839448*^9}, 3.963075581772396*^9, {
   3.963078315332191*^9, 3.963078321076352*^9}, {3.9701386286370993`*^9, 
   3.970138652218512*^9}, {3.97013870322187*^9, 3.9701387135213413`*^9}, {
   3.970149652609322*^9, 3.970149722197747*^9}, {3.970153445316004*^9, 
   3.970153445433511*^9}, 3.9701589688183327`*^9, {3.970160730022396*^9, 
   3.970160742324071*^9}, 3.970219680302767*^9, {3.970219752351058*^9, 
   3.970219761574129*^9}, 3.9702198522741947`*^9, 3.97021998144093*^9, {
   3.970220343107205*^9, 3.970220344842754*^9}, {3.970220634469182*^9, 
   3.9702206409157*^9}, {3.970413823822712*^9, 3.9704138402536592`*^9}},
 CellLabel->
  "In[216]:=",ExpressionUUID->"95af428f-4384-4e4a-85ec-bc004561cb19"],

Cell["\<\
A better way to perform these matrix operations is to use the Mathematica \
LinearSolve[] function:\
\>", "Text",
 CellChangeTimes->{{3.970220314013742*^9, 
  3.970220334368237*^9}},ExpressionUUID->"e96e694b-f708-4811-9ae7-\
1fdbfe1f5867"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Solve", " ", "for", " ", "impulse", " ", "response"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    ButtonBox["\<\"\[GraySquare]\"\>",
     Appearance->"Frameless",
     ButtonFunction:>(SelectionMove[
        EvaluationCell[], All, TextLine]; SelectionEvaluate[
        EvaluationNotebook[]]),
     Evaluator->Automatic,
     Method->"Preemptive"], ";", " ", 
    RowBox[{"hi", "=", 
     RowBox[{
      FractionBox["1", "\[CapitalDelta]t"], 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"ToeplitzMatrix", "[", "cxx", "]"}], ",", "cxy"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hi"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotTheme", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Scientific\>\"", ",", "\"\<Grid\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<System Impulse Response Function\>\"", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Lag (s)\>\"", ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
          RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
         "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Amplitude\>\"", ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
          RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
         "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "14"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.962822088087101*^9, 3.962822088089099*^9}, {
   3.962822126201241*^9, 3.962822187241994*^9}, 3.962823270822446*^9, {
