Cell[CellGroupData[{

Cell["Estimate the System Impulse Response Function via SVD", "Subsubsection",
 CellChangeTimes->{{3.9698997993941507`*^9, 3.9698998015536327`*^9}, {
  3.969899851450988*^9, 
  3.96989985708432*^9}},ExpressionUUID->"5551d481-0ea9-4887-8c62-\
7b6eb6e7109c"],

Cell["\<\
Singular Value Decomposition (SVD) is together with the Fast Fourier \
Transform (FFT) is one of the most important algorithms developed. We can use \
it here to do a better job of performing the Toeplitz matrix inversion. An \
additional benefit is that we can get rid of small singular values (smaller \
than a threshold) that are likely to not contribute usefully to the impulse \
response function estimate. \
\>", "Text",
 CellChangeTimes->{{3.969899881940731*^9, 
  3.969900125708295*^9}},ExpressionUUID->"18b619c0-b276-45ce-b1b3-\
341ba59ac07b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"SVD", " ", "with", " ", "threshold"}], " ", "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Truncated", " ", "SVD", " ", "solution"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    ButtonBox["\<\"\[GraySquare]\"\>",
     Appearance->"Frameless",
     ButtonFunction:>(SelectionMove[
        EvaluationCell[], All, TextLine]; SelectionEvaluate[
        EvaluationNotebook[]]),
     Evaluator->Automatic,
     Method->"Preemptive"], ";", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U", ",", "S", ",", "V"}], "}"}], "=", 
     RowBox[{"SingularValueDecomposition", "[", 
      RowBox[{"ToeplitzMatrix", "[", "cxx", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"threshold", "=", 
     RowBox[{"0.01", " ", 
      RowBox[{"Max", "[", "S", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Keep", " ", "only", " ", "significant", " ", "singular", " ", "values"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"Sinv", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Max", "[", 
          RowBox[{"#", ",", "threshold"}], "]"}]}], "&"}], "/@", 
       RowBox[{"Diagonal", "[", "S", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hSVD", "=", 
     RowBox[{
      FractionBox["1", "\[CapitalDelta]t"], " ", 
      RowBox[{"V", ".", "Sinv", ".", 
       RowBox[{"Transpose", "[", "U", "]"}], ".", "cxy"}]}]}], ";"}], "\n", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "hSVD"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotTheme", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Scientific\>\"", ",", "\"\<Grid\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<System Impulse Response Function via SVD\>\"", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Lag (s)\>\"", ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
          RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
         "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Amplitude\>\"", ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
          RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
         "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "14"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9628237001948547`*^9, 3.96282371427008*^9}, {
   3.962823928147499*^9, 3.9628239570206127`*^9}, {3.9628248176441193`*^9, 
