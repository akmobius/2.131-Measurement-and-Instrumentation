Cell["\<\
Ideally the residual auto-correlation function should be that of a white \
noise signal (i.e., a spike at zero lag and zero elsewhere). It is not. This \
indicates that there is probably a very small additional higher order dynamic \
component and/or a very small dynamic nonlinearity we have not modeled. It is \
so small that we are not going to worry about it.
We can also look at the power spectrum of the residuals:\
\>", "Text",
 CellChangeTimes->{{3.970766796256435*^9, 
  3.970766992688899*^9}},ExpressionUUID->"2fa4563c-077f-4879-a82f-\
2313256e9594"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rps", "=", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<WelchSpectralEstimate\>\"", "]"}], "[", 
    RowBox[{"res", ",", 
     FractionBox["1", "\[CapitalDelta]t"], ",", 
     RowBox[{"\"\<SegmentSize\>\"", "->", " ", "nseg"}], ",", 
     RowBox[{"\"\<Window\>\"", "->", "HannWindow"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.96998230694645*^9, 3.969982392408883*^9}, {
   3.9699824711151257`*^9, 3.969982498130204*^9}, {3.969982533441465*^9, 
   3.969982533935156*^9}, {3.96998984336934*^9, 3.969989890735199*^9}, {
   3.9699902482367496`*^9, 3.96999024841966*^9}, {3.970138955954348*^9, 
   3.970138983351972*^9}, {3.970153289162614*^9, 3.970153289279399*^9}, {
   3.970413725368919*^9, 3.970413726853023*^9}, {3.970767071217844*^9, 
   3.970767143695364*^9}, {3.970767250801578*^9, 3.970767252270864*^9}, {
   3.970767374344668*^9, 3.970767376143413*^9}, 3.985859641566725*^9},
 CellLabel->
  "In[273]:=",ExpressionUUID->"facd4180-32bc-41d0-a322-ab1052f78c72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"ListLogLogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xps", ",", "yps", ",", " ", "rps"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"All", ",", "All"}], "}"}]}], ",", 
    RowBox[{"Joined", "->", "True"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", "Red", ",", "Black"}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", 
     "->", "\"\<Input (Blue), Output (Red) and Parametric Model Residual \
(Black) Power Spectra\>\""}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Power\>\""}], "}"}]}], ",", 
