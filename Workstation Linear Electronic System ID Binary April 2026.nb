        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.8982470423715467`*^9, 3.898341506938093*^9, 
  3.8983419983972964`*^9, 3.8988661494505167`*^9, 3.8988878632466803`*^9, 
  3.8990419111286707`*^9, 3.89904200252999*^9, 3.89904220945315*^9, 
  3.899043403527941*^9, 3.900525075824145*^9, 3.969991123167036*^9, 
  3.969992169043865*^9, 3.970138378770011*^9, 3.970153438332567*^9, 
  3.970159274142416*^9, 3.970219631854494*^9, 3.970221250574052*^9, 
  3.970228746925951*^9, 3.9704137763636*^9, 3.970650618910603*^9, 
  3.970761906815343*^9, 3.971114622919538*^9, 3.973781501734169*^9, 
  3.984417820292301*^9, 3.98441845978228*^9, 3.984470788762005*^9},
