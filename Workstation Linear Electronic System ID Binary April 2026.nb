a334c8b2cf43"],

Cell["\<\
We use a special function created by Dr. Serge Lafontaine to control the \
Digilent Discovery 3. \
\>", "Text",
 CellChangeTimes->{{3.973451125131495*^9, 3.9734512417010393`*^9}, {
   3.973451302830216*^9, 3.9734513114873543`*^9}, 3.973451426669044*^9, {
   3.973452758616778*^9, 3.9734527597234583`*^9}, 
   3.973514296560472*^9},ExpressionUUID->"e3fd4e20-b406-4023-ad6b-\
700334293d3a"],

Cell["\<\
DWFPlayRecord[waveformCh1, sampleRate,  rangeCh1, rangeCh2] 
The range of the waveformCh1 is fixed at \[PlusMinus]5 V
The rangeCh1 and rangeCh2 of the ADCs is either \[PlusMinus]2.56 V (denoted \
5) or \[PlusMinus]25.6 V (denoted 25)\
\>", "Text",
 CellChangeTimes->{{3.973779542631192*^9, 3.973779618997373*^9}, {
  3.973779797039835*^9, 3.973779877238887*^9}, {3.984488658653079*^9, 
  3.984488679350515*^9}, {3.9858582896120863`*^9, 
  3.9858582931169863`*^9}},ExpressionUUID->"f17745e2-3606-47ff-8e1d-\
989acd63c01a"],

