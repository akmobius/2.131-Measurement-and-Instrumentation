 RowBox[{
  RowBox[{"(*", 
   RowBox[{"High", "-", 
    RowBox[{"level", " ", "streaming", " ", "acquisition"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    ButtonBox["\<\"\[GraySquare]\"\>",
     Appearance->"Frameless",
     ButtonFunction:>(SelectionMove[
        EvaluationCell[], All, TextLine]; SelectionEvaluate[
        EvaluationNotebook[]]),
     Evaluator->Automatic,
     Method->"Preemptive"], ";"}], "  ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"DWFPlayRecord", "[", 
      RowBox[{
       RowBox[{"0.65", "u"}], ",", "sampleRate", ",", "5", ",", "5"}], 
      "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"5", " ", "indicates"}], " ", "+", 
     RowBox[{
