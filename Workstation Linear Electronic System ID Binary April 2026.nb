      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"nTrim", "=", 
   FractionBox["0.003", "\[CapitalDelta]t"]}]}]], "Input",
 CellChangeTimes->{{3.9701518645725594`*^9, 3.9701518932778463`*^9}, {
