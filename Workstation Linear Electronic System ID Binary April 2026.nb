Cell["\<\
We can see here that both the input probability density appears binary but \
the output probability density appears more Gaussian. This is typically found \
when a system acts to low pass filter the input.\
\>", "Text",
 CellChangeTimes->{{3.969989296770355*^9, 3.969989520533958*^9}, {
   3.969990160278268*^9, 3.969990182267684*^9}, {3.973455163345635*^9, 
   3.973455362692129*^9}, 3.973455464124248*^9, {3.9844176462644*^9, 
   3.984417681961371*^9}, {3.984418266094179*^9, 3.984418317014059*^9}, {
   3.985858751710602*^9, 
   3.985858835190854*^9}},ExpressionUUID->"8df46ea5-5c34-4a87-b13c-\
724492641e86"],

Cell["\<\
We can compare the output probability density to a Gaussian probability \
density function having the same mean and standard deviation:\
\>", "Text",
 CellChangeTimes->{{3.970147917577688*^9, 3.9701479773676157`*^9}, {
  3.9844176299122143`*^9, 3.984417630129444*^9}, {3.984418325533321*^9, 
  3.9844183272771683`*^9}},ExpressionUUID->"cf2d9215-9bc8-4d2e-bf95-\
7290d3f2612e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
