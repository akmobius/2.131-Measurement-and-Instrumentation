Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", " ", 
  RowBox[{"AbsoluteTiming", "[", " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Nonparametric", " ", "Training"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", "2000"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Tau]i", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.0", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", "-", "1"}], ")"}], " ", "\[CapitalDelta]t"}], ",", 
       "\[CapitalDelta]t"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cxx", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ListCorrelate", "[", 
        RowBox[{"x1", ",", "x1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"n", ";;", 
         RowBox[{"n", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "n"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"cxy", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ListCorrelate", "[", 
        RowBox[{"x1", ",", "y1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"n", ";;", 
         RowBox[{"n", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "n"}]}], ";",
     " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U", ",", "S", ",", "V"}], "}"}], "=", 
     RowBox[{"SingularValueDecomposition", "[", 
      RowBox[{"ToeplitzMatrix", "[", "cxx", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"threshold", "=", 
     RowBox[{"0.1", " ", 
      RowBox[{"Max", "[", "S", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Sinv", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Max", "[", 
          RowBox[{"#", ",", "threshold"}], "]"}]}], "&"}], "/@", 
       RowBox[{"Diagonal", "[", "S", "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"h1SVD", "=", 
     RowBox[{
      FractionBox["1", "\[CapitalDelta]t"], " ", 
      RowBox[{"V", ".", "Sinv", ".", 
       RowBox[{"Transpose", "[", "U", "]"}], ".", "cxy"}]}]}], ";"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
