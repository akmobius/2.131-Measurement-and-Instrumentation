Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"vafP", "=", 
   RowBox[{"100", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"Variance", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yp", "-", "y2"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"nTrim", ";;", "All"}], "]"}], "]"}], "]"}], 
       RowBox[{"Variance", "[", 
        RowBox[{"y2", "[", 
         RowBox[{"[", 
          RowBox[{"nTrim", ";;", "All"}], "]"}], "]"}], "]"}]]}], 
     ")"}]}]}]}]], "Input",
