      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SmoothHistogram", "[", 
     RowBox[{"y1", ",", "Automatic", ",", "\"\<PDF\>\"", ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotTheme", "->", 
       RowBox[{"{", 
