          RowBox[{"n1", ";;", "n2"}], "]"}], "]"}], ",", 
        RowBox[{"y2", "[", 
         RowBox[{"[", 
          RowBox[{"n1", ";;", "n2"}], "]"}], "]"}]}], "}"}], "\[Transpose]"}],
      ",", 
