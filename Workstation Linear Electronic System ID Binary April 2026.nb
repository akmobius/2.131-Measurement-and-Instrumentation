Cell["\<\
As before the prediction is so good it is difficult to distinguish the \
predicted output from the measured output.\
\>", "Text",
 CellChangeTimes->{{3.970151011702894*^9, 3.97015104642819*^9}, {
  3.970163635771697*^9, 
  3.97016364009171*^9}},ExpressionUUID->"f5ca25fa-08d0-4acc-baf7-\
3e47dc844ddb"],

Cell["\<\
We can now determine the %VAF for this second-order model prediction:\
\>", "Text",
 CellChangeTimes->{{3.970163668338179*^9, 
  3.97016369292346*^9}},ExpressionUUID->"0d01f42c-ec0f-45d6-be3c-\
01dad9f23fdc"],

