Cell["\<\
We can see that over this range the fit of the second-order transfer function \
to the frequency response estimates is almost perfect.\
\>", "Text",
 CellChangeTimes->{{3.9701572932531443`*^9, 
  3.970157353825486*^9}},ExpressionUUID->"1d34ce9a-a1a8-4c4a-be91-\
2d76ca17ad06"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Fit a Parametric Second-Order Impulse Response Function Model\
\>", "Subsubsection",
 CellChangeTimes->{{3.795798077887012*^9, 3.7957981026325855`*^9}, {
  3.7958098779886637`*^9, 3.795809916547951*^9}, {3.970157402140184*^9, 
  3.9701574076185503`*^9}, {3.970160868475622*^9, 
  3.970160869357369*^9}},ExpressionUUID->"b69076b3-9c56-49a8-8631-\
643647eb7aa1"],

Cell["\<\
The general equation for the transfer function of a second-order low-pass \
filter is:\
\>", "Text",
 CellChangeTimes->{{3.795798108024832*^9, 
  3.7957981519245596`*^9}},ExpressionUUID->"b57f4d07-b802-4dd8-8674-\
cd60506a2023"],

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"s_", ",", "\[Alpha]_", ",", "\[Omega]_", ",", "\[Zeta]_"}], 
    "]"}], ":=", 
   FractionBox[
    RowBox[{"\[Alpha]", " ", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{
     SuperscriptBox["s", "2"], "+", 
     RowBox[{"2", "\[Zeta]", " ", "\[Omega]", " ", "s"}], "+", 
     SuperscriptBox["\[Omega]", "2"]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.795798156957447*^9, 3.7957982612023764`*^9}, 
   3.795811951276453*^9},
 CellLabel->
  "In[234]:=",ExpressionUUID->"bcc20893-3f03-4625-aaea-439ebed34522"],

Cell["\<\
where the static gain is \[Alpha], the natural frequency (in radians/s) is \
\[Omega], and the damping parameter is \[Zeta].\
\>", "Text",
 CellChangeTimes->{{3.795807739015408*^9, 
  3.795807789760621*^9}},ExpressionUUID->"0ecd4538-dd72-4fd8-b13c-\
12429cfeb3b1"],

Cell["\<\
The system parametric impulse response function is simply the inverse Laplace \
transform of this parametric transfer function:\
\>", "Text",
 CellChangeTimes->{{3.9701581883841867`*^9, 
  3.970158235920005*^9}},ExpressionUUID->"c4f729b9-4705-459a-9941-\
2b97b7c2e926"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["\[Omega]", "2"]}], 
     RowBox[{
      SuperscriptBox["s", "2"], "+", 
      RowBox[{"2", "\[Zeta]", " ", "\[Omega]", " ", "s"}], "+", 
      SuperscriptBox["\[Omega]", "2"]}]], ",", "s", ",", "\[Tau]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.898384881119438*^9, 3.8983849045734296`*^9}, 
   3.898385622584784*^9, 3.898385684520317*^9, {3.9701586003704853`*^9, 
   3.970158620897851*^9}, {3.970159166336301*^9, 3.970159174423567*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"3d0b37e7-fcc9-477a-8da1-399668cb6905"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[Tau]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Zeta]"}], " ", "\[Omega]"}], "-", 
          SqrtBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              SuperscriptBox["\[Zeta]", "2"]}], ")"}], " ", 
            SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]], "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[Tau]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Zeta]"}], " ", "\[Omega]"}], "+", 
          SqrtBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              SuperscriptBox["\[Zeta]", "2"]}], ")"}], " ", 
            SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]]}], ")"}], " ", 
    "\[Alpha]", " ", 
    SuperscriptBox["\[Omega]", "2"]}], 
   RowBox[{"2", " ", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Zeta]", "2"]}], ")"}], " ", 
      SuperscriptBox["\[Omega]", "2"]}]]}]]}]], "Output",
 CellChangeTimes->{
  3.97015859010041*^9, 3.970158623286553*^9, {3.9701591672986*^9, 
   3.970159179318968*^9}, 3.970159436787992*^9, 3.970159797810897*^9, 
   3.9702217771338453`*^9, 3.9702475689079037`*^9, 3.97041497515265*^9, 
   3.970650790773281*^9, 3.9707619992533817`*^9, 3.9711149935596027`*^9, 
   3.973456288683165*^9, 3.973780498505596*^9, 3.9737816686899157`*^9, 
   3.984470907069899*^9, 3.9844709888908052`*^9, 3.9844921361137543`*^9, 
   3.984503952035117*^9, 3.984505738658959*^9, 3.985859416534863*^9},
 CellLabel->
  "Out[235]=",ExpressionUUID->"9e8901ec-f6e1-4338-998a-3fe9fadb35cb"]
}, Open  ]],

Cell["\<\
In defining the general impulse response function of this second-order system \
we need to treat the case when \[Zeta]=1 as a special case in order to avoid \
a divide by 0 error.\
\>", "Text",
 CellChangeTimes->{{3.898385498633396*^9, 
  3.898385582109731*^9}},ExpressionUUID->"3f59d36c-2d2c-423d-b1d6-\
8e092653eda8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["\[Omega]", "2"]}], 
     RowBox[{
      SuperscriptBox["s", "2"], "+", 
      RowBox[{"2", "\[Omega]", " ", "s"}], "+", 
      SuperscriptBox["\[Omega]", "2"]}]], ",", "s", ",", "\[Tau]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.898384881119438*^9, 3.8983849045734296`*^9}, 
   3.898385622584784*^9, 3.8983856678376517`*^9, 3.970158673361216*^9, 
   3.970159452985992*^9, 3.9701597868967113`*^9},
 CellLabel->
  "In[236]:=",ExpressionUUID->"4b86c682-d1a6-4785-9ff1-752ae5bc8255"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "\[Tau]"}], " ", "\[Omega]"}]], " ", "\[Alpha]", " ", 
  "\[Tau]", " ", 
  SuperscriptBox["\[Omega]", "2"]}]], "Output",
 CellChangeTimes->{{3.9701586685206738`*^9, 3.970158675422868*^9}, 
   3.970159454123082*^9, 3.970159788432742*^9, 3.9702217809534616`*^9, 
   3.97024757178891*^9, 3.9704149765511217`*^9, 3.9706507937209263`*^9, 
   3.970762001616103*^9, 3.97111499773066*^9, 3.973456290612108*^9, 
   3.973780499882547*^9, 3.973781670466028*^9, 3.9844709087202*^9, 
   3.984470991158136*^9, 3.9844921380139008`*^9, 3.984503955474635*^9, 
   3.984505740526627*^9, 3.985859425652308*^9},
 CellLabel->
  "Out[236]=",ExpressionUUID->"a015ff99-ee31-4211-94d5-c3f4089fd495"]
}, Open  ]],

Cell["\<\
We can now define a function which returns the impulse response function for \
different values of \[Alpha], \[Zeta], and \[Omega] :\
\>", "Text",
 CellChangeTimes->{{3.8983859342862*^9, 
  3.8983859984487205`*^9}},ExpressionUUID->"f3201139-f3df-4188-9a9a-\
608813008076"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"\[Tau]_", ",", "\[Alpha]_", ",", "\[Zeta]_", ",", "\[Omega]_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"\[Zeta]", "==", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"InverseLaplaceTransform", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Alpha]", " ", 
        SuperscriptBox["\[Omega]", "2"]}], 
       RowBox[{
        SuperscriptBox["s", "2"], "+", 
        RowBox[{"2", "\[Omega]", " ", "s"}], "+", 
        SuperscriptBox["\[Omega]", "2"]}]], ",", "s", ",", "\[Tau]"}], "]"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"InverseLaplaceTransform", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Alpha]", " ", 
        SuperscriptBox["\[Omega]", "2"]}], 
       RowBox[{
        SuperscriptBox["s", "2"], "+", 
        RowBox[{"2", "\[Zeta]", " ", "\[Omega]", " ", "s"}], "+", 
        SuperscriptBox["\[Omega]", "2"]}]], ",", "s", ",", "\[Tau]"}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.898385711904737*^9, 3.8983857517122416`*^9}, 
   3.9701594610942917`*^9, 
   3.984504005618271*^9},ExpressionUUID->"80f5efd9-c1c6-4130-815c-\
fea104ba01e2"],

Cell["\<\
However you will find that repeated evaluations of this function is too slow \
because the inverse Laplace transforms have to be redone every time it is \
evaluated. Better to do the following:\
\>", "Text",
 CellChangeTimes->{{3.8983858059714365`*^9, 3.898385834003893*^9}, {
  3.8983860061903057`*^9, 
  3.898386094421321*^9}},ExpressionUUID->"3b1baaf4-f135-46bb-9906-\
f2f46fafc3fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"\[Tau]_", ",", "\[Alpha]_", ",", "\[Zeta]_", ",", "\[Omega]_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"\[Zeta]", "==", "1.0"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Re", "[", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[Tau]"}], " ", "\[Omega]"}]], " ", "\[Alpha]", " ", 
      "\[Tau]", " ", 
      SuperscriptBox["\[Omega]", "2"]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Re", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[Tau]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Zeta]"}], " ", "\[Omega]"}], "-", 
              SqrtBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", 
                  SuperscriptBox["\[Zeta]", "2"]}], ")"}], " ", 
                SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]], "-", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[Tau]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Zeta]"}], " ", "\[Omega]"}], "+", 
              SqrtBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", 
                  SuperscriptBox["\[Zeta]", "2"]}], ")"}], " ", 
                SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]]}], ")"}], " ", 
        "\[Alpha]", " ", 
        SuperscriptBox["\[Omega]", "2"]}], 
       RowBox[{"2", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Zeta]", "2"]}], ")"}], " ", 
          SuperscriptBox["\[Omega]", "2"]}]]}]]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.898384956994135*^9, 3.898385077293048*^9}, 
   3.898385241946663*^9, {3.898385293598235*^9, 3.898385295381825*^9}, {
   3.898385369143466*^9, 3.8983853694727073`*^9}, {3.898385461213242*^9, 
   3.898385461362589*^9}, {3.898769098137047*^9, 3.898769109760305*^9}, 
   3.898865347815653*^9, 
   3.98450401346879*^9},ExpressionUUID->"cd58f62a-83e2-462a-aeb9-\
6dab763034ab"],

Cell["\<\
Note that for negative value of \[Tau] this function will give non-zero \
results. This can be \[OpenCurlyDoubleQuote]fixed\[CloseCurlyDoubleQuote] by \
multiplying by the Heaviside Theta function (which is 0 when \[Tau]<0). This \
is the even better function:\
\>", "Text",
 CellChangeTimes->{{3.8983861455749607`*^9, 3.8983862854145994`*^9}, {
  3.984504045226735*^9, 
  3.984504051193488*^9}},ExpressionUUID->"a3b9ac9b-8e72-43f7-9f74-\
4f3c317e500f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
