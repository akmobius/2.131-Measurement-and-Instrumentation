Cell["\<\
We can clearly see here that the input auto-correlation function (blue) has a \
spike at zero lag and then drops to zero fairly quickly and after a few \
oscillations remains at zero. This is to be expected when the input has a \
flat power spectrum up to some frequency. By contrast the output \
auto-correlation function (red) clearly has memory for its previous values \
and will therefor not have a flat power spectrum.
Note also that we need to make sure that the output auto-correlation function \
is computed out to a sufficiently high lag to ensure that it has \
\[OpenCurlyDoubleQuote]died\[CloseCurlyDoubleQuote] down enough. You also \
should make sure that the length, n, of the input signal is at least 10x the \
length, m,  of the auto-correlation function. In our case we have: \
\>", "Text",
 CellChangeTimes->{{3.9699896071728973`*^9, 3.969989818197077*^9}, {
  3.969990896865831*^9, 3.969990903495164*^9}, {3.970148535889192*^9, 
  3.9701487124436083`*^9}, {3.9701487432394876`*^9, 3.9701487709445257`*^9}, {
  3.9844177497531548`*^9, 3.984417753241128*^9}, {3.984491655707781*^9, 
  3.984491662295619*^9}},ExpressionUUID->"5e26c014-5d29-4248-8129-\
9f95094759f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Input and Output Power Spectra", "Subsubsection",
 CellChangeTimes->{{3.898678314875126*^9, 3.8986783194998693`*^9}, {
  3.969982226007601*^9, 3.969982233370685*^9}, {3.96998229147932*^9, 
  3.9699822966715918`*^9}, {3.9699898234462223`*^9, 
  3.969989824929914*^9}},ExpressionUUID->"95b72b9d-06b3-4923-8669-\
f8f020909c6a"],

Cell["\<\
The Fourier transform of the auto-correlation function is the power spectrum. \
We could determine the power spectrum by doing this. Alternatively we can \
estimate the power spectrum directly from the original input data using FFT \
methods. Note that we use Welches method which is available from the Wolfram \
Resource Function repository. Welches method requires that we divide the \
signal up in to overlapping segments of length nseg. The shorter the segment \
the more filtering of the spectra we get. The segment length also determines \
the spectral resolution (i.e., spacing between adjacent frequencies ( = first \
non-zero frequency). \
\>", "Text",
 CellChangeTimes->{{3.898678325932046*^9, 3.8986784196441355`*^9}, {
   3.898789459162607*^9, 3.8987895084811087`*^9}, {3.9642821335951242`*^9, 
   3.964282136878717*^9}, {3.969889255667047*^9, 3.9698894881144543`*^9}, {
   3.9699824334786787`*^9, 3.969982457913344*^9}, {3.970138948922676*^9, 
   3.9701389508284473`*^9}, 
   3.9702310264862337`*^9},ExpressionUUID->"07a5fce2-04ac-4371-99b5-\
e8701bbc9f64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"nseg", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xps", "=", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<WelchSpectralEstimate\>\"", "]"}], "[", 
    RowBox[{"x1", ",", 
     FractionBox["1", "\[CapitalDelta]t"], ",", 
     RowBox[{"\"\<SegmentSize\>\"", "->", " ", "nseg"}], ",", 
     RowBox[{"\"\<Window\>\"", "->", "HannWindow"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yps", "=", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<WelchSpectralEstimate\>\"", "]"}], "[", 
    RowBox[{"y1", ",", 
     FractionBox["1", "\[CapitalDelta]t"], ",", 
     RowBox[{"\"\<SegmentSize\>\"", "->", " ", "nseg"}], ",", 
     RowBox[{"\"\<Window\>\"", "->", "HannWindow"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xps", ",", "yps"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"All", ",", "All"}], "}"}]}], ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Input (Blue) and Output (Red) Power Spectra\>\""}],
    ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Power\>\""}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Full"}], ",", 
   RowBox[{"ImageSize", "->", "500"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Black", ",", 
      RowBox[{"Text", "[", " ", 
       RowBox[{
        RowBox[{
         FractionBox["1", 
          RowBox[{" ", 
           RowBox[{"nseg", " ", "\[CapitalDelta]t"}]}]], 
         " ", "\"\<= Frequency Resolution (Hz)\>\""}], ",", 
        RowBox[{"Scaled", "[", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", "0.93"}], "}"}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "Black", ",", 
      RowBox[{"Text", "[", "  ", 
       RowBox[{
        RowBox[{
        "nseg", " ", "\[CapitalDelta]t", " ", "1000.", 
         " ", "\"\<= Segment Length (ms)\>\""}], ",", 
        RowBox[{"Scaled", "[", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", "0.88"}], "}"}], "]"}]}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.96998230694645*^9, 3.969982392408883*^9}, {
  3.9699824711151257`*^9, 3.969982498130204*^9}, {3.969982533441465*^9, 
  3.969982533935156*^9}, {3.96998984336934*^9, 3.969989890735199*^9}, {
  3.9699902482367496`*^9, 3.96999024841966*^9}, {3.970138955954348*^9, 
  3.970138983351972*^9}, {3.970153289162614*^9, 3.970153289279399*^9}, {
  3.970413725368919*^9, 3.970413726853023*^9}, {3.9858589914279003`*^9, 
  3.985858992641532*^9}},
 CellLabel->
