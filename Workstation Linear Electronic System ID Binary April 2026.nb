   3.970650602947215*^9, 3.9707618966111927`*^9, 3.971114612663162*^9, 
   3.973455557620676*^9, 3.973455779555483*^9, 3.973780351647974*^9, 
   3.9737814858692904`*^9, 3.984417769695587*^9, 3.984418409489291*^9, 
   3.984470776657398*^9, 3.98448912526709*^9, 3.984491674386896*^9, 
   3.984503696831686*^9, 3.98450416399751*^9, 3.984505582479226*^9, 
   3.984675257557406*^9, 3.984678593440295*^9, 3.985859005362554*^9},
 CellLabel->
  "Out[144]=",ExpressionUUID->"512d064a-405a-4f76-bed6-5020a846b087"]
}, Open  ]],

Cell["\<\
Here we can see that the input power spectrum (blue)  is  flat up to around 4 \
kHz  whereas the output is clearly attenuated above about 1 kHz. This is \
indicates that we have a low-pass system because the Black Box is passing low \
frequencies but attenuating high frequencies. Furthermore there seems to be a \
peak around 1 kHz which suggests that our low-pass Black Box system my be \
under-damped.\
\>", "Text",
 CellChangeTimes->{{3.969990261902029*^9, 3.969990494724049*^9}, {
  3.969990948764586*^9, 3.9699909491674023`*^9}, {3.970137884899086*^9, 
  3.9701380347842197`*^9}, {3.9701390229497137`*^9, 3.9701390427795258`*^9}, {
  3.970139098506274*^9, 3.970139237093363*^9}, {3.970148929994257*^9, 
  3.970148944950653*^9}, {3.9844178039786*^9, 3.984417805281252*^9}, {
  3.984418415173861*^9, 3.98441843646236*^9}, {3.9844916952275963`*^9, 
  3.984491698001604*^9}, {3.9858590272178793`*^9, 3.9858590367136593`*^9}, {
  3.9858590736174498`*^9, 
  3.985859075121615*^9}},ExpressionUUID->"819904c8-a16e-4c28-860d-\
ee55e4dbbd48"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linear System ID", "Subsubsection",
 CellChangeTimes->{{3.969982759917317*^9, 
  3.969982763152749*^9}},ExpressionUUID->"e5e42d1d-e9ce-4cd6-ae20-\
335ac27375f0"],

Cell["\<\
Now that we have analyzed some major properties of the input and output we \
can proceed to determine a dynamic model of the Black Box itself.  We will \
carry out linear system identification (ID). In subsequent notes we will \
consider how to perform system ID on potentially nonlinear dynamic systems.\
\>", "Text",
 CellChangeTimes->{{3.9699825573539248`*^9, 3.969982739230034*^9}, {
  3.9701489797690983`*^9, 
  3.970149064144455*^9}},ExpressionUUID->"bf3d73ef-e61a-4e09-aa45-\
12838f422b6f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Input Output Cross-Correlation Function", "Subsubsection",
 CellChangeTimes->{{3.969991199180087*^9, 
  3.969991215485962*^9}},ExpressionUUID->"49ddca5a-8de4-42b3-9876-\
7b855c16ce81"],

Cell["\<\
So far we have computed the input and output auto-correlation functions which \
measure the degree to which a signal is correlated with itself. However we \
can apply the same concept between two signals to see the degree to which one \
signal (e.g., the output) may be correlated with another (e.g., the input). \
Such a correlation between two signals is called a cross-correlation function:\
\>", "Text",
 CellChangeTimes->{{3.969991222400703*^9, 3.969991366858433*^9}, {
  3.970138845193849*^9, 
  3.970138849111244*^9}},ExpressionUUID->"ded3407b-a5bf-496b-b702-\
af099795e399"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]i", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0.0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "-", "1"}], ")"}], " ", "\[CapitalDelta]t"}], ",", 
     "\[CapitalDelta]t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cxx", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ListCorrelate", "[", 
       RowBox[{"x1", ",", "x1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"n", ";;", 
        RowBox[{"n", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "n"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"input", " ", "auto"}], "-", 
    RowBox[{"correlation", " ", "function"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cyy", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ListCorrelate", "[", 
       RowBox[{"y1", ",", "y1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"n", ";;", 
        RowBox[{"n", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "n"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"output", " ", "auto"}], "-", 
    RowBox[{"correlation", " ", "function"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cxy", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ListCorrelate", "[", 
       RowBox[{"x1", ",", "y1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"n", ";;", 
        RowBox[{"n", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "n"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"input", " ", "output", " ", "cross"}], "-", 
    RowBox[{"correlation", " ", "fn"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cyx", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ListCorrelate", "[", 
       RowBox[{"y1", ",", "x1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"n", ";;", 
        RowBox[{"n", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "n"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"output", " ", "input", " ", "cross"}], "-", 
    RowBox[{"correlation", " ", "fn"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]i", ",", "cxy"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Tau]i"}], ",", "cyx"}], "}"}], "\[Transpose]"}]}], 
    "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotTheme", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Scientific\>\"", ",", "\"\<Grid\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Input Output Cross-Correlation Functions\>\"", ",", 
      RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
      RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], "]"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Lag (s)\>\"", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], "]"}], 
      ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Correlation\>\"", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
       "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"LabelStyle", "->", 
