Cell["\<\
Here we can see that the residuals are Gaussian. This is very common and \
indeed justifies the use of the least squares fitting we used (because least \
squares assumes that the errors are Gaussian).\
\>", "Text",
 CellChangeTimes->{{3.970766325486648*^9, 
  3.97076639633213*^9}},ExpressionUUID->"487ec4e2-699c-41e6-b14b-\
c76ae86ec917"],

Cell["\<\
We can also look at the auto-correlation function of the residuals:\
\>", "Text",
 CellChangeTimes->{{3.970766407808898*^9, 
  3.970766423183072*^9}},ExpressionUUID->"4e13c7ee-b0fe-472b-8d92-\
5c35f043d4fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{"nn", "=", 
   RowBox[{"Length", "[", "res", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]i", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0.0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "-", "1"}], ")"}], " ", "\[CapitalDelta]t"}], ",", 
     "\[CapitalDelta]t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crr", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ListCorrelate", "[", 
      RowBox[{"res", ",", "res", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"nn", ";;", 
       RowBox[{"nn", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "nn"}]}], 
  ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Tau]i", ",", "crr"}], "}"}], "\[Transpose]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotTheme", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Scientific\>\"", ",", "\"\<Grid\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Non-Parametric Model Residual Auto-Correlation Function\>\"",
       ",", 
      RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
      RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], "]"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Lag (s)\>\"", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], "]"}], 
      ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Relative Correlation\>\"", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "16"}], ",", "Bold", ",", "Black"}], 
       "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", 
      RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
      RowBox[{"FontSize", "->", "14"}]}], "]"}]}], ",", 
   RowBox[{"ImageSize", "->", "500"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
