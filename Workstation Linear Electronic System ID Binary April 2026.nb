Cell[CellGroupData[{

Cell["Analysis of Parametric Model Residuals", "Subsubsection",
 CellChangeTimes->{{3.970765830727051*^9, 3.9707658365798073`*^9}, {
  3.970767544972872*^9, 
  3.970767549457241*^9}},ExpressionUUID->"fcc94744-fc04-4be1-b0b8-\
0265523bafb8"],

Cell["\<\
It is useful to look at the properties of the parametric model residuals. The \
residuals  are a combination of un-modeled linear and non-linear dynamics, \
measurement noise,  etc.\
\>", "Text",
 CellChangeTimes->{{3.970765844410296*^9, 3.9707659882032623`*^9}, {
  3.970767650228163*^9, 
  3.970767676055283*^9}},ExpressionUUID->"a193fdc4-ce65-4564-96ba-\
d22a439bad5c"],

