738957502453"],

Cell["Note the values of the three parameters.", "Text",
 CellChangeTimes->{{3.7958100729745646`*^9, 
  3.795810094527908*^9}},ExpressionUUID->"ccac7bd1-c698-4b92-8cf9-\
0c4ceb055aa3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Fit a Parametric Second-Order Transfer Function Model by Nonlinear \
Minimization\
\>", "Subsubsection",
 CellChangeTimes->{{3.795798077887012*^9, 3.7957981026325855`*^9}, {
  3.7958098779886637`*^9, 
  3.795809916547951*^9}},ExpressionUUID->"273d6654-1c08-4441-8589-\
a12c651d2107"],

Cell["\<\
Lets now use a nonlinear minimization technique to fit the model to the data \
(actually we fit to just the gain data: it would be better to fit to both the \
gain and phase data simultaneously):\
\>", "Text",
 CellChangeTimes->{{3.795809925376123*^9, 3.795809952027133*^9}, {
  3.795885844246889*^9, 
  3.795885899819216*^9}},ExpressionUUID->"990c4eb3-41f0-4839-bdc0-\
c9be0596260c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"\[Alpha]\[Alpha]", "=", "2"}], ";", " ", 
  RowBox[{"\[Omega]\[Omega]", "=", 
   RowBox[{"1000", " ", "2", " ", "\[Pi]"}]}], ";", " ", 
  RowBox[{"\[Zeta]\[Zeta]", "=", "0.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nlm", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"freq", ",", "frGain"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"H", "[", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "f"}], ",", "\[Alpha]", ",", "\[Omega]",
         ",", "\[Zeta]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Alpha]\[Alpha]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "\[Omega]\[Omega]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Zeta]", ",", "\[Zeta]\[Zeta]"}], "}"}]}], "}"}], ",", "f", 
     ",", " ", 
     RowBox[{"Method", "\[Rule]", "\"\<LevenbergMarquardt\>\""}], ",", 
     RowBox[{"AccuracyGoal", "\[Rule]", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[Alpha]\[Alpha]", ",", "\[Omega]\[Omega]", ",", "\[Zeta]\[Zeta]"}], 
    "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Omega]", ",", "\[Zeta]"}], "}"}], "/.", 
    RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.795810430123591*^9, 3.7958104524259996`*^9}, {
   3.795810743239029*^9, 3.795810743582689*^9}, 3.795811963142762*^9, {
