Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", "   ", 
  RowBox[{"nn", "=", 
   RowBox[{"Length", "[", "res", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]i", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0.0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "-", "1"}], ")"}], " ", "\[CapitalDelta]t"}], ",", 
     "\[CapitalDelta]t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crr", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ListCorrelate", "[", 
      RowBox[{"res", ",", "res", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "0"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"nn", ";;", 
       RowBox[{"nn", "+", "m", "-", "1"}]}], "]"}], "]"}], "/", "nn"}]}], 
  ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Tau]i", ",", "crr"}], "}"}], "\[Transpose]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotTheme", "->", 
    RowBox[{"{", 
