Cell["\<\
Unlike the auto-correlation function which is always symmetric the \
cross-correlation between x and y (blue) is different than between y and x \
(red). This is clearly seen above where the cross-correlation between y and x \
(red) is near zero. This will be the case for causal systems. However for \
system that can anticipate (like a living system) the cyx values may be \
non-zero.\
\>", "Text",
 CellChangeTimes->{{3.969991717785987*^9, 3.969991879281683*^9}, {
  3.970149173495772*^9, 
  3.9701491908517523`*^9}},ExpressionUUID->"f5cf0556-6f55-4d5c-830a-\
0560c1b4de07"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Input-Output Cross-Power Spectrum", "Subsubsection",
 CellChangeTimes->{{3.898678314875126*^9, 3.8986783194998693`*^9}, {
  3.8987065398835325`*^9, 3.8987065410187674`*^9}, {3.8987087349788437`*^9, 
  3.898708741907329*^9}},ExpressionUUID->"a8449e76-d567-41ec-a4ba-\
a004811fb31f"],

Cell["\<\
The Fourier transform of the cross-correlation function is the cross-power \
spectrum. We could determine the cross-power spectrum by doing this. \
Alternatively we can estimate the cross-power spectrum directly from the \
original input-output data using FFT methods:\
\>", "Text",
 CellChangeTimes->{{3.898678325932046*^9, 3.8986784196441355`*^9}, {
   3.898708747890951*^9, 3.8987087654029665`*^9}, {3.898708824891384*^9, 
   3.8987088337721367`*^9}, 
   3.970231029329792*^9},ExpressionUUID->"333008dc-145a-4efe-8b44-\
235e41cf2956"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   ButtonBox["\<\"\[GraySquare]\"\>",
    Appearance->"Frameless",
    ButtonFunction:>(SelectionMove[
       EvaluationCell[], All, TextLine]; SelectionEvaluate[
       EvaluationNotebook[]]),
    Evaluator->Automatic,
    Method->"Preemptive"], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xyps", "=", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<WelchSpectralEstimate\>\"", "]"}], "[", 
    RowBox[{"x1", ",", "y1", ",", 
     RowBox[{"1", "/", "\[CapitalDelta]t"}], ",", 
     RowBox[{"\"\<SegmentSize\>\"", "->", "nseg"}], ",", 
     RowBox[{"\"\<Window\>\"", "->", "HannWindow"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.8986792165375996`*^9, 3.8986792985588694`*^9}, {
   3.8986793806519904`*^9, 3.898679380810964*^9}, {3.8986806923011675`*^9, 
   3.8986807195751815`*^9}, {3.8986807772853603`*^9, 3.89868090359778*^9}, {
   3.8987062826405864`*^9, 3.8987062849873486`*^9}, {3.898706321698189*^9, 
   3.8987063226216197`*^9}, 3.8987063638465595`*^9, {3.898708048872592*^9, 
   3.8987080564341803`*^9}, {3.8987080868346634`*^9, 
   3.8987081127969794`*^9}, {3.8987087743497796`*^9, 
   3.8987087846692543`*^9}, {3.8987089385502033`*^9, 
   3.8987089391224227`*^9}, {3.8987902303218126`*^9, 
   3.8987902314722724`*^9}, {3.9699910714668922`*^9, 3.969991105353792*^9}, {
   3.9701389099714117`*^9, 3.9701389240687523`*^9}, {3.970139250703024*^9, 
   3.9701392526222763`*^9}, {3.970413769727048*^9, 3.970413770844842*^9}, 
   3.9858590926498413`*^9},
 CellLabel->
  "In[152]:=",ExpressionUUID->"8cbacb5b-0eb0-4537-9482-2f445adfd11b"],

Cell["\<\
The cross-power spectrum values are complex. We will not plot it but will use \
it later to estimate the system frequency response function.\
\>", "Text",
 CellChangeTimes->{{3.898708843465317*^9, 
  3.898708917203742*^9}},ExpressionUUID->"e3dd7121-2fba-423f-959a-\
4ddc79e2b574"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Estimate the System Impulse Response Function", "Subsubsection",
 CellChangeTimes->{{3.8982329012134047`*^9, 3.8982329270690036`*^9}, {
  3.9698998216256647`*^9, 3.969899836997816*^9}, {3.970149277642626*^9, 
  3.970149278273447*^9}},ExpressionUUID->"ead66433-f375-47e4-b5a7-\
2e1b3cbbbcc3"],

Cell["\<\
We can estimate the system non-parametric impulse response function by \
de-convolving the input auto-correlation function from the input-output \
cross-correlation function. One way to do this is to use a special matrix \
called the Toeplitz matrix.\
\>", "Text",
 CellChangeTimes->{{3.9701492618380013`*^9, 
  3.9701493314982357`*^9}},ExpressionUUID->"9b896125-fbdc-466d-b2bd-\
b87da9bc7514"],

Cell["A Toeplitz matrix has a special structure:", "Text",
 CellChangeTimes->{{3.898888170875207*^9, 
  3.8988882206302505`*^9}},ExpressionUUID->"5b647b7b-36fe-417a-8b95-\
b87e429f9f48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  ButtonBox["\<\"\[GraySquare]\"\>",
   Appearance->"Frameless",
   ButtonFunction:>(SelectionMove[
      EvaluationCell[], All, TextLine]; SelectionEvaluate[
      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", 
  RowBox[{
   RowBox[{"ToeplitzMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], "]"}], "//",
    "MatrixForm"}]}]], "Input",
 CellChangeTimes->{{3.898232949787192*^9, 3.898232951084963*^9}, {
   3.898241894930213*^9, 3.898241899243504*^9}, {3.8982419470012894`*^9, 
   3.8982419613933773`*^9}, {3.898242057234581*^9, 3.8982420598279867`*^9}, {
