   Evaluator->Automatic,
   Method->"Preemptive"], ";", "  ", 
  RowBox[{
  "filePath", 
   "=", "\"\<\\\"C:\\\\Users\\\\ariel\\\\Downloads\\\\binary_input_5kHz_\
butter2_T1s.h5\\\"\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"filePath", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<HDF5\>\"", ",", "\"\<Datasets\>\"", 
       ",", "\"\</signal/u\>\""}], "}"}]}], "]"}]}], ";"}]}], "Input",
