      EvaluationNotebook[]]),
   Evaluator->Automatic,
   Method->"Preemptive"], ";", " ", 
  RowBox[{"\[Omega]Vals", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"950", ",", "1050", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]SS", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"errorSS", "[", 
